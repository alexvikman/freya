// Freya skin API, version 1.
//
// Skins import this file, and must re-export its globals so the app can reach them:
//
//     import { Player, Shortcuts } from "@freya/v1.slint";
//     export { Player } from "@freya/v1.slint";
//
// The app writes state into the globals below and reacts to their callbacks. A skin only
// presents that state; it has no access to files or the network. Properties marked `in` are
// set by the app; to change them, a skin calls the matching callback and the app updates the
// property in response.

import { AboutSlint } from "std-widgets.slint";

export enum PlaybackState { stopped, playing, paused }

/// One row of the playlist.
export struct TrackRow {
    /// 1-based position in the playlist.
    number: int,
    /// "Artist - Title" when tagged, otherwise the file name.
    title: string,
    /// "3:45", or empty when unknown.
    duration: string,
    selected: bool,
    /// The track that is playing, paused, or would play next on Play.
    current: bool,
}

export global Player {
    /// Title of the current track; empty when nothing is loaded.
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    /// For example "FLAC · 912 kbps · 44.1 kHz · Stereo"; for radio the station comes first.
    /// Empty when stopped.
    in property <string> format-info;
    /// True for internet radio: there is no length, and seeking does nothing.
    in property <bool> live;
    /// Why the last track could not be played, until another one starts. Empty otherwise.
    in property <string> error;
    in property <PlaybackState> state: PlaybackState.stopped;

    /// Position and length in seconds; `length` is 0 when unknown.
    in property <float> position;
    in property <float> length;
    /// The same, formatted for display: "1:23", "3:45" and "-2:22".
    in property <string> position-text: "0:00";
    in property <string> length-text: "0:00";
    in property <string> remaining-text: "-0:00";

    /// 0.0 to 1.0; 0 while muted.
    in property <float> volume: 1.0;
    /// Whether the sound is muted: `toggle-mute` or `set-volume` brings it back.
    in property <bool> muted;

    /// Cover art of the current track, if it has any.
    in property <image> cover;
    in property <bool> has-cover;

    callback play();
    callback pause();
    /// Play when paused or stopped, pause when playing.
    callback toggle-pause();
    callback stop();
    callback next();
    callback previous();
    /// Seek to a fraction (0.0 to 1.0) of the track.
    callback seek(float);
    /// Seek relative to the current position, in seconds (may be negative).
    callback seek-by(float);
    callback set-volume(float);
    /// Mute, or bring back the volume from before.
    callback toggle-mute();
    /// Ask the user for files to play.
    callback open-files();
}

/// The playlist. Optional: a skin without a playlist does not export it.
export global Playlist {
    in property <[TrackRow]> rows;
    /// "12 tracks · 47:13"; ends with "+" when some lengths are unknown.
    in property <string> summary;
    /// Row the keyboard acts on, or -1.
    in property <int> cursor: -1;
    in property <bool> shuffle;
    in property <bool> repeat;
    /// True while files are dragged over the window.
    in property <bool> drop-hover;

    /// Play this row (double-click or Enter).
    callback activate(int);
    /// Click on a row. `extend` selects a range (Shift), `toggle` adds or removes one row
    /// (Ctrl, or Cmd on macOS).
    callback select(int, bool, bool);
    /// Move the keyboard cursor by a number of rows; `extend` grows the selection (Shift).
    callback move-cursor(int, bool);
    callback select-all();
    callback clear-selection();
    callback remove-selected();
    /// Move the selected rows to before the given row (the row count means the end).
    callback move-selected(int);
    callback clear();
    callback add-files();
    callback add-folder();
    /// Add an internet radio stream, or a station playlist (.pls, .m3u) from a radio
    /// directory, and play it.
    callback add-url(string);
    callback save();
    callback load();
    callback toggle-shuffle();
    callback toggle-repeat();
}

/// One row of the library: an artist, an album or a track.
export struct LibraryRow {
    /// "artist", "album", "genre" or "track".
    kind: string,
    /// The artist's, album's, genre's or track's name; "Unknown artist", "Unknown album" or
    /// "Unknown genre" when untagged.
    title: string,
    /// "3 albums · 41 tracks" for artists and genres, "1997 · 12 tracks" for albums, and for
    /// tracks the artist and album when they are not already clear from the heading. May be
    /// empty.
    detail: string,
    /// The artist of an album or track, for columns and album covers; otherwise empty.
    artist: string,
    /// The album of a track; otherwise empty.
    album: string,
    /// For albums and artists: what to pass to `Library.cover` for the album's cover or the
    /// artist's picture. Otherwise empty.
    cover: string,
    /// Track number for tracks shown in their album ("3", or "2.03" on the second disc);
    /// otherwise empty.
    number: string,
    /// "3:45" for tracks; otherwise empty.
    duration: string,
    /// For tracks in Recently Played: when the track was played last, "3 days ago"; in Most
    /// Played: how often, "12 plays". Otherwise empty.
    played: string,
    /// For tracks shown in their album: how often each was played, "1,204"; empty for none.
    plays: string,
    /// For albums: whether it is one of the user's favourites.
    favorite: bool,
}

/// What the user may change about an artist, for a form: see `Library.edit-artist`. Each
/// field is empty where they changed nothing.
export struct ArtistDraft {
    /// The artist as their tags name them, which the changes are kept by.
    artist: string,
    name: string,
    /// The name they are sorted by: "Beatles, The".
    sort-name: string,
    /// Their MusicBrainz id, and the one Freya has without it, from the tags or a search.
    mbid: string,
    found-mbid: string,
    /// Their biography: theirs, in place of what the internet says, else the internet's, to
    /// start from: "Wikipedia" or "Last.fm" says where from, empty for theirs. Saved
    /// unchanged, the internet's stays the internet's.
    biography: string,
    biography-from: string,
    /// What the top of their page shows: "auto", their wide picture when they have one, else
    /// their picture; "wide", the same; or "picture", their picture though they have a wide one.
    header: string,
}

/// The genre being changed: see `Library.edit-genre`.
export struct GenreDraft {
    shown: bool,
    name: string,
    /// Its description: the user's own, else the internet's to start from.
    description: string,
    /// Its picture and wide picture as chosen so far; empty for none.
    picture: image,
    backdrop: image,
    /// Why a picture could not be used.
    error: string,
}

/// The artist being matched: see `Library.match-artist`.
export struct ArtistMatchDraft {
    artist: string,
    /// Their MusicBrainz id as the user matched it, and as Freya has it without that, from
    /// the tags or a search; each empty when there is none.
    mbid: string,
    found-mbid: string,
}

/// An artist MusicBrainz knows, to say which one of a name the user's is: see
/// `Library.artist-matches`.
export struct MatchChoice {
    mbid: string,
    name: string,
    /// MusicBrainz's words to tell them apart: "Norwegian jazz/metal/rock group".
    detail: string,
    /// "Group · Norway · 1999–".
    facts: string,
    /// A small picture of them, when fanart.tv has one.
    picture: image,
}

/// The album being matched: see `Library.match-album`.
export struct AlbumMatchDraft {
    title: string,
    artist: string,
    /// Where its files are.
    folder: string,
    /// The MusicBrainz release group the user matched it to; empty when Freya files it as
    /// its tags say.
    release-group: string,
}

/// An album MusicBrainz knows, with the artist who made it: see `Library.album-matches`.
export struct AlbumMatchChoice {
    release-group: string,
    title: string,
    /// "Album · 2010".
    facts: string,
    artist: string,
    /// MusicBrainz's words to tell the artist from others of the name.
    detail: string,
    /// Its cover, from the Cover Art Archive, when it has one.
    picture: image,
}

/// A picture to choose for an artist: see `Library.portrait-choices`.
export struct PictureChoice {
    /// Empty for the choice of none.
    picture: image,
    /// Where it is from: "Folder", "Deezer", "fanart.tv", "Your picture"; or what none
    /// means: "Album covers", "None".
    source: string,
    /// "1000 × 1000"; empty for none.
    size: string,
    chosen: bool,
}

/// An artist's own page, over their albums: see `Library.artist-page`.
export struct ArtistPage {
    /// True while an artist's albums are shown, or a genre's.
    shown: bool,
    /// "artist", or "genre": then `picture` is the genre's picture, square, `portrait` empty,
    /// and Fix Match is not for it.
    kind: string,
    name: string,
    /// Whether the artist is one of the user's favourites: see `Library.toggle-favorite`.
    favorite: bool,
    /// "4 albums · 52 tracks · 3 h 41 min".
    detail: string,
    /// Their most frequent genres in the library's tags: "Pop/Rock, Folk".
    genres: string,
    /// What to pass to `Library.cover` for their picture.
    picture: string,
    /// A wide picture of them across the top of the page, from their folder (fanart.jpg) or
    /// fanart.tv; empty (zero width) when there is none, or before it is decoded.
    banner: image,
    /// Whether they have a wide picture, though `banner` may not be decoded yet: the page keeps
    /// its place for it rather than showing `portrait` first.
    has-banner: bool,
    /// Their picture cut round, clear outside the circle, beside their name when they have no
    /// wide picture; empty before the grid's picture of them is made.
    portrait: image,
    /// Their picture whole and large, uncut, to show on its own; empty when they have none
    /// but a collage of covers.
    picture-full: image,
    /// A color from their picture, dark enough for white text.
    color: color,
    /// What Last.fm says of them, in plain text: a short biography, the whole one, and the
    /// tags its listeners gave them. Empty when Last.fm is not asked or knows nothing.
    summary: string,
    biography: string,
    tags: string,
    /// Whether `summary` and `biography` are the user's own text; else where they are from:
    /// "Wikipedia", found by their MusicBrainz id, or "Last.fm".
    own-biography: bool,
    biography-from: string,
    /// What tells them from others of the name, once matched in MusicBrainz: "Norwegian
    /// jazz/metal/rock group".
    note: string,
    /// Whether `Library.popular` shows all ten tracks rather than five, and how many there
    /// are in all.
    more: bool,
    popular-count: int,
}

/// An album's own page, over its tracks: see `Library.album-page`.
export struct AlbumPage {
    /// True while an album's tracks are shown.
    shown: bool,
    title: string,
    /// The album's artist, which `open-album-artist` opens.
    artist: string,
    /// "2026 · 10 tracks, 47 min 34 s".
    detail: string,
    /// What to pass to `Library.cover` for the album's cover.
    cover: string,
    /// A color from the cover for the page behind it, dark enough for white text.
    color: color,
    /// Whether it is one of the user's favourites: see `Library.toggle-album-favorite`.
    favorite: bool,
    /// Its cover whole and large, once read after `Library.show-album-cover`; empty before.
    picture-full: image,
}

/// A section of the search page: rows `first` to `first + count` of `Library.rows`, of the
/// kind "songs", "artists", "albums", "playlists" or "genres", titled "Songs" and so on.
export struct SearchSection {
    kind: string,
    title: string,
    first: int,
    count: int,
}

/// A letter to jump to in the artists or albums shown: see `Library.letters`.
export struct LetterJump {
    /// "#", "A" to "Z", or another letter names start with, such as "Å".
    letter: string,
    /// The first row whose name starts with it; for a letter none does, the next one's.
    row: int,
    /// Whether any name starts with it.
    present: bool,
}

/// The media library: the music in the folders the user chose, browsed by artist and album,
/// or searched. Optional; Freya only reads the folders when the skin exports this global.
export global Library {
    /// What is shown: all artists, an artist's albums, an album's tracks, or search results.
    in property <[LibraryRow]> rows;
    /// Where browsing started: "artists", "albums", "songs", "genres", "recently-added",
    /// "recently-played" or "most-played". Change it with `show`.
    in property <string> section: "artists";
    /// How the rows are best shown: "list" (artists, genres, an album's tracks), "grid"
    /// (albums, as covers), "table" (tracks from many albums, with artist and album columns,
    /// and in Recently Played and Most Played the rows' `played`) or "discography" (an
    /// artist's albums with `album-view` "list": each album row followed by its tracks, numbered
    /// as in the album; activating a track plays its album from it).
    in property <string> layout: "list";
    /// While an album's tracks are shown (layout "list"), what a page for the album shows
    /// over them, for skins that make one.
    in property <AlbumPage> album-page;
    /// While an artist's albums are shown (layout "grid" or "discography"), what a page for the
    /// artist shows over them, for skins that make one.
    in property <ArtistPage> artist-page;
    /// Their most played tracks, numbered 1 up, with `plays` and an album's `cover`; empty
    /// for an artist whose music was not played.
    in property <[LibraryRow]> popular;
    /// Whether a scan asks Last.fm what it says of artists who lack it, telling it their
    /// names; their pages show what was kept. Kept between runs.
    in property <bool> artist-bios-online: true;
    /// Whether a scan asks Wikipedia for the opening of artists' articles, found by their
    /// MusicBrainz id, which their pages show before what Last.fm says. Kept between runs.
    in property <bool> artist-wikipedia-online: true;
    /// Whether the server's radio directory has Radio Browser's stations, which it fetches about
    /// once a week and tells which are played; only the stations Freya picked otherwise.
    in property <bool> radio-directory-online: true;
    /// The user's personal fanart.tv API key, for a scan to ask for pictures of artists who
    /// lack them; empty for none. Kept between runs.
    in property <string> fanart-key;
    /// The row of the track playing or paused, or -1 when it is not among the rows.
    in property <int> playing-row: -1;
    /// Whether the track playing is in the library, so `open-playing-artist` and
    /// `open-playing-album` can open it.
    in property <bool> playing-known;
    /// Each time `reveals` counts up, the library opened something for the user: show its
    /// list from the top, or, when `reveal-row` is a row, put the keyboard on it and scroll it
    /// into view.
    in property <int> reveal-row: -1;
    in property <int> reveals;
    /// True while the artists are shown, which `artist-sort` and `artist-view` apply to.
    in property <bool> artist-options;
    /// How the artists are ordered: "name", "most-played" or "recently-added". Kept between
    /// runs.
    in property <string> artist-sort: "name";
    /// How the artists are shown: "grid" (layout "grid": a picture of each, from `cover`) or
    /// "list". Kept between runs.
    in property <string> artist-view: "grid";
    /// Whether a scan may ask Deezer for pictures of artists who lack one, telling it their
    /// names. A picture an artist has stays theirs. Kept between runs.
    in property <bool> artist-pictures-online: true;
    /// True while an artist's albums are shown, which `album-sort` and `album-view` apply to.
    in property <bool> album-options;
    /// How an artist's albums are ordered: "release-date" (newest first) or "name". Kept
    /// between runs.
    in property <string> album-sort: "release-date";
    /// How an artist's albums are shown: "grid" (covers) or "list" (layout "discography").
    /// Kept between runs.
    in property <string> album-view: "grid";
    /// Heading for the rows: "Artists", "Albums", "Songs", "Genres", "Recently Added",
    /// "Recently Played", "Most Played", an artist, a genre, an album, or "Search".
    in property <string> title;
    /// A line under the heading, like "Björk · 1995 · 11 tracks · 46:12". May be empty.
    in property <string> subtitle;
    /// True below the section's own list, or while searching, where `back()` goes back.
    in property <bool> can-go-back;
    /// The search text. Bind a text field to it (`text <=> Library.query`) and call `search`
    /// when it is edited; Freya clears it when the search ends.
    in-out property <string> query;
    /// The music folders the library is made from.
    in property <[string]> folders;
    /// True while Freya reads the folders.
    in property <bool> scanning;
    /// Whether the music folders are watched, and what changes in them scanned a few seconds
    /// after; how often the whole library is scanned, in hours, for what watching misses, as
    /// on network drives (0 for never); and whether it is each time Freya starts. Kept
    /// between runs.
    in property <bool> watch-folders: true;
    in property <int> scan-every-hours: 24;
    in property <bool> scan-at-start;
    callback set-watch-folders(bool);
    callback set-scan-every-hours(int);
    callback set-scan-at-start(bool);
    /// While searching, which kind of match the rows are: "all", "songs", "artists", "albums",
    /// "playlists" or "genres"; set with `set-search-filter`. With "all", `layout` is "search":
    /// `search-sections` say which rows are what, and `search-top` is the row of the best match
    /// of all, or -1.
    /// While the albums are shown: how they are ordered, "added" (by when they came into the
    /// library or were made favourites, the latest first), "played" (the latest played
    /// first), "name" or "artist"; set with `set-albums-sort`, and kept between runs.
    in property <bool> albums-options;
    in property <string> albums-sort: "added";
    callback set-albums-sort(string);
    /// While the playlists are shown, as the section "playlists": how they are ordered,
    /// "added" (by when they were made or made favourites, the latest first) or "name"; set
    /// with `set-playlists-sort`, and kept between runs.
    in property <bool> playlists-options;
    in property <string> playlists-sort: "added";
    callback set-playlists-sort(string);
    /// Make an album, artist or playlist a favourite, or not one any longer: the `row`th row's,
    /// or the album or artist whose page is shown. A favourite is as recently added as when it
    /// was made one.
    callback toggle-favorite(int);
    callback toggle-album-favorite();
    /// Read the cover of the album whose page is shown whole, from its music, into its
    /// page's `picture-full`.
    callback show-album-cover();
    in property <string> search-filter: "all";
    /// Whether the rows are a search's; with "all", the songs beside the best match, and the
    /// other kinds' sections under them.
    in property <bool> search-shown;
    in property <SearchSection> search-songs;
    in property <[SearchSection]> search-sections;
    in property <int> search-top: -1;
    callback set-search-filter(string);
    /// A few of the best matches of what is typed, for under the search field, without leaving
    /// what is shown: `suggest` asks; `open-suggestion` opens one: an artist, album or genre in
    /// the library; a song plays; a playlist shows.
    in property <[LibraryRow]> suggestions;
    callback suggest(string);
    callback open-suggestion(int);
    /// The letters to jump to beside the artists or albums shown, when they are in the order
    /// of their names; empty otherwise.
    in property <[LetterJump]> letters;
    /// "10,412 tracks · 682 albums", or a scan's progress: "Reading 1,234 of 5,000 files".
    in property <string> status;
    /// While scanning, the folder looked through or read now, with the one it is in: "Peter
    /// Gabriel / So". Empty otherwise.
    in property <string> scan-folder;

    /// Search for tracks whose artist, album, title, genre or file name has words starting
    /// with each word of the text. Empty text goes back to browsing.
    callback search(string);
    /// Double-click or Enter: open an artist or album. On a track, the playlist becomes the
    /// tracks shown, playing from this one.
    callback activate(int);
    /// Replace the playlist with the row's tracks (all of an artist's or album's) and play.
    callback play(int);
    /// Add the row's tracks to the end of the playlist.
    callback enqueue(int);
    /// `play` and `enqueue` for every row shown.
    callback play-all();
    callback enqueue-all();
    /// Start browsing `section`: "artists", "albums", "songs" or "genres"; or the Recents:
    /// "recently-added" (the 200 albums that came last), "recently-played" (the 200 tracks
    /// played last) or "most-played" (the 200 tracks played most). A track counts as played
    /// once it has been listened to for half its length or four minutes.
    callback show(string);
    /// Goes up by one whenever new covers are ready. Pass it to `cover`, so covers shown empty
    /// are asked for again.
    in property <int> covers-ready;
    /// A small cover for a row's `cover`, about 300 pixels: `cover(row.cover, covers-ready)`.
    /// Empty (zero width) while it is being made, and for albums without one. Covers are made
    /// as they are first asked for, so only call it for rows that are on screen.
    pure callback cover(string, int) -> image;
    /// Play every row shown in shuffled order, from a random one, with shuffle turned on.
    callback shuffle-all();
    /// Open the artist of the album shown (`album-page.artist`).
    callback open-album-artist();
    /// Show the library at the artist of the track playing, or at its album with its row
    /// revealed (`reveal-row`). Freya sets `App.view` to "library".
    callback open-playing-artist();
    callback open-playing-album();
    /// Play the popular tracks shown, from the `index`th; show all ten or five again.
    callback play-popular(int);
    callback more-popular();
    callback set-artist-bios-online(bool);
    callback set-artist-wikipedia-online(bool);
    callback set-radio-directory-online(bool);
    callback set-fanart-key(string);
    /// Start changing the artist whose page is shown: Freya sets `artist-draft` to what was
    /// changed about them before. `save-artist` keeps the name, sort name, MusicBrainz id,
    /// biography and header given; empty ones go back to the tags' and the internet's.
    in property <ArtistDraft> artist-draft;
    callback edit-artist();
    callback save-artist(string, string, string, string, string);
    /// Leave the artist as they were.
    callback cancel-artist();
    /// Change the genre whose page is shown: `edit-genre` starts, filling `genre-draft`;
    /// `pick-genre-picture` asks for a file and `clear-genre-picture` takes one away, "picture"
    /// or "backdrop"; `save-genre` keeps the description given with the pictures chosen,
    /// `cancel-genre` none of it.
    in property <GenreDraft> genre-draft;
    callback edit-genre();
    callback pick-genre-picture(string);
    callback clear-genre-picture(string);
    callback save-genre(string);
    callback cancel-genre();
    /// While the artist is changed: pictures to choose from, square and wide, the first of
    /// each meaning none; more come while `finding-pictures`. `choose-picture` chooses one of
    /// a kind, "portrait" or "backdrop", by its index; the choice is kept by `save-artist`.
    in property <[PictureChoice]> portrait-choices;
    in property <[PictureChoice]> backdrop-choices;
    in property <bool> finding-pictures;
    /// Why the last picture given could not be used; empty when it could.
    in property <string> picture-error;
    callback choose-picture(string, int);
    /// Add a picture of the kind from a file the user picks, or from an address on the web,
    /// and choose it.
    callback pick-picture-file(string);
    callback picture-from-url(string, string);
    /// Match the artist whose page is shown to the one in MusicBrainz they are: Freya sets
    /// `artist-match` and lists in `artist-matches` the artists MusicBrainz finds by their
    /// name, or by the words given to `find-matches`, best matches first; more come while
    /// `finding-matches`. `save-artist-match` keeps the one with the id given, or Freya's own
    /// for an empty one, and ends the matching, as `cancel-artist-match` does.
    in property <ArtistMatchDraft> artist-match;
    in property <[MatchChoice]> artist-matches;
    in property <bool> finding-matches;
    /// Why the search did not work; empty when it did.
    in property <string> match-error;
    callback match-artist();
    callback find-matches(string);
    callback save-artist-match(string);
    callback cancel-artist-match();
    /// Match the album shown to the album in MusicBrainz it is, and so to the artist who made
    /// it: Freya sets `album-draft` and searches by its title and artist. Albums of another
    /// artist of the same name are then filed under an artist of their own.
    in property <AlbumMatchDraft> album-draft;
    in property <[AlbumMatchChoice]> album-matches;
    in property <bool> finding-album-matches;
    in property <string> album-match-error;
    callback match-album();
    /// Search again, by a title and an artist.
    callback find-album-matches(string, string);
    /// Match the album to the one found of the release group given, or to none for an empty
    /// one, filing it as its tags say; either ends the matching, as `cancel-album-match`
    /// does.
    callback save-album-match(string);
    callback cancel-album-match();
    /// Change `artist-sort`, `artist-view` or `artist-pictures-online`.
    callback set-artist-sort(string);
    callback set-artist-view(string);
    callback set-artist-pictures-online(bool);
    /// Change `album-sort` or `album-view`.
    callback set-album-sort(string);
    callback set-album-view(string);
    /// Back to the list shown before: from an album to the artist or genre it was opened from,
    /// and so on up to the section's own list. Ends a search first.
    callback back();
    /// The folders while the user edits them, for a dialog with Cancel and Save: `edit-folders`
    /// starts them from `folders`, `Server.browse-add` adds one of the server's, wherever it
    /// runs, `remove-draft-folder` takes one away, and only `save-folders` puts them in use
    /// and reads them. Cancelling is not saving.
    in property <[string]> folders-draft;
    callback edit-folders();
    callback remove-draft-folder(int);
    callback save-folders();
    /// Scan the folders: read the files that changed, make the covers of albums that changed,
    /// take in the pictures in artists' folders, and ask the internet for what artists lack,
    /// as allowed. `status` and `scan-folder` tell how far it is.
    callback rescan();
    /// Scan as `rescan` does, reading every file and making every cover again, changed or not.
    callback rescan-files();
    /// Scan only the `index`th of `folders`, leaving the others' tracks as they are.
    callback scan-one-folder(int);
    /// Stop the scan running; what it did so far is kept.
    callback stop-scan();
}

/// One of the playlists the user keeps, as the navigation lists them.
/// The playlist shown, as its page shows it: see `Playlists.page`.
export struct PlaylistPage {
    name: string,
    /// What the user wrote about it; may be empty.
    description: string,
    /// What to pass to `Library.cover` for its picture: the user's, else its tracks' covers.
    picture: string,
    /// Its wide picture across the top of its page, once decoded; `has-banner` while it is.
    banner: image,
    has-banner: bool,
    /// A color from its pictures, dark enough for white text.
    color: color,
    /// "84 tracks · 6 h 9 min".
    summary: string,
    /// Whether it is one of the user's favourites: see `Playlists.toggle-favorite`.
    favorite: bool,
    /// How its tracks are ordered: "custom" (as the playlist has them), "title", "artist",
    /// "album", "added" or "duration".
    sort: string,
}

/// A track of the playlist shown, in the order of `PlaylistPage.sort`.
export struct PlaylistEntryRow {
    /// Its row, from 1.
    number: int,
    title: string,
    artist: string,
    album: string,
    /// What to pass to `Library.cover` for its album's cover; empty when the library has it not.
    cover: string,
    /// When it was added: "23 Dec 2025".
    added: string,
    /// "3:05", or empty when unknown.
    duration: string,
}

/// The playlist being changed: see `Playlists.edit`.
export struct PlaylistDraft {
    shown: bool,
    name: string,
    description: string,
    /// Its picture and wide picture as chosen so far; empty for none.
    picture: image,
    backdrop: image,
    /// Why a picture could not be used.
    error: string,
}

export struct PlaylistRow {
    name: string,
    /// How many tracks it has, as text.
    count: string,
}

/// Playlists the user keeps in Freya, apart from the queue (`Playlist`, shown as Up Next).
/// Optional. Each is an M3U file in Freya's data folder.
export global Playlists {
    in property <[PlaylistRow]> playlists;
    /// The playlist chosen with `show`, or -1.
    in property <int> shown: -1;
    /// The tracks of the playlist shown. `selected` and `current` are always false.
    in property <[TrackRow]> tracks;
    /// "12 tracks · 48:10" for the playlist shown.
    in property <string> summary;
    /// Why the last `create`, `save-queue` or `rename` failed, like "There is already a
    /// playlist called …"; empty after one that worked. Freya answers at once.
    in property <string> error;
    callback show(int);
    /// Make a new, empty playlist, and show it.
    callback create(string);
    /// Keep Up Next as a new playlist, and show it.
    callback save-queue(string);
    /// Rename the playlist shown.
    callback rename(string);
    /// Delete the playlist shown, and its file.
    callback delete();
    /// Up Next becomes the playlist shown, playing from the given row.
    callback play(int);
    /// Add the playlist shown to the end of Up Next.
    callback enqueue();
    /// Remove a track from the playlist shown.
    callback remove(int);
    /// Add Up Next's selected tracks (all of them when none is selected) to a playlist.
    callback add-queue-selection(int);
    /// Add everything a library row stands for to a playlist: `add-library-row(playlist, row)`.
    callback add-library-row(int, int);
    /// The playlist shown, as its own page shows it, and its tracks in the order it says.
    /// `play`, `remove` and the rest take rows of `entries`.
    in property <PlaylistPage> page;
    in property <[PlaylistEntryRow]> entries;
    /// Up Next becomes the playlist shown, shuffled.
    callback shuffle();
    /// Order the tracks shown: see `PlaylistPage.sort`.
    callback set-sort(string);
    /// Change the playlist shown: `edit` starts, filling `draft`; `pick-picture` asks for a
    /// file and `clear-picture` takes one away, "picture" or "backdrop"; `save-edit` keeps the
    /// name and description given with the pictures chosen, `cancel-edit` none of it.
    in property <PlaylistDraft> draft;
    callback edit();
    callback pick-picture(string);
    callback clear-picture(string);
    callback save-edit(string, string);
    callback cancel-edit();
    /// Make the playlist shown a favourite, or not one any longer. A favourite is as recently
    /// added as when it was made one.
    callback toggle-favorite();
}

/// One saved radio station.
export struct StationRow {
    name: string,
    /// The station's address without "https://", for showing.
    address: string,
    /// True while this station plays.
    playing: bool,
}

/// A station of the radio directory, as the radio view shows it.
export struct DirectoryStationRow {
    name: string,
    /// Its tags but its quality, the first few: "Jazz · Italy · Italian".
    detail: string,
    /// "Hi-Res", "Lossless" or "320 kbps"; empty when not known.
    quality: string,
    /// Whether the server keeps it among its stations.
    saved: bool,
    /// True while it plays.
    playing: bool,
    /// Whether Freya picked it.
    featured: bool,
    /// Its logo, once it is fetched; empty until then, and for a station without one.
    logo: image,
}

/// A tag of the radio directory, to find stations by.
export struct RadioTagRow {
    /// What `toggle-tag` is given: "genre:jazz".
    id: string,
    /// As shown: "Jazz", "Italy".
    name: string,
    /// "quality", "genre", "era", "format", "country" or "language".
    kind: string,
    /// How many stations have it: of the directory on its first page, of those found after.
    stations: int,
    /// Whether it is looked for.
    chosen: bool,
}

/// The radio directory's tags of one kind.
export struct RadioTagGroup {
    /// "quality", "genre", "country", "language", "era" or "format".
    kind: string,
    /// As shown: "Genres", "Countries".
    title: string,
    tags: [RadioTagRow],
}

/// A row of the radio directory's first page: its stations are `found[first]` and the
/// `count` after it.
export struct RadioShelfRow {
    title: string,
    first: int,
    count: int,
    /// Whether it is a tag's, or a few tags', which `show-shelf` looks for; otherwise the
    /// stations Freya picked.
    tagged: bool,
}

/// Internet radio: the stations the server keeps for its users, none at first, which its
/// admins (`Server.admin`) add and remove; and the server's directory of stations to find
/// more in, by tags and words. Optional.
export global Radio {
    in property <[StationRow]> stations;
    /// Why the last `add` failed, like "Not a web address: …"; empty after one that worked.
    in property <string> error;
    /// Play a station: its entry in the playlist when it is there, else added to the end.
    callback play(int);
    /// Save a station: a name, and the address of its stream or of its .pls or .m3u file.
    /// "http://" may be left out; without a name, the station is named after the address.
    callback add(string, string);
    callback remove(int);

    /// The directory: "loading" while its stations are first fetched, "ready", "off" when the
    /// server may not ask Radio Browser (only the stations Freya picked are in it), "failed".
    in property <string> directory;
    /// "45,012 stations", or how fetching them goes.
    in property <string> summary;
    /// The stations shown: those found, or the first page's rows' one after another.
    in property <[DirectoryStationRow]> found;
    /// The first page's rows; none while words or tags are looked for.
    in property <[RadioShelfRow]> shelves;
    /// How many stations the words and tags looked for find, of which `found` are the first;
    /// -1 while none are looked for, and the first page shows.
    in property <int> total: -1;
    /// The tags to choose, by kind: the directory's best known on the first page, the tags of
    /// the stations found after; the most first within each kind.
    in property <[RadioTagGroup]> tags;
    /// The tags looked for.
    in property <[RadioTagRow]> chosen;
    /// The words looked for.
    in property <string> query;
    /// Whether the server is being asked.
    in property <bool> searching;
    /// Look for stations with every one of these words in their names or tags.
    callback find(string);
    /// Look for stations with a tag too, by its id, or no longer.
    callback toggle-tag(string);
    /// Look for the stations of a row of the first page, by its index in `shelves`.
    callback show-shelf(int);
    /// Back to the first page.
    callback clear-find();
    /// More of the stations found, after those in `found`; when they are all there, nothing.
    callback more();
    /// Play a station of `found`, as a saved one plays.
    callback play-found(int);
    /// Keep a station of `found` among the server's stations, or no longer when it is kept;
    /// for an admin.
    callback save-found(int);
}

/// The 10-band equalizer. Optional. Gains are in decibels, from -12 to +12.
export global Equalizer {
    in property <bool> enabled;
    in property <float> preamp;
    /// Gains of the bands, low to high.
    in property <[float]> bands;
    /// Labels of the bands: "60", "170", … "16k".
    in property <[string]> band-labels;
    /// Names of the built-in presets, for `load-preset`.
    in property <[string]> presets;
    /// Name of the preset matching the current settings, or "Custom".
    in property <string> preset-name;
    /// SVG path data for the response curve through `bands`, in a box of `width` × `height`
    /// (plain numbers, e.g. pixels): x runs from the lowest to the highest band; 0 dB is at half
    /// the height, +12 dB at 5 % and -12 dB at 95 %. Use the box size as the Path's viewbox:
    ///
    ///     Path {
    ///         viewbox-width: self.width / 1px;
    ///         viewbox-height: self.height / 1px;
    ///         commands: Equalizer.curve(self.width / 1px, self.height / 1px, Equalizer.bands);
    ///     }
    pure callback curve(float, float, [float]) -> string;

    callback toggle();
    callback set-preamp(float);
    /// Set band `index` to `gain` dB.
    callback set-band(int, float);
    /// Load the built-in preset at this index in `presets`.
    callback load-preset(int);
    /// Set every band and the preamp to 0 dB.
    callback reset();
    /// Load or save a Winamp `.eqf` preset file.
    callback load-file();
    callback save-file();
}

/// Where a `NativeSpectrum` is in the window, and how it looks. `NativeSpectrum` keeps this up
/// to date; skins do not set it themselves.
export struct SpectrumArea {
    x: length,
    y: length,
    width: length,
    height: length,
    shown: bool,
    bar-color: color,
    peak-color: color,
    peak-thickness: length,
    background: color,
}

/// Where `NativeHologram` is; kept up to date by that component.
export struct HologramArea {
    x: length,
    y: length,
    width: length,
    height: length,
    corner-radius: length,
    shown: bool,
}

/// Where `NativeOscilloscope` is in the window, and how its line looks; kept up to date by
/// that component.
export struct OscilloscopeArea {
    x: length,
    y: length,
    width: length,
    height: length,
    shown: bool,
    line-color: color,
    line-width: length,
}

/// Visualization of what is playing. Optional. Updated up to 60 times a second while
/// something plays; nothing is computed when the skin does not export this global.
export global Visualizer {
    /// "spectrum", "oscilloscope", "hologram" or "off".
    in property <string> mode: "spectrum";
    /// How many spectrum bars the skin draws. Set it once, e.g. in `init`; `bars` and `peaks`
    /// then have this many values.
    in-out property <int> bar-count: 32;
    /// Bar heights from 0 to 1, from low to high frequencies on a logarithmic scale.
    in property <[float]> bars;
    /// Peak markers from 0 to 1; they stay up briefly after a bar falls.
    in property <[float]> peaks;
    /// The last few milliseconds of audio, from -1 to 1.
    in property <[float]> waveform;

    /// Switch to the next mode: spectrum, oscilloscope, hologram, off.
    callback cycle-mode();
    /// Switch to `mode`: "spectrum", "oscilloscope", "hologram" or "off". Other values are ignored.
    callback set-mode(string);
    /// Frames a second the visualization is drawn at while the window has focus; kept
    /// between runs.
    in property <int> fps: 30;
    /// Draw at this many frames a second, from 10 to 120.
    callback set-fps(int);
    /// Whether the skin shows a visualization right now. A skin that puts it in a view of its
    /// own sets this to false while another view is shown; Freya then computes nothing for it.
    in-out property <bool> showing: true;
    /// SVG path data for `waveform` in a `width` × `height` box; use the box as the Path's
    /// viewbox, like `Equalizer.curve`.
    pure callback wave(float, float, [float]) -> string;
    /// SVG path data for spectrum bars in a `width` × `height` box: pass `bars`. Drawing the
    /// spectrum as one Path is much cheaper than one Rectangle per bar, because every frame
    /// then evaluates one binding instead of several per bar.
    pure callback bars-path(float, float, [float]) -> string;
    /// The same for peak markers: pass `peaks` and the markers' thickness.
    pure callback peaks-path(float, float, [float], float) -> string;

    /// True when Freya draws `NativeSpectrum` itself, on top of the window. `bars` and
    /// `peaks` are then not updated, so nothing else in the skin should show them.
    in property <bool> native-drawing;
    /// Where the `NativeSpectrum` is; kept up to date by that component.
    in-out property <SpectrumArea> native-area;

    /// True when Freya draws `NativeOscilloscope` itself, on top of the window: so far on
    /// macOS. `waveform` is then not updated while a `NativeOscilloscope` is shown.
    in property <bool> oscilloscope-drawing;
    /// Where the `NativeOscilloscope` is; kept up to date by that component.
    in-out property <OscilloscopeArea> oscilloscope-area;

    /// True when Freya can draw the hologram (`NativeHologram`): so far on macOS.
    in property <bool> hologram-drawing;
    /// Where the `NativeHologram` is; kept up to date by that component.
    in-out property <HologramArea> hologram-area;
}

/// An oscilloscope that costs little CPU, for `Visualizer.mode` "oscilloscope": where it can
/// (`Visualizer.oscilloscope-drawing`), Freya draws the line itself in a layer on top of the
/// window, which the graphics card draws, so the window is not redrawn for every frame. The line
/// spans the box's width and 90 % of its height, like `Visualizer.wave`. Nothing of the skin
/// can be drawn on top of it. Where Freya cannot draw it, the box shows its background: draw
/// the line with a `Path` and `Visualizer.wave` there instead.
export component NativeOscilloscope inherits Rectangle {
    in property <color> line-color: #a35f00;
    in property <length> line-width: 2px;
    /// Set to false while the oscilloscope should not show.
    in property <bool> shown: true;

    function report() {
        Visualizer.oscilloscope-area = {
            x: self.absolute-position.x,
            y: self.absolute-position.y,
            width: self.width,
            height: self.height,
            shown: self.shown,
            line-color: self.line-color,
            line-width: self.line-width,
        };
    }

    init => { self.report(); }
    changed absolute-position => { self.report(); }
    changed width => { self.report(); }
    changed height => { self.report(); }
    changed shown => { self.report(); }
    changed line-color => { self.report(); }
    changed line-width => { self.report(); }
}

/// The hologram, for `Visualizer.mode` "hologram": a woman projected in translucent light over a
/// city at night in the rain, after Blade Runner 2049. Freya draws it with the graphics card,
/// in a layer of its own on top of the window, up to 60 frames a second; it moves whether
/// or not something plays, and the bass drives its glitches and glow. Nothing of the skin can
/// be drawn on top of it. Where Freya cannot draw it (`Visualizer.hologram-drawing` is false),
/// the box shows its background.
export component NativeHologram inherits Rectangle {
    /// Set to false while the hologram should not show.
    in property <bool> shown: true;

    function report() {
        Visualizer.hologram-area = {
            x: self.absolute-position.x,
            y: self.absolute-position.y,
            width: self.width,
            height: self.height,
            corner-radius: self.border-radius,
            shown: self.shown,
        };
    }

    init => { self.report(); }
    changed absolute-position => { self.report(); }
    changed width => { self.report(); }
    changed height => { self.report(); }
    changed shown => { self.report(); }
    changed border-radius => { self.report(); }

    background: #000000;
}

/// A spectrum that costs little CPU: where it can, Freya draws it itself in a layer on top of
/// the window, so the window is not redrawn for every frame of the spectrum. Elsewhere it is
/// drawn like any other part of the skin. Use at most one; nothing of the skin can be drawn
/// on top of it, and its colors are solid (no gradients or transparency effects).
export component NativeSpectrum inherits Rectangle {
    in property <color> bar-color: #a35f00;
    in property <color> peak-color: #8a4f00;
    in property <length> peak-thickness: 2px;
    /// The color behind the bars, filling the box. Set it to the color around the spectrum:
    /// where Freya cannot draw see-through (X11), its own layer is filled with it too.
    in property <color> background-color: transparent;
    /// Set to false while the spectrum should not show, e.g. when its box is too small.
    in property <bool> shown: true;

    function report() {
        Visualizer.native-area = {
            x: self.absolute-position.x,
            y: self.absolute-position.y,
            width: self.width,
            height: self.height,
            shown: self.shown,
            bar-color: self.bar-color,
            peak-color: self.peak-color,
            peak-thickness: self.peak-thickness,
            background: self.background-color,
        };
    }

    init => { self.report(); }
    changed absolute-position => { self.report(); }
    changed width => { self.report(); }
    changed height => { self.report(); }
    changed shown => { self.report(); }
    changed bar-color => { self.report(); }
    changed peak-color => { self.report(); }
    changed peak-thickness => { self.report(); }
    changed background-color => { self.report(); }

    background: self.background-color;

    if !Visualizer.native-drawing: Path {
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: Visualizer.bars-path(self.width / 1px, self.height / 1px, Visualizer.bars);
        fill: root.bar-color;
    }
    if !Visualizer.native-drawing: Path {
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: Visualizer.peaks-path(self.width / 1px, self.height / 1px, Visualizer.peaks, root.peak-thickness / 1px);
        fill: root.peak-color;
    }
}

/// The application. Optional.
/// Something Freya does in the background: see `App.activities`.
export struct Activity {
    /// "Reading 1,234 of 5,000 files".
    title: string,
    /// Of what: "Peter Gabriel / So"; may be empty.
    detail: string,
}

/// Something Freya logged: see `App.log`.
export struct LogEntry {
    /// Local time: "26-10-18 21:36:37".
    time: string,
    /// "debug", "info", "warning" or "error".
    level: string,
    message: string,
}

export global App {
    /// What Freya does in the background now: reading the music folders, making and
    /// downloading pictures, asking the internet about artists, sending plays to Last.fm,
    /// downloading an update. Empty when it does nothing.
    in property <[Activity]> activities;
    /// What Freya logged, in this run and earlier ones, the newest first: at `log-level` or
    /// worse, at most 1,000 entries.
    in property <[LogEntry]> log;
    /// "debug", "info", "warning" or "error"; set with `set-log-level`.
    in property <string> log-level: "info";
    callback set-log-level(string);
    in property <string> version;
    /// When this copy of Freya was built, as "2026-10-17"; empty when unknown.
    in property <string> build-date;
    /// "system", "light" or "dark". Skins that support both color schemes should follow it.
    in property <string> theme: "system";
    /// Whether closing the window minimizes it to the taskbar, Freya playing on, rather than
    /// quitting; on macOS closing leaves Freya in the Dock either way. Kept between runs.
    in property <bool> close-minimizes: true;
    /// Whether the skin shows its equalizer; kept between runs.
    in property <bool> equalizer-visible;
    /// To draw into the window's title bar, set this to the height of the skin's top bar, e.g.
    /// in the window's `init`. On macOS the title bar then turns transparent, the skin reaches
    /// the window's top edge, and the window buttons sit at the left of the top bar, centred in
    /// its height. On Windows, see `window-controls`. 0, the default, keeps the system's title
    /// bar, as other systems always do.
    in-out property <length> title-bar-height;
    /// The room the window buttons take at the left of the skin's top bar, from the window's
    /// edge: 0 when the system draws its own title bar, and in full screen.
    in property <length> window-buttons-width;
    /// Whether the skin draws the window buttons itself, at the right of its top bar: on
    /// Windows, while `title-bar-height` is set, except in full screen. Bind the window's
    /// `no-frame` to it; the skin then reaches the window's top edge, and calls
    /// `minimize-window`, `toggle-maximize-window` and `close-window`.
    in property <bool> window-controls;
    /// Whether the window is maximized, for the maximize button's look.
    in property <bool> window-maximized;

    /// Back and forward, as in a web browser, for skins with views (pages): bind the window's
    /// view to `view` (`in-out property <string> view <=> App.view;`) and call `navigated`
    /// after changing it. Freya keeps where the user has been: each view, the library opened
    /// to an artist or album or searched, the playlist shown, and how far down each was
    /// scrolled. Skins without views can leave all of this out.
    in-out property <string> view;
    /// How far down the view shown is scrolled. Set it as its list scrolls, and when the list
    /// first shows.
    in-out property <length> scroll;
    /// Going back or forward sets `view`, then `restore-view` to that view and
    /// `restore-scroll` to where it was, and counts `restores` up: scroll the view's list there
    /// when `restores` changes or the list first shows with `restore-view` its view.
    /// `restore-view` is empty once the user goes elsewhere, so lists made then start at the
    /// top.
    in property <string> restore-view;
    in property <length> restore-scroll;
    in property <int> restores;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;

    /// Open the About window, which credits Freya's licences and Slint.
    callback show-about();
    /// Open Freya's skin picker.
    callback show-skins();
    /// "system", "light" or "dark".
    callback set-theme(string);
    callback set-close-minimizes(bool);
    callback toggle-equalizer();
    /// Call on a mouse press in an empty part of the top bar, when the skin draws into the
    /// title bar: the window follows the mouse, and a double click zooms or minimizes it, as
    /// the system's settings say.
    callback drag-window();
    /// The window buttons, for a skin that draws them (`window-controls`). Closing does what
    /// `close-minimizes` says.
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    /// Quit Freya, as the app's menu's Exit does, whatever closing the window does.
    callback quit();
    /// The skin changed `view`.
    callback navigated();
    callback go-back();
    callback go-forward();
    /// Open one of Freya's own pages in the browser: "github", "releases", "server" (where
    /// Freya Server is downloaded), "issues", "license", or "licenses", the third-party
    /// licenses built into Freya; or "fanart-key",
    /// fanart.tv's page for getting a personal API key. Other names are ignored; skins cannot
    /// open other addresses.
    callback open-link(string);
}

/// Scrobbling what plays to the user's Last.fm profile. Optional, and off until the user
/// connects an account: Freya then tells Last.fm what plays, and sends each track heard for half
/// its length or four minutes, whichever comes first, if it is tagged with an artist and a title
/// and longer than 30 seconds. Radio is never scrobbled.
export global LastFm {
    /// "unavailable" (this build of Freya has no Last.fm API key), "disconnected",
    /// "authorizing" (Freya opened Last.fm's page in the browser and waits for the user to allow
    /// it; it connects by itself once they have) or "connected".
    in property <string> state: "unavailable";
    /// The connected Last.fm user's name.
    in property <string> user;
    /// Whether plays are scrobbled while connected; kept between runs.
    in property <bool> scrobbling: true;
    /// Plays waiting to be sent, as while Last.fm cannot be reached.
    in property <int> waiting;
    /// What went wrong last, until something works again; empty otherwise.
    in property <string> error;

    /// Open Last.fm's page in the browser, to let Freya scrobble for the user.
    callback connect();
    /// Stop waiting for the user to allow Freya.
    callback cancel();
    /// Forget the account, and the plays waiting to be sent.
    callback disconnect();
    callback set-scrobbling(bool);
}

/// A device connected to the user's account on the server.
export struct ServerDevice {
    /// What `Server.revoke` takes.
    id: string,
    name: string,
    /// When it was connected: "2026-10-20"; when it last called the server, to the hour ("" when
    /// not known); and how: "paired" (on the server's own computer), "logged-in" (in the
    /// browser) or "".
    connected: string,
    used: string,
    joined: string,
    /// This device.
    this: bool,
}

/// A user of the server, as an admin sees them.
export struct ServerUser {
    /// What `Server.invite-again` and `remove-user` take.
    name: string,
    /// "admin" or "listener".
    role: string,
    /// "owner" (who adopted the server), "joined" (chose their password), "invited" (their code
    /// works until `invited-until`, "2026-10-30") or "not-joined" (their code ran out: invite
    /// them again).
    state: string,
    invited-until: string,
    devices: int,
}

/// A server found on the network.
export struct FoundServer {
    name: string,
    /// "192.168.1.20:47475".
    address: string,
    /// Its certificate's fingerprint, for the user to compare with what the server's own
    /// computer shows.
    fingerprint: string,
}

/// The server that keeps the library: Freya's own on this computer, or one on another computer
/// on the network, which the user finds or types in and logs in to. Optional: without it, a
/// skin always shows this computer's library.
export global Server {
    /// Whether a server is chosen, on this computer or another. Freya does nothing without
    /// one: until one is chosen, show only how to connect to one, as a welcome view, with
    /// `here`, `find`, `choose-found`, `choose-address` and `use-this-computer`.
    in property <bool> chosen;
    /// Whether Freya Server answers on this computer, so its library can be used.
    in property <bool> here;
    /// Whether the library is on another computer, what that server is called and where it is.
    in property <bool> remote;
    in property <string> name;
    in property <string> address;
    /// "connecting", "connected", "unreachable" (Freya tries again by itself), "version" (the
    /// server is of another version than Freya: `error` says which to update; Freya tries
    /// again by itself) or "log-in" (the server no longer takes this device's token: log in
    /// again).
    in property <string> state: "connecting";
    in property <string> error;
    /// The server's certificate's fingerprint, to compare with what another computer shows
    /// when it first connects; and, for the server on this computer, its name where others find
    /// it and whether they may connect.
    in property <string> fingerprint;
    in property <string> server-name;
    in property <bool> network: true;
    /// Whether the server starts when its user logs in to its computer, so the library is
    /// there without anyone starting it.
    in property <bool> start-at-login: true;
    /// Updating the server, for an admin: "" while unknown, "idle", "checking", "up-to-date",
    /// "available", "downloading", "installed" (the server restarts into it) or "failed"; the
    /// version available and the running one; 0 to 1 while downloading; why it failed; and
    /// whether the server installs it itself, or `install-update` opens its page here.
    in property <string> update-state;
    in property <string> update-version;
    in property <string> update-current;
    in property <float> update-progress;
    in property <string> update-error;
    in property <bool> update-can-install;

    /// The account this device is connected to: its user, whether they set a password (only then
    /// can they log in on other devices), and the devices connected to it.
    in property <string> user;
    /// The first letter of `user`, in upper case, for a button standing for the account.
    in property <string> user-initial;
    in property <bool> has-password;
    in property <[ServerDevice]> devices;
    /// While the page the password is set or changed on is open in the browser; what went wrong
    /// opening it.
    in property <bool> password-waiting;
    in property <string> password-error;

    /// While looking for servers on the network, and those found.
    in property <bool> finding;
    in property <[FoundServer]> found;

    /// While logging in to a server on another computer: shown, its address and certificate's
    /// fingerprint, whether Freya is asking it now, whether its login page is open in the
    /// browser, and what went wrong.
    in property <bool> logging-in;
    in property <string> login-address;
    /// What the server chosen is called: as it was found, as it was typed, or this computer's
    /// name for Freya Server on this computer.
    in property <string> login-name;
    in property <string> login-fingerprint;
    in property <bool> login-busy;
    in property <bool> login-waiting;
    in property <string> login-error;
    /// Whether the server chosen proved it knows the connection code its computer shows, or is
    /// the one this computer knew already: only then can it be logged in to.
    in property <bool> login-verified;
    /// On the server's computer: the connection code shown for a new device, "K7Q2M-9XD4T", and
    /// until when it works ("20:31"); "" when none is.
    in property <string> connection-code;
    in property <string> connection-code-until;
    /// Why no connection code could be shown, after `show-connection-code`; "" otherwise.
    in property <string> connection-code-error;
    /// What the code typed lets this device do once verified: "log-in" (the user logs in),
    /// "adopt" (the server is not adopted yet: the user chooses the owner's name and password)
    /// or "join" (the code is an invitation: the user `login-user` chooses their password).
    in property <string> login-kind: "log-in";
    in property <string> login-user;

    /// Whether the account is an admin's, who sees and invites the server's users.
    in property <bool> admin;
    /// The server's users, the owner first, for an admin.
    in property <[ServerUser]> users;
    /// The code a user was just invited with, "K7Q2M-9XD4T", whom it is for, and until when it
    /// works ("2026-10-30"); "" when none is shown. Why inviting failed; "" otherwise.
    in property <string> invite-code;
    in property <string> invite-for;
    in property <string> invite-until;
    in property <string> invite-error;

    /// Look for servers on the network.
    callback find();
    /// Log in to the `index`th server found, or to one at the address typed in
    /// ("mini.local", "192.168.1.20:47475").
    callback choose-found(int);
    callback choose-address(string);
    /// Check the connection code typed, which the server's computer shows, with the server
    /// chosen; `login-verified` turns on when it matches, `login-error` says why not.
    callback verify-code(string);
    /// On the server's computer: show a new connection code for a device to type.
    callback show-connection-code();
    /// Open the server's login page in the browser, where a password manager fills it in;
    /// Freya uses the server once the user logged in there.
    callback log-in();
    callback cancel-login();
    /// Log in to Freya Server on this computer, as to any server, without a code: adopting it
    /// first while nobody has (`logging-in` and the rest follow as for a server chosen).
    callback use-this-computer();
    /// Open the page the account's password is set or changed on in the browser.
    callback change-password();
    /// Take a device's token back: it has to log in again.
    callback revoke(string /* id */);
    /// Log this computer out of the server elsewhere: the server takes its token back, and no
    /// server is chosen until one is again.
    callback log-out();
    /// Invite a user named so, an admin or a listener, showing the code they join with; invite
    /// one again with a new code; take one away with their devices; stop showing the code.
    callback invite-user(string /* name */, bool /* admin */);
    callback invite-again(string /* name */);
    callback remove-user(string /* name */);
    callback hide-invite-code();
    callback set-network(bool);
    callback set-server-name(string);
    callback set-start-at-login(bool);
    /// Have the server look for an update now, or install the one available, for an admin.
    callback check-update();
    callback install-update();

    /// While choosing a music folder among the server's, from another computer: the folder
    /// shown ("" where to start: the home folder and the drives) and the folders in it.
    in property <bool> browsing;
    in property <string> browse-folder;
    in property <[string]> browse-folders;
    callback browse-start();
    /// Into the `index`th folder shown, or up to the one the folder shown is in.
    callback browse-into(int);
    callback browse-up();
    /// Adds the folder shown to `Library.folders-draft`, and stops browsing.
    callback browse-add();
    callback browse-cancel();
}

/// Updates to Freya. Optional: without it, Freya never looks for updates. Freya looks at
/// launch and once a day when `check-automatically` is on, and installs only when the user asks.
export global Updates {
    /// "idle", "checking" (only when the user asked), "up-to-date", "available",
    /// "downloading", "installed" (Freya restarts into it), or "failed".
    in property <string> state: "idle";
    /// The running Freya's version, and the newer one while one is available, downloading or
    /// installed.
    in property <string> current-version;
    in property <string> version;
    /// The new version's release notes, as plain text, bullets as "• ".
    in property <string> notes;
    /// 0 to 1 while downloading.
    in property <float> progress;
    /// Why looking for or installing an update failed.
    in property <string> error;
    /// Whether Freya can install the update itself. Otherwise, as for a Windows or .deb
    /// install, `install` opens the release's page.
    in property <bool> can-install;
    /// Whether Freya looks for updates on its own; kept between runs.
    in property <bool> check-automatically: true;

    /// Look for an update now; the answer shows in `state` either way, and a skipped version
    /// is offered again.
    callback check();
    /// Download, check and install the available update, then restart Freya into it.
    callback install();
    /// Hide the update until Freya looks again.
    callback later();
    /// Never offer this version again; a later one is offered.
    callback skip();
    callback set-check-automatically(bool);
}

/// Credits for Freya and Slint. Freya shows this in its own About window, so every skin
/// fulfils the licence requirement to credit Slint.
export component AboutFreya inherits Rectangle {
    in property <string> version;
    in property <color> text-color: #1a1a1a;

    VerticalLayout {
        padding: 24px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "Freya";
            font-size: 28px;
            font-weight: 700;
            color: root.text-color;
            horizontal-alignment: center;
        }
        Text {
            text: "Version " + root.version;
            font-size: 14px;
            color: root.text-color;
            horizontal-alignment: center;
        }
        Text {
            text: "A skinnable music player. Licensed under MIT or Apache-2.0.";
            font-size: 14px;
            color: root.text-color;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        AboutSlint {
            height: 160px;
        }
    }
}

/// Freya's standard keyboard shortcuts. Put one in the skin's window, filling it, so the
/// shortcuts work the same in every skin:
///
///     Space play/pause, ←/→ seek 5 s, ↑/↓ volume, M mute, N/P next/previous, S stop,
///     O open files, F1 about, F2 skins.
export component Shortcuts inherits FocusScope {
    key-pressed(event) => {
        if (event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
            return reject;
        }
        if (event.text == " ") {
            Player.toggle-pause();
        } else if (event.text == Key.RightArrow) {
            Player.seek-by(5);
        } else if (event.text == Key.LeftArrow) {
            Player.seek-by(-5);
        } else if (event.text == Key.UpArrow) {
            Player.set-volume(min(1.0, Player.volume + 0.05));
        } else if (event.text == Key.DownArrow) {
            Player.set-volume(max(0.0, Player.volume - 0.05));
        } else if (event.text == "m" || event.text == "M") {
            Player.toggle-mute();
        } else if (event.text == "n" || event.text == "N") {
            Player.next();
        } else if (event.text == "p" || event.text == "P") {
            Player.previous();
        } else if (event.text == "s" || event.text == "S") {
            Player.stop();
        } else if (event.text == "o" || event.text == "O") {
            Player.open-files();
        } else if (event.text == Key.F1) {
            App.show-about();
        } else if (event.text == Key.F2) {
            App.show-skins();
        } else {
            return reject;
        }
        accept
    }
}
