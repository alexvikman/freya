<?xml version="1.0" encoding="utf-8"?>
<!-- Freya Server asked to stop before the files are checked, so installing, upgrading or
     removing it never finds freya-server.exe in use: taskkill without /F closes its window, the
     one of its icon in the notification area, which stops it as logging out does. Through the
     WiX utility extension's quiet exec, which shows no console window; run as the user, whose
     server it is; nothing to stop is fine. Opened again, or at the next login, it starts. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="WixQuietExec64CmdLine"
              Value="&quot;[System64Folder]taskkill.exe&quot; /IM freya-server.exe"/>
    <CustomAction Id="StopFreyaServer" BinaryKey="WixCA" DllEntry="WixQuietExec64"
                  Execute="immediate" Return="ignore"/>
    <InstallExecuteSequence>
      <Custom Action="StopFreyaServer" Before="InstallValidate"/>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
