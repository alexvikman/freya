// The built-in Freya skin.
//
// Readability rules: system font, text at least 12 px, every text color at least 4.5:1
// contrast against the background it is drawn on (WCAG AA), light and dark mode follow the
// system.

import { Player, Playlist, Playlists, Equalizer, Visualizer, Library, Radio, App, Updates, LastFm, PlaybackState, Shortcuts, TrackRow, LibraryRow, AlbumPage, ArtistPage, ArtistDraft, PictureChoice, MatchChoice, AlbumMatchDraft, AlbumMatchChoice, ArtistMatchDraft, PlaylistRow, StationRow, NativeSpectrum, NativeOscilloscope, NativeHologram } from "@freya/v1.slint";
import { AboutSlint, ListView, Palette, ScrollView } from "std-widgets.slint";

// Every skin re-exports the API globals so the app can reach them.
export { Player, Playlist, Playlists, Equalizer, Visualizer, Library, Radio, App, Updates, LastFm } from "@freya/v1.slint";

/// Whether the visualizer fills the screen: everything else is hidden, and the skin turns dark,
/// as fits a TV.
global Stage {
    in-out property <bool> on;
}

global Theme {
    out property <bool> dark: Stage.on || App.theme == "dark" || (App.theme != "light" && Palette.color-scheme == ColorScheme.dark);
    out property <color> background: dark ? #15171a : #f6f7f9;
    out property <color> surface: dark ? #1f2226 : #ffffff;
    // Behind the navigation: text-secondary keeps 10:1 (dark) and 6.7:1 (light) on it.
    out property <color> sidebar: dark ? #111316 : #eceef2;
    out property <color> divider: dark ? #2b2f35 : #e1e4e9;
    out property <color> text: dark ? #f3f5f8 : #121418;
    // 9.6:1 on the dark background, 7.3:1 on the light one; 6:1 on the selection.
    out property <color> text-secondary: dark ? #b9c0ca : #4b5360;
    // 10:1 dark, 4.7:1 light.
    out property <color> accent: dark ? #ffb22e : #a35f00;
    // The accent for text; at least 5:1 on both the background and the selection.
    out property <color> accent-text: dark ? #ffc35c : #8a4f00;
    out property <color> on-accent: dark ? #1a1406 : #ffffff;
    out property <color> track: dark ? #353a41 : #d5d9df;
    out property <color> hover: dark ? #23272c : #eceef2;
    out property <color> pressed: dark ? #30353c : #dde1e6;
    out property <color> selection: dark ? #2c3b4f : #d6e4f5;
    // Error messages: 8:1 on the dark background, 6.3:1 on the light one.
    out property <color> danger: dark ? #ff8a80 : #b3261e;
}

// Icons are SVG path data in a 24×24 box, so they stay sharp at any size. Filled icons are
// drawn with `fill`, outlined ones (marked "stroked") with a 1.8 px stroke.
global Icons {
    out property <string> play: "M8 5 L19 12 L8 19 Z";
    out property <string> pause: "M6 5 H10 V19 H6 Z M14 5 H18 V19 H14 Z";
    out property <string> stop: "M6 6 H18 V18 H6 Z";
    out property <string> next: "M5 6 L14 12 L5 18 Z M16 6 H19 V18 H16 Z";
    out property <string> previous: "M19 6 L10 12 L19 18 Z M5 6 H8 V18 H5 Z";
    out property <string> speaker: "M4 9 H8 L13 5 V19 L8 15 H4 Z";
    out property <string> more: "M5 10.5 A1.5 1.5 0 1 0 5 13.5 A1.5 1.5 0 1 0 5 10.5 Z M12 10.5 A1.5 1.5 0 1 0 12 13.5 A1.5 1.5 0 1 0 12 10.5 Z M19 10.5 A1.5 1.5 0 1 0 19 13.5 A1.5 1.5 0 1 0 19 10.5 Z";
    // Stroked:
    out property <string> waves: "M16 9 C17.3 10.2 17.3 13.8 16 15 M18.5 6.5 C21.2 9 21.2 15 18.5 17.5";
    out property <string> shuffle: "M16 3 H21 V8 M4 20 L21 3 M21 16 V21 H16 M15 15 L21 21 M4 4 L9 9";
    out property <string> repeat: "M17 2 L21 6 L17 10 M3 12 V10 C3 7.8 4.8 6 7 6 H21 M7 22 L3 18 L7 14 M21 12 V14 C21 16.2 19.2 18 17 18 H3";
    out property <string> plus: "M12 5 V19 M5 12 H19";
    out property <string> folder: "M22 19 C22 20.1 21.1 21 20 21 H4 C2.9 21 2 20.1 2 19 V5 C2 3.9 2.9 3 4 3 H9 L11 6 H20 C21.1 6 22 6.9 22 8 Z";
    out property <string> folder-plus: "M22 19 C22 20.1 21.1 21 20 21 H4 C2.9 21 2 20.1 2 19 V5 C2 3.9 2.9 3 4 3 H9 L11 6 H20 C21.1 6 22 6.9 22 8 Z M12 10 V17 M8.5 13.5 H15.5";
    out property <string> trash: "M3 6 H21 M8 6 V4 C8 2.9 8.9 2 10 2 H14 C15.1 2 16 2.9 16 4 V6 M19 6 L18 20 C18 21.1 17.1 22 16 22 H8 C6.9 22 6 21.1 6 20 L5 6";
    out property <string> note: "M9 18 V5 L21 3 V16 M9 18 A3 3 0 1 1 3 18 A3 3 0 1 1 9 18 Z M21 16 A3 3 0 1 1 15 16 A3 3 0 1 1 21 16 Z";
    out property <string> sliders: "M4 21 V14 M4 10 V3 M12 21 V12 M12 8 V3 M20 21 V16 M20 12 V3 M1 14 H7 M9 8 H15 M17 16 H23";
    out property <string> check: "M5 12.5 L10 17.5 L19 7";
    out property <string> back: "M15 5 L8 12 L15 19";
    out property <string> chevron: "M9 5 L16 12 L9 19";
    // Filled, for 16 pixels: every edge falls on a whole pixel (1.5 units each), so they stay
    // sharp where an outline at that size blurs.
    out property <string> grid: "M1.5 1.5 H10.5 V10.5 H1.5 Z M13.5 1.5 H22.5 V10.5 H13.5 Z M1.5 13.5 H10.5 V22.5 H1.5 Z M13.5 13.5 H22.5 V22.5 H13.5 Z";
    out property <string> list: "M1.5 4.5 H4.5 V7.5 H1.5 Z M7.5 4.5 H22.5 V7.5 H7.5 Z M1.5 10.5 H4.5 V13.5 H1.5 Z M7.5 10.5 H22.5 V13.5 H7.5 Z M1.5 16.5 H4.5 V19.5 H1.5 Z M7.5 16.5 H22.5 V19.5 H7.5 Z";
    out property <string> search: "M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 Z M15.5 15.5 L20 20";
    out property <string> close: "M6 6 L18 18 M18 6 L6 18";
    out property <string> sidebar: "M4 4 H20 C21.1 4 22 4.9 22 6 V18 C22 19.1 21.1 20 20 20 H4 C2.9 20 2 19.1 2 18 V6 C2 4.9 2.9 4 4 4 Z M9 4 V20";
    out property <string> artist: "M12 12 A4.5 4.5 0 1 0 12 3 A4.5 4.5 0 1 0 12 12 Z M3.5 21 C3.5 16.6 7.3 14.5 12 14.5 C16.7 14.5 20.5 16.6 20.5 21";
    out property <string> queue: "M9 6 H21 M9 12 H21 M9 18 H21 M4 6 H4.1 M4 12 H4.1 M4 18 H4.1";
    out property <string> spectrum: "M4 20 V14 M9 20 V7 M14 20 V11 M19 20 V4";
    out property <string> album: "M4 3 H20 C20.6 3 21 3.4 21 4 V20 C21 20.6 20.6 21 20 21 H4 C3.4 21 3 20.6 3 20 V4 C3 3.4 3.4 3 4 3 Z M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5 Z";
    out property <string> playlist: "M3 6 H15 M3 11 H15 M3 16 H10 M19 16.5 V5 L22 4 M19 16.5 A2.5 2.5 0 1 1 14 16.5 A2.5 2.5 0 1 1 19 16.5 Z";
    out property <string> radio: "M12 11.9 V12.1 M8.5 8.5 C6.6 10.4 6.6 13.6 8.5 15.5 M15.5 8.5 C17.4 10.4 17.4 13.6 15.5 15.5 M5.6 5.6 C2.1 9.1 2.1 14.9 5.6 18.4 M18.4 5.6 C21.9 9.1 21.9 14.9 18.4 18.4";
    out property <string> added: "M12 3 V15 M7 10 L12 15 L17 10 M4 15 V19 C4 20.1 4.9 21 6 21 H18 C19.1 21 20 20.1 20 19 V15";
    out property <string> clock: "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V12 L15.5 14";
    out property <string> star: "M12 3 L14.8 8.8 L21 9.6 L16.5 14 L17.6 20.3 L12 17.3 L6.4 20.3 L7.5 14 L3 9.6 L9.2 8.8 Z";
    out property <string> genre: "M3 4 V11 L13 21 L21 13 L11 3 H4 C3.4 3 3 3.4 3 4 Z M7.5 7.5 H7.6";
    out property <string> expand: "M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15";
    out property <string> picture: "M3.5 5 H20.5 V19 H3.5 Z M3.5 16 L8.5 11 L12.5 15 L15 12.5 L20.5 18 M15.5 7.5 A1.5 1.5 0 1 0 15.5 10.5 A1.5 1.5 0 1 0 15.5 7.5 Z";
    out property <string> pencil: "M4 20 H8 L19.5 8.5 L15.5 4.5 L4 16 Z M13.5 6.5 L17.5 10.5";
    // A pulse in a ring: what Freya is doing.
    out property <string> activity: "M12 2.5 A9.5 9.5 0 1 0 12 21.5 A9.5 9.5 0 1 0 12 2.5 Z M6.5 12 H9 L10.75 8.5 L13.25 15.5 L15 12 H17.5";
    out property <string> external: "M7 17 L17 7 M9 7 H17 V15";
    out property <string> code: "M8 6 L2 12 L8 18 M16 6 L22 12 L16 18";
    out property <string> document: "M6 3 H14 L19 8 V21 H6 Z M14 3 V8 H19 M9 13 H16 M9 17 H16";
    out property <string> bubble: "M4 5 H20 V16 H11 L6 20 V16 H4 Z";
    out property <string> shrink: "M9 4 V9 H4 M20 9 H15 V4 M15 20 V15 H20 M4 15 H9 V20";
}

/// A vector icon. Fills the given size; `stroked` draws outlines instead of filled shapes.
component Icon inherits Path {
    in property <string> data;
    in property <color> color: Theme.text;
    in property <bool> stroked;

    viewbox-width: 24;
    viewbox-height: 24;
    commands: data;
    fill: stroked ? transparent : color;
    stroke: stroked ? color : transparent;
    stroke-width: stroked ? 1.8px : 0;
}

/// Text that opens something when clicked, underlined while the pointer is on it. Plain text
/// while it is not `enabled`.
component LinkText inherits Text {
    in property <bool> enabled: true;
    /// Read by screen readers, for what a click does.
    in property <string> label;
    callback clicked;

    overflow: elide;
    accessible-role: AccessibleRole.text;
    accessible-label: root.enabled ? root.label : root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    if root.enabled && touch.has-hover: Rectangle {
        x: 0;
        y: root.height - 2px;
        width: min(root.width, root.preferred-width);
        height: 1px;
        background: root.color;
    }
}

/// The box shown when the pointer rests on a control.
component TooltipBox inherits Rectangle {
    in property <string> text;

    // In the dark, set apart by a lighter fill: a thin rounded edge is drawn with light
    // corners there.
    background: Theme.dark ? #2d3137 : Theme.surface;
    border-radius: 6px;
    border-width: Theme.dark ? 0 : 1px;
    border-color: Theme.divider;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.dark ? #00000066 : #00000030;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;

        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text;
        }
    }
}

/// A round icon button. It fills the height of its layout row and centers itself in it.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> stroked;
    /// Read by screen readers.
    in property <string> label;
    /// Shown when the pointer rests on the button, so icons need no guessing.
    in property <string> tooltip: label;
    in property <length> size: 40px;
    /// The main action: filled with the accent color.
    in property <bool> primary;
    /// For on/off buttons: drawn in the accent color while on.
    in property <bool> checkable;
    in property <bool> checked;
    /// Faint and without effect when false.
    in property <bool> enabled: true;
    callback clicked;

    width: size;
    min-height: size;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-label: label;
    accessible-checkable: checkable;
    accessible-checked: checked;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: root.primary
            ? (touch.pressed ? Theme.accent.darker(15%) : Theme.accent)
            : !root.enabled ? transparent
            : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent));

        Icon {
            width: root.size * (root.primary ? 0.5 : 0.55);
            height: self.width;
            data: root.icon;
            stroked: root.stroked;
            color: root.primary ? Theme.on-accent : (root.checked ? Theme.accent-text : Theme.text);
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }

    Tooltip {
        TooltipBox { text: root.tooltip; }
    }
}

/// A horizontal slider. Reports `changed` while dragging (or on release when not `live`); the
/// shown value follows the mouse until the app updates `value`.
component Slider inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <string> label;
    in property <bool> live: true;
    callback changed(float);

    property <float> drag-value;
    /// Released, not `live`: the value let go of is shown until the app's `value` reaches it,
    /// rather than the old value for a moment.
    property <bool> settling;
    property <float> shown: touch.pressed || settling ? drag-value : value;

    changed value => {
        if (abs(root.value - root.drag-value) < 0.01) {
            root.settling = false;
        }
    }
    // In case the app never gets there, e.g. a seek that failed.
    Timer {
        interval: 1s;
        running: root.settling;
        triggered => { root.settling = false; }
    }
    property <length> knob: 14px;

    height: 24px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: round(value * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;

        Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.shown));
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.track;
        }
    }

    Rectangle {
        visible: root.enabled && (touch.has-hover || touch.pressed);
        width: root.knob;
        height: root.knob;
        x: parent.width * max(0, min(1, root.shown)) - root.knob / 2;
        border-radius: root.knob / 2;
        background: Theme.accent;
    }

    function at(x: length) -> float {
        max(0, min(1, x / self.width))
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.drag-value = root.at(self.mouse-x);
                if (root.live) {
                    root.changed(root.drag-value);
                }
            } else if (event.kind == PointerEventKind.up && !root.live) {
                root.settling = true;
                root.changed(root.drag-value);
            }
        }
        moved => {
            root.drag-value = root.at(self.mouse-x);
            if (root.live) {
                root.changed(root.drag-value);
            }
        }
    }
}

/// The bar along the bottom: what plays, the transport and position, the volume, and the
/// buttons for the visualizer and equalizer views.
component PlayerBar inherits Rectangle {
    /// The view shown, so its button can show as on.
    in property <string> view;
    /// Show `view`, or go back from it when it is already shown.
    callback toggle-view(string);
    /// Fill the screen with the visualizer.
    callback full-screen();

    /// The cover opens the track's album; for a track outside the library, the visualizer.
    function open-cover() {
        if (Library.playing-known) {
            Library.open-playing-album();
        } else {
            root.toggle-view("visualizer");
        }
    }

    height: 88px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 20px;

        // What plays. Same preferred width and stretch as the volume side, so the transport
        // stays in the middle.
        HorizontalLayout {
            min-width: 160px;
            preferred-width: 240px;
            horizontal-stretch: 1;
            spacing: 12px;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 56px;
                    height: 56px;
                    border-radius: 6px;
                    clip: true;
                    background: Theme.background;
                    accessible-role: button;
                    accessible-label: Library.playing-known ? "Show the album" : "Show the visualizer";
                    accessible-action-default => { root.open-cover(); }

                    if Player.has-cover: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Player.cover;
                        image-fit: cover;
                    }
                    if !Player.has-cover: Icon {
                        width: 28px;
                        height: 28px;
                        data: Icons.note;
                        stroked: true;
                        color: Theme.text-secondary;
                    }

                    TouchArea {
                        mouse-cursor: Library.playing-known ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.open-cover(); }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                min-width: 0;

                // The track's album, and its artist, open in the library.
                LinkText {
                    text: Player.title == "" ? "Nothing playing" : Player.title;
                    font-size: 15px;
                    font-weight: Player.title == "" ? 400 : 600;
                    color: Player.title == "" ? Theme.text-secondary : Theme.text;
                    enabled: Library.playing-known && Player.title != "";
                    label: "Show " + Player.title + " in its album";
                    clicked => { Library.open-playing-album(); }
                }
                if Player.artist != "": LinkText {
                    text: Player.artist;
                    font-size: 13px;
                    color: Theme.text-secondary;
                    enabled: Library.playing-known;
                    label: "Show " + Player.artist;
                    clicked => { Library.open-playing-artist(); }
                }
                // Kept while a track is loaded, even when empty, so the title does not jump
                // when playback starts.
                if Player.title != "" || Player.error != "": Text {
                    text: Player.error != "" ? Player.error : Player.format-info;
                    font-size: 12px;
                    color: Player.error != "" ? Theme.danger : Theme.text-secondary;
                    overflow: elide;
                }
            }
        }

        // Transport and position.
        VerticalLayout {
            min-width: 300px;
            preferred-width: 520px;
            horizontal-stretch: 2;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                IconButton {
                    icon: Icons.shuffle;
                    stroked: true;
                    size: 34px;
                    label: "Shuffle";
                    tooltip: Playlist.shuffle ? "Shuffle: on" : "Shuffle: off";
                    checkable: true;
                    checked: Playlist.shuffle;
                    clicked => { Playlist.toggle-shuffle(); }
                }
                IconButton {
                    icon: Icons.previous;
                    size: 36px;
                    label: "Previous";
                    tooltip: "Previous track (P)";
                    clicked => { Player.previous(); }
                }
                IconButton {
                    size: 44px;
                    primary: true;
                    icon: Player.state == PlaybackState.playing ? Icons.pause : Icons.play;
                    label: Player.state == PlaybackState.playing ? "Pause" : "Play";
                    tooltip: self.label + " (Space)";
                    clicked => { Player.toggle-pause(); }
                }
                IconButton {
                    icon: Icons.stop;
                    size: 36px;
                    label: "Stop";
                    tooltip: "Stop (S)";
                    clicked => { Player.stop(); }
                }
                IconButton {
                    icon: Icons.next;
                    size: 36px;
                    label: "Next";
                    tooltip: "Next track (N)";
                    clicked => { Player.next(); }
                }
                IconButton {
                    icon: Icons.repeat;
                    stroked: true;
                    size: 34px;
                    label: "Repeat";
                    tooltip: Playlist.repeat ? "Repeat the playlist: on" : "Repeat the playlist: off";
                    checkable: true;
                    checked: Playlist.repeat;
                    clicked => { Playlist.toggle-repeat(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;

                // The times are drawn over these, outside the layout (see below).
                position-slot := Rectangle { width: 48px; }
                Slider {
                    horizontal-stretch: 1;
                    label: "Position";
                    value: Player.length > 0 ? Player.position / Player.length : 0;
                    enabled: Player.state != PlaybackState.stopped && Player.length > 0;
                    live: false;
                    changed(fraction) => { Player.seek(fraction); }
                }
                remaining-slot := Rectangle { width: 48px; }
            }
        }

        // Volume and the views that belong to the sound.
        HorizontalLayout {
            min-width: 160px;
            preferred-width: 240px;
            horizontal-stretch: 1;
            alignment: end;
            spacing: 6px;

            Rectangle {
                width: 24px;

                Icon {
                    width: 20px;
                    height: 20px;
                    data: Icons.speaker;
                    color: Theme.text-secondary;
                }
                Icon {
                    width: 20px;
                    height: 20px;
                    data: Icons.waves;
                    stroked: true;
                    color: Theme.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;

                Slider {
                    min-width: 60px;
                    preferred-width: 100px;
                    label: "Volume";
                    value: Player.volume;
                    changed(v) => { Player.set-volume(v); }

                    Tooltip {
                        TooltipBox { text: "Volume (Up and Down arrows)"; }
                    }
                }
            }
            Rectangle { width: 4px; }
            IconButton {
                icon: Icons.spectrum;
                stroked: true;
                size: 36px;
                label: "Visualizer";
                tooltip: root.view == "visualizer" ? "Leave the visualizer" : "Show the visualizer";
                checkable: true;
                checked: root.view == "visualizer";
                clicked => { root.toggle-view("visualizer"); }
            }
            IconButton {
                icon: Icons.sliders;
                stroked: true;
                size: 36px;
                label: "Equalizer";
                tooltip: root.view == "equalizer" ? "Leave the equalizer" : "Show the equalizer";
                checkable: true;
                checked: root.view == "equalizer";
                clicked => { root.toggle-view("equalizer"); }
            }
            IconButton {
                icon: Icons.expand;
                stroked: true;
                size: 36px;
                label: "Full screen";
                tooltip: "Show the visualizer full screen (F)";
                clicked => { root.full-screen(); }
            }
        }
    }

    // The times change every second. Inside the layout, each change would lay out the whole
    // window again and redraw everything whose place depends on it, such as the lists' scroll
    // bars; placed over their slots, they redraw only themselves.
    Text {
        x: position-slot.absolute-position.x - root.absolute-position.x;
        y: position-slot.absolute-position.y - root.absolute-position.y;
        width: position-slot.width;
        height: position-slot.height;
        text: Player.position-text;
        font-size: 12px;
        color: Theme.text-secondary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        x: remaining-slot.absolute-position.x - root.absolute-position.x;
        y: remaining-slot.absolute-position.y - root.absolute-position.y;
        width: remaining-slot.width;
        height: remaining-slot.height;
        text: Player.length > 0 ? Player.remaining-text : (Player.live ? "Live" : "");
        font-size: 12px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    /// Shows a check mark, for choices.
    in property <bool> checked;
    callback activated;

    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.activated(); }

    accessible-checkable: checked;
    accessible-checked: checked;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 10px;
        spacing: 6px;

        Rectangle {
            width: 18px;

            if root.checked: Icon {
                width: 16px;
                height: 16px;
                data: Icons.check;
                stroked: true;
                color: Theme.text;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            // A long name, like a folder's, is cut short inside the menu.
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

/// One thing Freya is doing, in the activity menu: what, where, and a dot while it goes on.
component ActivityRow inherits HorizontalLayout {
    in property <string> text;
    in property <string> detail;
    in property <bool> busy;

    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 8px;
    spacing: 10px;
    accessible-role: AccessibleRole.text;
    accessible-label: detail == "" ? text : text + ", " + detail;

    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0;
        spacing: 2px;

        Text {
            text: root.text;
            font-size: 13px;
            color: Theme.text;
            overflow: elide;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 12px;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }
    if root.busy: VerticalLayout {
        alignment: center;

        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.accent;
        }
    }
}

/// A rounded text button.
component TextButton inherits Rectangle {
    in property <string> text;
    /// The button that does what the form is for.
    in property <bool> primary;
    callback clicked;

    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 6px;
    border-width: primary ? 0 : 1px;
    border-color: Theme.divider;
    background: primary ? (touch.pressed ? Theme.accent.darker(20%) : Theme.accent)
        : touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        color: root.primary ? Theme.on-accent : Theme.text;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// An on/off switch.
component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled;

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.track;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.on-accent : Theme.surface;

        animate x { duration: 120ms; }
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

/// The surface of pop-up menus.
/// A heading over a group of menu items, like "Sort by".
component MenuHeading inherits HorizontalLayout {
    in property <string> text;

    padding-left: 12px;
    height: 28px;

    Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

component MenuSurface inherits Rectangle {
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.divider;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000040;
}

/// Gain in dB to a position in a slider track: +12 dB at 5 %, 0 dB at 50 %, -12 dB at 95 %,
/// matching the curve's coordinates in the skin API.
global Gain {
    pure public function to-fraction(db: float) -> float {
        0.5 - db / 12 * 0.45
    }
    pure public function from-fraction(fraction: float) -> float {
        max(-12, min(12, (0.5 - fraction) / 0.45 * 12))
    }
    pure public function text(db: float) -> string {
        (db > 0 ? "+" : "") + round(db * 10) / 10 + " dB"
    }
}

/// One vertical gain slider's track, fill and knob, without input handling.
component GainTrack inherits Rectangle {
    in property <float> gain;
    in property <bool> active;
    in property <bool> enabled;

    property <float> fraction: Gain.to-fraction(gain);

    // Track
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 4px;
        border-radius: 2px;
        background: Theme.track;
    }
    // Fill from 0 dB to the gain
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 4px;
        y: parent.height * min(0.5, root.fraction);
        height: parent.height * abs(root.fraction - 0.5);
        background: root.enabled ? Theme.accent : Theme.text-secondary;
    }
    // Knob
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.fraction - self.height / 2;
        width: root.active ? 16px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.enabled ? Theme.accent : Theme.text-secondary;
    }
}

/// The equalizer view: on/off, presets, and the preamp and ten bands with their curve.
component EqualizerView inherits VerticalLayout {
    padding: 24px;
    spacing: 16px;
    alignment: start;

    /// Band being changed, or -1; 10 is the preamp.
    property <int> active: -1;
    property <length> label-height: 20px;

    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            Toggle {
                label: "Equalizer on";
                checked: Equalizer.enabled;
                toggled => { Equalizer.toggle(); }
            }
        }
        VerticalLayout {
            alignment: center;

            Text {
                text: root.active == 10
                    ? "Preamp: " + Gain.text(Equalizer.preamp)
                    : root.active >= 0
                        ? Equalizer.band-labels[root.active] + " Hz: " + Gain.text(Equalizer.bands[root.active])
                        : Equalizer.preset-name;
                font-size: 13px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        presets-button := TextButton {
            text: "Presets";
            clicked => { presets.show(); }
        }
        TextButton {
            text: "Reset";
            clicked => { Equalizer.reset(); }
        }
        files-button := IconButton {
            icon: Icons.more;
            size: 30px;
            label: "Equalizer files";
            tooltip: "Load or save a preset file";
            clicked => { files.show(); }
        }
    }

    HorizontalLayout {
        height: 280px;
        spacing: 0;

        // Preamp
        VerticalLayout {
            width: 44px;

            preamp-track := GainTrack {
                gain: Equalizer.preamp;
                enabled: Equalizer.enabled;
                active: root.active == 10;
                accessible-role: slider;
                accessible-label: "Preamp";
                accessible-value: Gain.text(Equalizer.preamp);
                accessible-action-increment => { Equalizer.set-preamp(Equalizer.preamp + 1); }
                accessible-action-decrement => { Equalizer.set-preamp(Equalizer.preamp - 1); }

                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.active = 10;
                            Equalizer.set-preamp(Gain.from-fraction(self.mouse-y / self.height));
                        } else if (event.kind == PointerEventKind.up) {
                            root.active = -1;
                        }
                    }
                    moved => { Equalizer.set-preamp(Gain.from-fraction(self.mouse-y / self.height)); }
                    double-clicked => { Equalizer.set-preamp(0); }
                }
            }
            Text {
                height: root.label-height;
                text: "Pre";
                font-size: 12px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: bottom;
            }
        }

        Rectangle {
            width: 13px;

            Rectangle {
                width: 1px;
                height: parent.height - root.label-height;
                y: 0;
                background: Theme.divider;
            }
        }

        // Bands, with the response curve behind them. One touch area covers them all, so a
        // drag across several bands sets each one, like in Winamp.
        bands := Rectangle {
            horizontal-stretch: 1;

            property <length> band-width: self.width / 10;
            property <length> track-height: self.height - root.label-height;

            Rectangle {
                x: bands.band-width / 2;
                y: 0;
                width: bands.width - bands.band-width;
                height: bands.track-height;

                // 0 dB line
                Rectangle {
                    y: parent.height / 2;
                    height: 1px;
                    background: Theme.divider;
                }
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: Equalizer.curve(self.width / 1px, self.height / 1px, Equalizer.bands);
                    stroke: Equalizer.enabled ? Theme.accent.with-alpha(0.45) : Theme.text-secondary.with-alpha(0.35);
                    stroke-width: 2px;
                    fill: transparent;
                }
            }

            for gain[i] in Equalizer.bands: VerticalLayout {
                x: i * bands.band-width;
                y: 0;
                width: bands.band-width;
                height: bands.height;

                GainTrack {
                    gain: gain;
                    enabled: Equalizer.enabled;
                    active: root.active == i;
                    accessible-role: slider;
                    accessible-label: Equalizer.band-labels[i] + " Hz";
                    accessible-value: Gain.text(gain);
                    accessible-action-increment => { Equalizer.set-band(i, gain + 1); }
                    accessible-action-decrement => { Equalizer.set-band(i, gain - 1); }
                }
                Text {
                    height: root.label-height;
                    text: Equalizer.band-labels[i];
                    font-size: 12px;
                    color: root.active == i ? Theme.text : Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: bottom;
                }
            }

            function band-at(x: length) -> int {
                max(0, min(9, floor(x / bands.band-width)))
            }
            function set-at(x: length, y: length) {
                root.active = bands.band-at(x);
                Equalizer.set-band(root.active, Gain.from-fraction(y / bands.track-height));
            }

            TouchArea {
                height: bands.track-height;
                y: 0;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        bands.set-at(self.mouse-x, self.mouse-y);
                    } else if (event.kind == PointerEventKind.up) {
                        root.active = -1;
                    }
                }
                moved => { bands.set-at(self.mouse-x, self.mouse-y); }
                double-clicked => { Equalizer.set-band(bands.band-at(self.mouse-x), 0); }
            }
        }
    }

    presets := PopupWindow {
        x: presets-button.x;
        y: presets-button.y + presets-button.height;
        width: 240px;
        height: 320px;

        MenuSurface {
            ListView {
                for name[i] in Equalizer.presets: MenuItem {
                    text: name;
                    checked: name == Equalizer.preset-name;
                    activated => {
                        Equalizer.load-preset(i);
                        presets.close();
                    }
                }
            }
        }
    }

    files := PopupWindow {
        x: files-button.x + files-button.width - 220px;
        y: files-button.y + files-button.height;
        width: 220px;

        MenuSurface {
            VerticalLayout {
                padding: 6px;

                MenuItem {
                    text: "Load preset file (.eqf)…";
                    activated => { Equalizer.load-file(); }
                }
                MenuItem {
                    text: "Save preset file (.eqf)…";
                    activated => { Equalizer.save-file(); }
                }
            }
        }
    }
}

component MenuDivider inherits Rectangle {
    height: 9px;

    Rectangle {
        height: 1px;
        background: Theme.divider;
    }
}

/// Asks for the address of a radio stream to play.
component StreamUrlForm inherits MenuSurface {
    callback done();

    function play() {
        Playlist.add-url(input.text);
        input.text = "";
        root.done();
    }

    init => { input.focus(); }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        Text {
            text: "Play a stream";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }
        Text {
            text: "The address of an internet radio stream, or of a station's .pls or .m3u file.";
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        Rectangle {
            height: 34px;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.divider;
            background: Theme.background;

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                single-line: true;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: "Stream address";
                accepted => { root.play(); }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            TextButton {
                text: "Cancel";
                clicked => { root.done(); }
            }
            TextButton {
                text: "Play";
                clicked => { root.play(); }
            }
        }
    }
}

component TrackRowView inherits Rectangle {
    in property <TrackRow> entry;
    in property <int> index;
    in property <int> count;
    /// Row the dragged tracks would land before, or -1.
    in property <int> drop-index;
    callback drag-over(int);
    callback drop();
    callback pressed();
    /// A right-click, at this point in the window.
    callback context-menu(length, length);

    property <bool> dragging;
    property <bool> was-selected;

    background: entry.selected ? Theme.selection : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: list-item;
    accessible-label: entry.title + (entry.duration == "" ? "" : ", " + entry.duration);
    accessible-action-default => { Playlist.activate(root.index); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 20px;
        spacing: 10px;

        Rectangle {
            width: 36px;

            if !entry.current: Text {
                width: parent.width;
                height: parent.height;
                text: entry.number;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if entry.current: Icon {
                x: parent.width - 14px;
                width: 12px;
                height: 12px;
                data: Icons.play;
                color: Theme.accent-text;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: entry.title;
            color: entry.current ? Theme.accent-text : Theme.text;
            font-weight: entry.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: entry.duration;
            font-size: 13px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    // Where dragged rows would be dropped.
    if root.drop-index == root.index: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.accent;
    }
    if root.drop-index == root.count && root.index == root.count - 1: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.accent;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                // The menu acts on the selection, so a row outside it becomes the selection.
                if (!root.entry.selected) {
                    Playlist.select(root.index, false, false);
                }
                root.context-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                return;
            }
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.pressed();
                root.dragging = false;
                root.was-selected = root.entry.selected;
                if (event.modifiers.shift) {
                    Playlist.select(root.index, true, false);
                } else if (event.modifiers.control || event.modifiers.meta) {
                    Playlist.select(root.index, false, true);
                } else if (!root.entry.selected) {
                    Playlist.select(root.index, false, false);
                }
            } else if (event.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.drop();
                } else if (root.was-selected && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.meta) {
                    // A plain click inside a multi-selection narrows it to this row.
                    Playlist.select(root.index, false, false);
                }
                root.dragging = false;
            }
        }
        moved => {
            if (abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragging = true;
            }
            if (root.dragging) {
                root.drag-over(root.index + floor(self.mouse-y / root.height + 0.5));
            }
        }
        double-clicked => { Playlist.activate(root.index); }
    }
}

component TrackList inherits FocusScope {
    /// The view this is the list of, for back and forward: it says how far it is scrolled
    /// while shown, and scrolls back there. Empty for a list beside another view.
    in property <string> place;
    property <bool> shown: place != "" && App.view == place;
    property <int> restores: App.restores;
    changed shown => {
        if (root.shown) {
            App.scroll = -list.content-y;
        }
    }
    changed restores => {
        if (root.place != "" && App.restore-view == root.place) {
            list.content-y = -App.restore-scroll;
        }
    }

    property <length> row-height: 34px;
    // Where a right-click opened the menu, in this component.
    property <length> menu-x;
    property <length> menu-y;
    property <int> drop-index: -1;
    property <int> cursor: Playlist.cursor;
    property <int> page: max(1, floor(list.visible-height / root.row-height) - 1);

    changed cursor => { root.reveal(root.cursor); }

    /// Scrolls just enough to show `row`.
    function reveal(row: int) {
        // Before the first layout the list has no height, and every row would look hidden.
        if (row < 0 || list.visible-height <= 0) {
            return;
        }
        if (row * root.row-height < -list.content-y) {
            list.content-y = -row * root.row-height;
        } else if ((row + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((row + 1) * root.row-height - list.visible-height);
        }
    }

    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            Playlist.move-cursor(-1, event.modifiers.shift);
        } else if (event.text == Key.DownArrow) {
            Playlist.move-cursor(1, event.modifiers.shift);
        } else if (event.text == Key.PageUp) {
            Playlist.move-cursor(-root.page, event.modifiers.shift);
        } else if (event.text == Key.PageDown) {
            Playlist.move-cursor(root.page, event.modifiers.shift);
        } else if (event.text == Key.Home) {
            Playlist.move-cursor(-Playlist.rows.length, event.modifiers.shift);
        } else if (event.text == Key.End) {
            Playlist.move-cursor(Playlist.rows.length, event.modifiers.shift);
        } else if (event.text == Key.Return) {
            if (Playlist.cursor >= 0) {
                Playlist.activate(Playlist.cursor);
            }
        } else if (event.text == Key.Delete || event.text == Key.Backspace) {
            Playlist.remove-selected();
        } else if (event.text == Key.Escape && !Stage.on) {
            Playlist.clear-selection();
        } else if ((event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A")) {
            Playlist.select-all();
        } else {
            return reject;
        }
        accept
    }

    list := ListView {
        changed content-y => {
            if (root.shown) {
                App.scroll = -self.content-y;
            }
        }

        for track[i] in Playlist.rows: TrackRowView {
            height: root.row-height;
            entry: track;
            index: i;
            count: Playlist.rows.length;
            drop-index: root.drop-index;
            pressed => { root.focus(); }
            drag-over(target) => {
                root.drop-index = max(0, min(Playlist.rows.length, target));
            }
            drop => {
                Playlist.move-selected(root.drop-index);
                root.drop-index = -1;
            }
            context-menu(x, y) => {
                root.menu-x = x - root.absolute-position.x;
                root.menu-y = y - root.absolute-position.y;
                row-menu.show();
            }
        }
    }

    row-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 260px;

        MenuSurface {
            VerticalLayout {
                padding: 6px;

                for playlist[i] in Playlists.playlists: MenuItem {
                    text: "Add to " + playlist.name;
                    activated => { Playlists.add-queue-selection(i); }
                }
                if Playlists.playlists.length > 0: MenuDivider { }
                MenuItem {
                    text: "Remove from Up Next";
                    activated => { Playlist.remove-selected(); }
                }
            }
        }
    }

    if Playlist.rows.length == 0: VerticalLayout {
        alignment: center;
        spacing: 6px;

        Text {
            text: "Up Next is empty";
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "Drop music files or folders here, or press O.";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }
}

/// The search field in the toolbar; it searches the library.
component SearchField inherits Rectangle {
    callback edited;
    callback accepted;
    forward-focus: input;

    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.divider;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        Icon {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            data: Icons.search;
            stroked: true;
            color: Theme.text-secondary;
        }
        Rectangle {
            horizontal-stretch: 1;

            if Library.query == "": Text {
                width: 100%;
                text: "Search the library";
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                text <=> Library.query;
                single-line: true;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: "Search the library";
                edited => {
                    Library.search(self.text);
                    root.edited();
                }
                accepted => { root.accepted(); }
            }
        }
        if Library.query != "": IconButton {
            icon: Icons.close;
            stroked: true;
            size: 26px;
            label: "Clear search";
            clicked => {
                Library.search("");
                input.focus();
            }
        }
    }
}

component LibraryRowView inherits Rectangle {
    in property <LibraryRow> entry;
    in property <int> index;
    in property <bool> cursor;
    /// The track playing, or paused: in the accent color, with bars for its number.
    in property <bool> playing;
    callback pressed();
    /// A right-click, at this point in the window.
    callback context-menu(length, length);
    /// Open an artist or album, or play a track.
    callback activated();

    background: cursor ? Theme.selection : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: list-item;
    accessible-label: entry.title + (entry.detail == "" ? "" : ", " + entry.detail) + (entry.duration == "" ? "" : ", " + entry.duration);
    accessible-action-default => { root.activated(); }

    // Below the buttons, so they get their own clicks.
    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.pressed();
                root.context-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.pressed();
            // Artists and albums open with one click; tracks play with a double-click.
            if (root.entry.kind != "track") {
                root.activated();
            }
        }
        double-clicked => {
            if (root.entry.kind == "track") {
                root.activated();
            }
        }
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 10px;

        if entry.number != "" || root.playing: Rectangle {
            width: 30px;

            if !root.playing: Text {
                width: parent.width;
                height: parent.height;
                text: root.entry.number;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if root.playing: Icon {
                x: parent.width - self.width;
                width: 16px;
                height: 16px;
                data: Icons.spectrum;
                stroked: true;
                color: Theme.accent;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: entry.title;
                color: root.playing ? Theme.accent : Theme.text;
                font-weight: entry.kind == "track" ? 400 : 600;
                overflow: elide;
            }
            if entry.detail != "": Text {
                text: entry.detail;
                font-size: 12px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        if entry.duration != "": Text {
            text: entry.duration;
            font-size: 13px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.plus;
            stroked: true;
            size: 30px;
            label: "Add to Up Next";
            clicked => { Library.enqueue(root.index); }
        }
        // Empty for tracks, so the add buttons line up.
        Rectangle {
            width: 16px;

            if entry.kind != "track": Icon {
                width: 16px;
                height: 16px;
                data: Icons.chevron;
                stroked: true;
                color: Theme.text-secondary;
            }
        }
    }
}

/// A track in a table of tracks from many albums: title, artist, album and time in columns,
/// and when or how often it was played in the Recents.
component TrackTableRow inherits Rectangle {
    in property <LibraryRow> entry;
    in property <int> index;
    in property <bool> cursor;
    in property <bool> played-column;
    /// The track playing, or paused: in the accent color.
    in property <bool> playing;
    callback pressed();
    /// A right-click, at this point in the window.
    callback context-menu(length, length);
    callback activated();

    background: cursor ? Theme.selection : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: list-item;
    accessible-label: entry.title + (entry.artist == "" ? "" : ", " + entry.artist) + (entry.duration == "" ? "" : ", " + entry.duration);
    accessible-action-default => { root.activated(); }

    // Below the button, so it gets its own clicks.
    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.pressed();
                root.context-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.pressed(); }
        double-clicked => { root.activated(); }
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 12px;
        spacing: 16px;

        // Columns share the width in proportion, whatever their text.
        Text {
            min-width: 0;
            preferred-width: 0;
            horizontal-stretch: 3;
            text: entry.title;
            color: root.playing ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            min-width: 0;
            preferred-width: 0;
            horizontal-stretch: 2;
            text: entry.artist;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            min-width: 0;
            preferred-width: 0;
            horizontal-stretch: 2;
            text: entry.album;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.played-column: Text {
            width: 104px;
            text: entry.played;
            font-size: 13px;
            color: Theme.text-secondary;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 48px;
            text: entry.duration;
            font-size: 13px;
            color: Theme.text-secondary;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.plus;
            stroked: true;
            size: 30px;
            label: "Add to Up Next";
            clicked => { Library.enqueue(root.index); }
        }
    }
}

/// Column names above a table of tracks; laid out like `TrackTableRow`.
component TrackTableHeader inherits HorizontalLayout {
    /// The name of the column of when or how often tracks were played; empty for none.
    in property <string> played-label;

    height: 32px;
    padding-left: 24px;
    padding-right: 12px;
    spacing: 16px;

    Text {
        min-width: 0;
        preferred-width: 0;
        horizontal-stretch: 3;
        text: "Title";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    Text {
        min-width: 0;
        preferred-width: 0;
        horizontal-stretch: 2;
        text: "Artist";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    Text {
        min-width: 0;
        preferred-width: 0;
        horizontal-stretch: 2;
        text: "Album";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    if root.played-label != "": Text {
        width: 104px;
        text: root.played-label;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        width: 48px;
        text: "Time";
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    // Where the rows have their add buttons.
    Rectangle { width: 30px; }
}

/// An album in a grid: its cover and, below it, its name and artist.
component AlbumTile inherits Rectangle {
    in property <LibraryRow> entry;
    in property <bool> cursor;
    /// Width and height of the cover.
    in property <length> size;
    callback pressed();
    /// A right-click, at this point in the window.
    callback context-menu(length, length);
    callback activated();

    /// Asked for only while the tile exists, which a list view limits to the tiles on screen.
    property <image> cover-image: entry.cover == "" ? @image-url("") : Library.cover(entry.cover, Library.covers-ready);

    width: size;
    accessible-role: list-item;
    accessible-label: entry.title + ", " + entry.artist;
    accessible-action-default => { root.activated(); }

    VerticalLayout {
        alignment: start;
        spacing: 3px;

        Rectangle {
            width: root.size;
            height: root.size;
            border-radius: 8px;
            clip: true;
            background: touch.has-hover ? Theme.hover : Theme.surface;

            if root.cover-image.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.cover-image;
                image-fit: cover;
            }
            if root.cover-image.width == 0: Icon {
                width: root.size * 0.3;
                height: self.width;
                data: root.entry.kind == "artist" ? Icons.artist : Icons.note;
                stroked: true;
                color: Theme.text-secondary;
            }
            // Over the cover, so it shows on dark covers too.
            if root.cursor: Rectangle {
                border-radius: 8px;
                border-width: 3px;
                border-color: Theme.accent;
            }
        }
        Rectangle { height: 4px; }
        Text {
            text: root.entry.title;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        // In an artist's albums the artist is the heading; the year and size say more.
        Text {
            text: root.entry.artist == Library.title ? root.entry.detail : root.entry.artist;
            font-size: 12px;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.pressed();
                root.context-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.pressed();
            root.activated();
        }
    }
}

/// The library and its search results, as `Library.layout` says: a list, a table of tracks,
/// or a grid of albums. The title, back button and search field are in the toolbar.
/// A track among an artist's most played: number, the album's cover, title and album, plays
/// and length.
component PopularRow inherits Rectangle {
    in property <LibraryRow> entry;
    in property <int> index;
    callback activated();

    property <image> cover-image: entry.cover == "" ? @image-url("") : Library.cover(entry.cover, Library.covers-ready);

    accessible-role: list-item;
    accessible-label: entry.title + ", " + entry.plays + " plays";
    accessible-action-default => { root.activated(); }

    Rectangle {
        x: 24px;
        width: parent.width - 48px;
        border-radius: 6px;
        background: touch.has-hover ? Theme.hover : transparent;
    }
    touch := TouchArea {
        double-clicked => { root.activated(); }

        HorizontalLayout {
            padding-left: 36px;
            padding-right: 36px;
            spacing: 16px;

            Rectangle {
                width: 24px;

                if touch.has-hover: IconButton {
                    x: parent.width - self.width + 4px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.play;
                    size: 28px;
                    label: "Play " + root.entry.title;
                    clicked => { root.activated(); }
                }
                if !touch.has-hover: Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.entry.number;
                    font-size: 14px;
                    color: Theme.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 40px;
                height: 40px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                clip: true;
                background: Theme.surface;

                if root.cover-image.width > 0: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.cover-image;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.entry.title;
                    font-size: 15px;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.entry.album;
                    font-size: 13px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }
            Text {
                width: 100px;
                text: root.entry.plays;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                width: 56px;
                text: root.entry.duration;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

/// The top of an artist's page: their picture across the page with their name large on it,
/// play, shuffle and add, what Last.fm says of them, their most played tracks, and the heading
/// of their albums. As tall as `head-height` says.
component ArtistPageHead inherits Rectangle {
    in property <ArtistPage> page;
    /// The sort and view of their albums.
    callback options();
    /// Read all of what Last.fm says.
    callback read-more();
    /// Show their picture whole and large.
    callback show-picture();
    /// Change their name, picture and biography.
    callback edit();
    /// Match them to the artist in MusicBrainz they are.
    callback fix-match();

    property <length> pad: 24px;

    accessible-role: groupbox;
    accessible-label: page.name;

    VerticalLayout {
        // Their picture across the page, darker towards its foot; without a large one, their
        // picture or covers beside their name, as an album's page has.
        Rectangle {
            height: 340px;
            background: root.page.color;
            clip: true;

            // Filling the width, cut a third of the way down rather than through the middle,
            // where faces in such pictures mostly are.
            if root.page.banner.width > 0: Image {
                property <float> aspect: root.page.banner.width / max(1, root.page.banner.height);

                width: max(parent.width, parent.height * self.aspect);
                height: self.width / self.aspect;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) * 0.3;
                source: root.page.banner;
                image-rendering: smooth;
            }
            Rectangle {
                background: @linear-gradient(180deg, #00000000 35%, root.page.color.with-alpha(0.85) 100%);
            }
            HorizontalLayout {
                padding: root.pad;
                spacing: 24px;

                // At the foot, beside their name; cut round by Freya.
                if root.page.banner.width == 0: VerticalLayout {
                    alignment: end;

                    Rectangle {
                        width: 232px;
                        height: 232px;
                        border-radius: 116px;
                        background: root.page.portrait.width > 0 ? transparent : #ffffff1a;
                        drop-shadow-blur: 24px;
                        drop-shadow-color: #00000066;

                        if root.page.portrait.width > 0: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.page.portrait;
                            image-rendering: smooth;
                        }
                        // Their picture whole and large.
                        if root.page.picture-full.width > 0: TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-picture(); }
                        }
                        if root.page.portrait.width == 0: Icon {
                            width: 64px;
                            height: 64px;
                            data: Icons.artist;
                            stroked: true;
                            color: #ffffffb3;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0;
                    alignment: end;
                    spacing: 8px;

                    Text {
                        text: root.page.note == "" ? "Artist" : "Artist · " + root.page.note;
                        font-size: 13px;
                        font-weight: 600;
                        color: #ffffff;
                    }
                    Text {
                        text: root.page.name;
                        font-size: root.page.name.character-count <= 14 ? 84px
                            : root.page.name.character-count <= 24 ? 60px
                            : 42px;
                        font-weight: 900;
                        color: #ffffff;
                        overflow: elide;
                    }
                    Text {
                        text: root.page.detail + (root.page.genres == "" ? "" : " · " + root.page.genres);
                        font-size: 14px;
                        color: #ffffffd9;
                        overflow: elide;
                    }
                }
            }
        }
        // Play, shuffle and add, over the color fading out.
        Rectangle {
            height: 88px;
            background: @linear-gradient(180deg, root.page.color.with-alpha(0.55) 0%, root.page.color.with-alpha(0) 100%);

            HorizontalLayout {
                padding-left: root.pad;
                spacing: 12px;
                alignment: start;

                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.play;
                    primary: true;
                    size: 56px;
                    label: "Play " + root.page.name;
                    tooltip: "Play";
                    clicked => { Library.play-all(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.shuffle;
                    stroked: true;
                    size: 44px;
                    label: "Shuffle " + root.page.name;
                    tooltip: "Shuffle";
                    clicked => { Library.shuffle-all(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    stroked: true;
                    size: 44px;
                    label: "Add " + root.page.name + " to Up Next";
                    tooltip: "Add to Up Next";
                    clicked => { Library.enqueue-all(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.pencil;
                    stroked: true;
                    size: 44px;
                    label: "Edit " + root.page.name;
                    tooltip: "Edit";
                    clicked => { root.edit(); }
                }
                artist-more := IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.more;
                    size: 44px;
                    label: "More for " + root.page.name;
                    tooltip: "More";
                    clicked => { artist-menu.show(); }
                }
            }
            artist-menu := PopupWindow {
                x: artist-more.absolute-position.x - root.absolute-position.x;
                y: artist-more.height;
                width: 220px;

                MenuSurface {
                    VerticalLayout {
                        padding: 6px;

                        MenuItem {
                            text: "Fix Match…";
                            activated => { root.fix-match(); }
                        }
                    }
                }
            }
        }
        // What Last.fm says of them.
        if root.page.summary != "": VerticalLayout {
            height: 150px;
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: 6px;

            Text {
                height: 84px;
                max-width: 760px;
                text: root.page.summary;
                font-size: 14px;
                color: Theme.text;
                wrap: word-wrap;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                if root.page.biography != "": Text {
                    text: "More";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.accent-text;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.read-more(); }
                    }
                }
                Text {
                    text: root.page.own-biography ? "" : (root.page.tags == "" ? "" : root.page.tags + " · ") + "From " + root.page.biography-from;
                    font-size: 12px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }
        }
        // Their most played tracks.
        if Library.popular.length > 0: VerticalLayout {
            Text {
                height: 48px;
                x: root.pad;
                text: "Popular";
                font-size: 22px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            for track[i] in Library.popular: PopularRow {
                height: 56px;
                entry: track;
                index: i;
                activated => { Library.play-popular(i); }
            }
            if root.page.popular-count > 5: HorizontalLayout {
                height: 40px;
                padding-left: root.pad + 12px;
                alignment: start;

                Text {
                    text: root.page.more ? "Show less" : "Show more";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Library.more-popular(); }
                    }
                }
            }
        }
        // Their albums' heading, with how they are ordered and shown.
        HorizontalLayout {
            height: 56px;
            padding-left: root.pad;
            padding-right: root.pad;

            Text {
                horizontal-stretch: 1;
                text: "Albums";
                font-size: 22px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle {
                width: albums-options.preferred-width;
                border-radius: 6px;
                background: albums-touch.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: "Sort and view";
                accessible-action-default => { root.options(); }

                albums-options := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: Library.album-sort == "name" ? "Name" : "Release date";
                        width: ceil(self.preferred-width / 1px) * 1px;
                        font-size: 13px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    Icon {
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        data: Library.album-view == "list" ? Icons.list : Icons.grid;
                        color: Theme.text-secondary;
                    }
                }
                albums-touch := TouchArea {
                    clicked => { root.options(); }
                }
            }
        }
    }
}

/// The top of an album's page: the cover and the album's name large, in a
/// color from the cover; play, shuffle and add; and the heading of the track table.
component AlbumPageHead inherits Rectangle {
    in property <AlbumPage> page;
    /// Match the album to the one in MusicBrainz it is.
    callback fix-match();

    property <image> cover-image: page.cover == "" ? @image-url("") : Library.cover(page.cover, Library.covers-ready);
    property <length> pad: 24px;

    accessible-role: groupbox;
    accessible-label: "Album " + page.title + " by " + page.artist + ", " + page.detail;

    VerticalLayout {
        // The cover's color behind the header, darker towards its foot.
        Rectangle {
            height: 300px;
            background: @linear-gradient(180deg, root.page.color.brighter(15%) 0%, root.page.color 100%);

            HorizontalLayout {
                padding: root.pad;
                padding-top: 40px;
                spacing: 24px;

                Rectangle {
                    width: 232px;
                    height: 232px;
                    y: parent.height - root.pad - self.height;
                    border-radius: 6px;
                    clip: true;
                    background: #ffffff1a;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #00000066;

                    if root.cover-image.width > 0: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.cover-image;
                        image-fit: cover;
                    }
                    if root.cover-image.width == 0: Icon {
                        width: 64px;
                        height: 64px;
                        data: Icons.note;
                        stroked: true;
                        color: #ffffffb3;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0;
                    alignment: end;
                    spacing: 8px;

                    Text {
                        text: "Album";
                        font-size: 13px;
                        font-weight: 600;
                        color: #ffffff;
                    }
                    // Large, smaller for a long name, and cut short only when that is not
                    // enough.
                    Text {
                        text: root.page.title;
                        font-size: root.page.title.character-count <= 14 ? 72px
                            : root.page.title.character-count <= 24 ? 56px
                            : root.page.title.character-count <= 40 ? 40px
                            : 30px;
                        font-weight: 900;
                        color: #ffffff;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: start;

                        Text {
                            text: root.page.artist;
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffffff;

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Library.open-album-artist(); }
                            }
                        }
                        Text {
                            text: " · " + root.page.detail;
                            font-size: 14px;
                            color: #ffffffcc;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        // The color fades out under the buttons.
        Rectangle {
            height: 96px;
            background: @linear-gradient(180deg, root.page.color.with-alpha(0.55) 0%, root.page.color.with-alpha(0) 100%);

            HorizontalLayout {
                padding-left: root.pad;
                spacing: 12px;
                alignment: start;

                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.play;
                    primary: true;
                    size: 56px;
                    label: "Play " + root.page.title;
                    tooltip: "Play";
                    clicked => { Library.play-all(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.shuffle;
                    stroked: true;
                    size: 44px;
                    label: "Shuffle " + root.page.title;
                    tooltip: "Shuffle";
                    clicked => { Library.shuffle-all(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.plus;
                    stroked: true;
                    size: 44px;
                    label: "Add " + root.page.title + " to Up Next";
                    tooltip: "Add to Up Next";
                    clicked => { Library.enqueue-all(); }
                }
                album-more := IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.more;
                    size: 44px;
                    label: "More for " + root.page.title;
                    tooltip: "More";
                    clicked => { album-menu.show(); }
                }
            }
        }
        album-menu := PopupWindow {
            x: album-more.absolute-position.x - root.absolute-position.x;
            y: album-more.absolute-position.y - root.absolute-position.y + album-more.height;
            width: 220px;

            MenuSurface {
                VerticalLayout {
                    padding: 6px;

                    MenuItem {
                        text: "Fix Match…";
                        activated => { root.fix-match(); }
                    }
                }
            }
        }
        // The track table's heading.
        HorizontalLayout {
            height: 36px;
            padding-left: root.pad + 12px;
            padding-right: root.pad + 12px;
            spacing: 16px;

            Text {
                width: 30px;
                text: "#";
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: "Title";
                font-size: 13px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Text {
                width: 100px;
                text: "Plays";
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle {
                width: 56px;

                Icon {
                    x: parent.width - self.width;
                    width: 16px;
                    height: 16px;
                    data: Icons.clock;
                    stroked: true;
                    color: Theme.text-secondary;
                }
            }
            // Over the add buttons.
            Rectangle { width: 30px; }
        }
        Rectangle {
            x: root.pad;
            width: root.width - 2 * root.pad;
            height: 1px;
            background: Theme.divider;
        }
    }
}

/// A track on an album's page: its number (a play button under the pointer, bars while it
/// plays), title and artist, plays and length.
component AlbumTrackRow inherits Rectangle {
    in property <LibraryRow> entry;
    in property <int> index;
    in property <bool> cursor;
    in property <bool> playing;
    callback pressed();
    /// A right-click, at this point in the window.
    callback context-menu(length, length);
    callback activated();

    accessible-role: list-item;
    accessible-label: entry.title + ", " + entry.artist + (entry.duration == "" ? "" : ", " + entry.duration);
    accessible-action-default => { root.activated(); }

    Rectangle {
        x: 24px;
        width: parent.width - 48px;
        border-radius: 6px;
        background: root.cursor ? Theme.selection : (touch.has-hover ? Theme.hover : transparent);
    }
    // Around the row's buttons, so the row stays hovered while the pointer is on one.
    touch := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.pressed();
                root.context-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.pressed(); }
        double-clicked => { root.activated(); }

        HorizontalLayout {
            padding-left: 36px;
            padding-right: 36px;
            spacing: 16px;

            Rectangle {
                width: 30px;

                if root.playing: Icon {
                    x: parent.width - self.width;
                    width: 16px;
                    height: 16px;
                    data: Icons.spectrum;
                    stroked: true;
                    color: Theme.accent;
                }
                if !root.playing && touch.has-hover: IconButton {
                    x: parent.width - self.width + 6px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.play;
                    size: 28px;
                    label: "Play " + root.entry.title;
                    clicked => { root.activated(); }
                }
                if !root.playing && !touch.has-hover: Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.entry.number;
                    font-size: 14px;
                    color: Theme.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.entry.title;
                    font-size: 15px;
                    color: root.playing ? Theme.accent : Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.entry.artist;
                    font-size: 13px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }
            Text {
                width: 100px;
                text: root.entry.plays;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                width: 56px;
                text: root.entry.duration;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                opacity: touch.has-hover ? 1 : 0;
                icon: Icons.plus;
                stroked: true;
                size: 30px;
                label: "Add " + root.entry.title + " to Up Next";
                tooltip: "Add to Up Next";
                clicked => { Library.enqueue(root.index); }
            }
        }
    }
}

/// An album in an artist's discography, over its tracks: cover, title, year and tracks, and
/// buttons to play it or add it to Up Next.
component DiscographyAlbum inherits Rectangle {
    in property <LibraryRow> entry;
    in property <int> index;
    callback opened();

    property <image> cover-image: entry.cover == "" ? @image-url("") : Library.cover(entry.cover, Library.covers-ready);

    accessible-role: list-item;
    accessible-label: entry.title + ", " + entry.detail;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 32px;
        padding-bottom: 16px;
        spacing: 20px;

        Rectangle {
            width: 136px;
            height: 136px;
            border-radius: 6px;
            clip: true;
            background: Theme.surface;

            if root.cover-image.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.cover-image;
                image-fit: cover;
            }
            if root.cover-image.width == 0: Icon {
                width: 40px;
                height: 40px;
                data: Icons.note;
                stroked: true;
                color: Theme.text-secondary;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.opened(); }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            Text {
                text: root.entry.title;
                font-size: 26px;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.opened(); }
                }
            }
            Text {
                text: "Album · " + root.entry.detail;
                font-size: 13px;
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                padding-top: 8px;

                IconButton {
                    icon: Icons.play;
                    primary: true;
                    size: 40px;
                    label: "Play " + root.entry.title;
                    tooltip: "Play";
                    clicked => { Library.play(root.index); }
                }
                IconButton {
                    icon: Icons.plus;
                    stroked: true;
                    size: 40px;
                    label: "Add " + root.entry.title + " to Up Next";
                    tooltip: "Add to Up Next";
                    clicked => { Library.enqueue(root.index); }
                }
            }
        }
    }
}

component LibraryPanel inherits FocusScope {
    /// Ctrl/Cmd+F: move to the search field.
    callback find();
    /// The dialog for changing the artist whose page is shown, at a page of it: "general"
    /// or "match".
    callback edit-artist(string);
    /// The dialogs for matching the artist or the album shown.
    callback match-artist();
    callback match-album();

    /// Back and forward: how far down the list shown is scrolled, and scrolling it back there.
    property <bool> shown: App.view == "library";
    property <int> restores: App.restores;
    changed shown => {
        if (root.shown) {
            root.report-scroll();
        }
    }
    changed restores => { root.restore-scroll(); }
    // Opened from elsewhere, as the album of the track playing: from the top, or at its row.
    property <int> reveals: Library.reveals;
    changed reveals => {
        root.start-over();
        if (Library.reveal-row >= 0) {
            root.cursor = Library.reveal-row;
            root.reveal(Library.reveal-row);
        }
        root.focus();
    }

    function report-scroll() {
        App.scroll = -(root.grid-shown ? grid.content-y
            : root.table-shown ? table.content-y
            : root.discography-shown ? discography.content-y
            : root.album-shown ? album.content-y
            : list.content-y);
    }

    function restore-scroll() {
        if (App.restore-view != "library") {
            return;
        }
        if (root.grid-shown) {
            grid.content-y = -App.restore-scroll;
        } else if (root.table-shown) {
            table.content-y = -App.restore-scroll;
        } else if (root.discography-shown) {
            discography.content-y = -App.restore-scroll;
        } else if (root.album-shown) {
            album.content-y = -App.restore-scroll;
        } else {
            list.content-y = -App.restore-scroll;
        }
    }

    /// The row a right-click opened the menu for, and where, in this component.
    property <int> menu-row: -1;
    property <length> menu-x;
    property <length> menu-y;

    function open-menu(row: int, x: length, y: length) {
        root.menu-row = row;
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        row-menu.show();
    }

    /// Row the keyboard acts on, or -1.
    property <int> cursor: -1;
    property <bool> grid-shown: Library.layout == "grid";
    property <bool> table-shown: Library.layout == "table";
    property <bool> discography-shown: Library.layout == "discography";
    /// An album's tracks, under the album's own page.
    property <bool> album-shown: Library.album-page.shown && !grid-shown && !table-shown && !discography-shown;
    property <bool> list-shown: !grid-shown && !table-shown && !discography-shown && !album-shown;
    property <length> album-page-head-height: 300px + 96px + 37px;
    property <length> album-row-height: 56px;
    /// An artist's page over their albums; its height, by what it holds.
    property <bool> artist-page-shown: Library.artist-page.shown && (grid-shown || discography-shown);
    property <int> head-lines: artist-page-shown ? 1 : 0;
    property <length> artist-head-height: 340px + 88px
        + (Library.artist-page.summary != "" ? 150px : 0)
        + (Library.popular.length > 0 ? 48px + Library.popular.length * 56px + (Library.artist-page.popular-count > 5 ? 40px : 0) : 0)
        + 56px;
    /// Over the artists, and an artist's albums: how they are ordered and shown. The artist's
    /// page has these in its albums' heading.
    property <bool> options-shown: (Library.album-options || Library.artist-options) && !artist-page-shown;
    property <length> options-height: options-shown ? 44px : 0;
    property <length> album-head-height: 188px;
    /// Recently Played and Most Played show when or how often each track was played.
    property <bool> played-column: Library.rows.length > 0 && Library.rows[0].played != "";
    property <bool> history-shown: Library.query == "" && (Library.section == "recently-played" || Library.section == "most-played");

    property <length> list-row-height: 42px;
    property <length> table-row-height: 34px;
    // The grid fits as many columns of at least `tile-min` as it can, and stretches them to fill
    // the width.
    property <length> grid-pad: 24px;
    property <length> grid-gap: 20px;
    property <length> tile-min: 150px;
    property <int> columns: max(1, floor((grid.visible-width - 2 * grid-pad + grid-gap) / (tile-min + grid-gap)));
    property <length> tile-size: (grid.visible-width - 2 * grid-pad - (columns - 1) * grid-gap) / columns;
    property <length> grid-line-height: tile-size + 48px + grid-gap;
    property <int> grid-lines: floor((Library.rows.length + columns - 1) / columns);

    /// Rows in a page, for Page Up and Page Down.
    property <int> page: grid-shown ? columns * max(1, floor(grid.visible-height / grid-line-height))
        : table-shown ? max(1, floor(table.visible-height / table-row-height) - 1)
        : max(1, floor(list.visible-height / list-row-height) - 1);

    /// Moves the keyboard to another row and scrolls to it.
    function move(delta: int) {
        if (Library.rows.length == 0) {
            return;
        }
        root.cursor = max(0, min(Library.rows.length - 1, root.cursor + delta));
        root.focus();
        root.reveal(root.cursor);
    }

    /// Scrolls just enough to show `row`.
    function reveal(row: int) {
        if (row < 0) {
            return;
        }
        if (root.grid-shown) {
            grid.content-y = root.scrolled-to(grid.content-y, grid.visible-height, root.head-lines * root.artist-head-height + floor(row / root.columns) * root.grid-line-height, root.grid-line-height);
        } else if (root.table-shown) {
            table.content-y = root.scrolled-to(table.content-y, table.visible-height, row * root.table-row-height, root.table-row-height);
        } else if (root.discography-shown) {
            // Albums and tracks differ in height; the keyboard row is shown where it is.
        } else if (root.album-shown) {
            album.content-y = root.scrolled-to(album.content-y, album.visible-height, root.album-page-head-height + row * root.album-row-height, root.album-row-height);
        } else {
            list.content-y = root.scrolled-to(list.content-y, list.visible-height, row * root.list-row-height, root.list-row-height);
        }
    }

    /// The scroll offset (`content-y`) that shows the span from `top`, `height` high, moving
    /// as little as possible.
    pure function scrolled-to(content-y: length, visible-height: length, top: length, height: length) -> length {
        // Before the first layout the view has no height, and every row would look hidden.
        if (visible-height <= 0) {
            return content-y;
        }
        if (top < -content-y) {
            return -top;
        }
        if (top + height > -content-y + visible-height) {
            return -(top + height - visible-height);
        }
        content-y
    }

    /// A new list: shown from the top, without a keyboard row. New search results too, so
    /// Enter plays the first of them and not the row the keyboard was on in the old ones.
    public function start-over() {
        root.cursor = -1;
        list.content-y = 0;
        table.content-y = 0;
        grid.content-y = 0;
        discography.content-y = 0;
        album.content-y = 0;
    }

    /// Opens an artist, album or genre, or plays a track.
    public function activate(row: int) {
        if (row < 0 || row >= Library.rows.length) {
            return;
        }
        if (Library.rows[row].kind == "track") {
            root.cursor = row;
        } else {
            root.start-over();
        }
        Library.activate(row);
    }

    /// Enter in the search field: the row the keyboard is on, else the first.
    public function activate-current() {
        root.activate(max(0, root.cursor));
    }

    public function back() {
        root.start-over();
        Library.back();
    }

    /// A section chosen in the navigation.
    public function show(section: string) {
        root.start-over();
        Library.show(section);
    }

    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            root.move(root.grid-shown ? -root.columns : -1);
        } else if (event.text == Key.DownArrow) {
            root.move(root.grid-shown ? root.columns : 1);
        } else if (event.text == Key.LeftArrow && root.grid-shown && !event.modifiers.alt) {
            root.move(-1);
        } else if (event.text == Key.RightArrow && root.grid-shown) {
            root.move(1);
        } else if (event.text == Key.PageUp) {
            root.move(-root.page);
        } else if (event.text == Key.PageDown) {
            root.move(root.page);
        } else if (event.text == Key.Return) {
            root.activate(root.cursor);
        } else if (event.text == Key.Escape) {
            root.back();
        } else if ((event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F")) {
            root.find();
        } else {
            return reject;
        }
        accept
    }

    // All three views always exist, so the functions above can reach them; the ones not
    // shown get no rows.
    list := ListView {
        visible: root.list-shown;
        y: root.options-height;
        height: root.height - root.options-height;
        changed content-y => {
            if (root.shown) {
                root.report-scroll();
            }
        }

        for row[i] in root.list-shown ? Library.rows : []: LibraryRowView {
            height: root.list-row-height;
            entry: row;
            index: i;
            cursor: i == root.cursor;
            playing: i == Library.playing-row;
            pressed => {
                root.cursor = i;
                root.focus();
            }
            activated => { root.activate(i); }
            context-menu(x, y) => { root.open-menu(i, x, y); }
        }
    }

    VerticalLayout {
        visible: root.table-shown;

        if root.table-shown && Library.rows.length > 0: TrackTableHeader {
            played-label: !root.played-column ? "" : Library.section == "most-played" ? "Plays" : "Last played";
        }
        table := ListView {
            changed content-y => {
                if (root.shown) {
                    root.report-scroll();
                }
            }

            for row[i] in root.table-shown ? Library.rows : []: TrackTableRow {
                height: root.table-row-height;
                played-column: root.played-column;
                entry: row;
                index: i;
                cursor: i == root.cursor;
                playing: i == Library.playing-row;
                pressed => {
                    root.cursor = i;
                    root.focus();
                }
                activated => { root.activate(i); }
                context-menu(x, y) => { root.open-menu(i, x, y); }
            }
        }
    }

    grid := ListView {
        visible: root.grid-shown;
        y: root.options-height;
        height: root.height - root.options-height;
        changed content-y => {
            if (root.shown) {
                root.report-scroll();
            }
        }

        // The artist's page first, when their albums are shown.
        for line in root.grid-shown ? root.grid-lines + root.head-lines : 0: grid-line := Rectangle {
            property <int> tiles: line - root.head-lines;

            height: line < root.head-lines ? root.artist-head-height : root.grid-line-height;

            if line < root.head-lines: ArtistPageHead {
                page: Library.artist-page;
                options => { options-menu.show(); }
                edit => { root.edit-artist("general"); }
                fix-match => { root.match-artist(); }
                read-more => { bio-popup.show(); }
                show-picture => { picture-popup.show(); }
            }
            if line >= root.head-lines: HorizontalLayout {
                padding-left: root.grid-pad;
                padding-top: grid-line.tiles == 0 && root.head-lines == 0 ? root.grid-pad : 0;
                spacing: root.grid-gap;
                alignment: start;

                for column in root.columns: AlbumTile {
                    property <int> index: grid-line.tiles * root.columns + column;

                    visible: self.index < Library.rows.length;
                    size: root.tile-size;
                    entry: Library.rows[self.index];
                    cursor: self.index == root.cursor;
                    pressed => {
                        root.cursor = self.index;
                        root.focus();
                    }
                    activated => { root.activate(self.index); }
                    context-menu(x, y) => { root.open-menu(self.index, x, y); }
                }
            }
        }
    }

    // An album's tracks under its page, which scrolls with them.
    album := ListView {
        visible: root.album-shown;
        changed content-y => {
            if (root.shown) {
                root.report-scroll();
            }
        }

        for index in root.album-shown ? Library.rows.length + 1 : 0: Rectangle {
            height: index == 0 ? root.album-page-head-height : root.album-row-height;

            if index == 0: AlbumPageHead {
                page: Library.album-page;
                fix-match => { root.match-album(); }
            }
            if index > 0: AlbumTrackRow {
                entry: Library.rows[index - 1];
                index: index - 1;
                cursor: index - 1 == root.cursor;
                playing: index - 1 == Library.playing-row;
                pressed => {
                    root.cursor = index - 1;
                    root.focus();
                }
                activated => { root.activate(index - 1); }
                context-menu(x, y) => { root.open-menu(index - 1, x, y); }
            }
        }
    }

    // An artist's albums, each followed by its tracks.
    discography := ListView {
        visible: root.discography-shown;
        y: root.options-height;
        height: root.height - root.options-height;
        changed content-y => {
            if (root.shown) {
                root.report-scroll();
            }
        }

        // The artist's page first, then each album and its tracks.
        for index in root.discography-shown ? Library.rows.length + root.head-lines : 0: cell := Rectangle {
            property <int> i: index - root.head-lines;
            property <bool> head: index < root.head-lines;
            property <bool> album: !self.head && Library.rows[self.i].kind == "album";

            height: self.head ? root.artist-head-height : self.album ? root.album-head-height : root.list-row-height;

            if cell.head: ArtistPageHead {
                page: Library.artist-page;
                options => { options-menu.show(); }
                edit => { root.edit-artist("general"); }
                fix-match => { root.match-artist(); }
                read-more => { bio-popup.show(); }
                show-picture => { picture-popup.show(); }
            }
            if cell.album: DiscographyAlbum {
                entry: Library.rows[cell.i];
                index: cell.i;
                opened => { root.activate(cell.i); }
            }
            if !cell.head && !cell.album: LibraryRowView {
                entry: Library.rows[cell.i];
                index: cell.i;
                cursor: cell.i == root.cursor;
                playing: cell.i == Library.playing-row;
                pressed => {
                    root.cursor = cell.i;
                    root.focus();
                }
                activated => { root.activate(cell.i); }
                context-menu(x, y) => { root.open-menu(cell.i, x, y); }
            }
        }
    }

    if root.options-shown: HorizontalLayout {
        y: 0;
        height: root.options-height;
        padding-right: 20px;
        spacing: 4px;
        alignment: end;

        // Every artist's music.
        if Library.artist-options: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.play;
            size: 34px;
            label: "Play all artists";
            tooltip: "Play";
            clicked => { Library.play-all(); }
        }
        if Library.artist-options: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.shuffle;
            stroked: true;
            size: 34px;
            label: "Shuffle all artists";
            tooltip: "Shuffle";
            clicked => { Library.shuffle-all(); }
        }
        if Library.artist-options: IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.plus;
            stroked: true;
            size: 34px;
            label: "Add all artists to Up Next";
            tooltip: "Add to Up Next";
            clicked => { Library.enqueue-all(); }
        }
        Rectangle {
            width: options-label.preferred-width;
            border-radius: 6px;
            background: options-touch.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: "Sort and view";
            accessible-action-default => { options-menu.show(); }

            options-label := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                Text {
                    text: Library.artist-options
                        ? (Library.artist-sort == "most-played" ? "Most played"
                            : Library.artist-sort == "recently-added" ? "Recently added"
                            : "Name")
                        : (Library.album-sort == "name" ? "Name" : "Release date");
                    // A whole number of pixels, so the icon after it falls on a pixel.
                    width: ceil(self.preferred-width / 1px) * 1px;
                    font-size: 13px;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                Icon {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    data: (Library.artist-options ? Library.artist-view : Library.album-view) == "list" ? Icons.list : Icons.grid;
                    color: Theme.text-secondary;
                }
            }
            options-touch := TouchArea {
                clicked => { options-menu.show(); }
            }
        }
    }

    options-menu := PopupWindow {
        x: root.width - self.width - 20px;
        y: root.options-height - 2px;
        width: 220px;

        MenuSurface {
            VerticalLayout {
                padding: 6px;

                MenuHeading { text: "Sort by"; }
                if !Library.artist-options: MenuItem {
                    text: "Release date";
                    checked: Library.album-sort == "release-date";
                    activated => { Library.set-album-sort("release-date"); }
                }
                if !Library.artist-options: MenuItem {
                    text: "Name";
                    checked: Library.album-sort == "name";
                    activated => { Library.set-album-sort("name"); }
                }
                if Library.artist-options: MenuItem {
                    text: "Name";
                    checked: Library.artist-sort == "name";
                    activated => { Library.set-artist-sort("name"); }
                }
                if Library.artist-options: MenuItem {
                    text: "Most played";
                    checked: Library.artist-sort == "most-played";
                    activated => { Library.set-artist-sort("most-played"); }
                }
                if Library.artist-options: MenuItem {
                    text: "Recently added";
                    checked: Library.artist-sort == "recently-added";
                    activated => { Library.set-artist-sort("recently-added"); }
                }
                MenuDivider { }
                MenuHeading { text: "View as"; }
                MenuItem {
                    text: "List";
                    checked: (Library.artist-options ? Library.artist-view : Library.album-view) == "list";
                    activated => {
                        if (Library.artist-options) {
                            Library.set-artist-view("list");
                        } else {
                            Library.set-album-view("list");
                        }
                    }
                }
                MenuItem {
                    text: "Grid";
                    checked: (Library.artist-options ? Library.artist-view : Library.album-view) == "grid";
                    activated => {
                        if (Library.artist-options) {
                            Library.set-artist-view("grid");
                        } else {
                            Library.set-album-view("grid");
                        }
                    }
                }
            }
        }
    }

    // All of what Last.fm says of the artist, over the library, closed with Close or Esc.
    // An artist's picture whole, large over the dimmed library; any click closes it.
    picture-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        Rectangle {
            background: #000000b3;

            Image {
                property <float> aspect: Library.artist-page.picture-full.width / max(1, Library.artist-page.picture-full.height);

                // As large as the library allows, up to the picture's own size.
                width: min(parent.width - 96px, (parent.height - 96px) * self.aspect, Library.artist-page.picture-full.width * 1px);
                height: self.width / self.aspect;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: Library.artist-page.picture-full;
                image-rendering: smooth;
                accessible-role: image;
                accessible-label: Library.artist-page.name;
            }
        }
    }

    bio-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: #00000059;

            MenuSurface {
                width: min(640px, parent.width - 48px);
                height: min(560px, parent.height - 48px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: Library.artist-page.name;
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            Text {
                                text: Library.artist-page.biography;
                                font-size: 14px;
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: Library.artist-page.own-biography ? ""
                                : Library.artist-page.biography-from == "Wikipedia" ? "From Wikipedia, the free encyclopedia (CC BY-SA)"
                                : "From Last.fm, by its listeners (CC BY-SA)";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        TextButton {
                            text: "Close";
                            clicked => { bio-popup.close(); }
                        }
                    }
                }
            }
        }
    }

    row-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 260px;

        MenuSurface {
            VerticalLayout {
                padding: 6px;

                MenuItem {
                    text: "Play";
                    activated => { Library.play(root.menu-row); }
                }
                MenuItem {
                    text: "Add to Up Next";
                    activated => { Library.enqueue(root.menu-row); }
                }
                if Playlists.playlists.length > 0: MenuDivider { }
                for playlist[i] in Playlists.playlists: MenuItem {
                    text: "Add to " + playlist.name;
                    activated => { Playlists.add-library-row(i, root.menu-row); }
                }
                // An artist is changed on their page, which opens first.
                if root.menu-row >= 0 && root.menu-row < Library.rows.length && Library.rows[root.menu-row].kind == "artist": MenuDivider { }
                if root.menu-row >= 0 && root.menu-row < Library.rows.length && Library.rows[root.menu-row].kind == "artist": MenuItem {
                    text: "Edit Artist…";
                    activated => {
                        root.activate(root.menu-row);
                        root.edit-artist("general");
                    }
                }
                if root.menu-row >= 0 && root.menu-row < Library.rows.length && Library.rows[root.menu-row].kind == "album": MenuDivider { }
                if root.menu-row >= 0 && root.menu-row < Library.rows.length && Library.rows[root.menu-row].kind == "album": MenuItem {
                    text: "Fix Match…";
                    activated => {
                        root.activate(root.menu-row);
                        root.match-album();
                    }
                }
                if root.menu-row >= 0 && root.menu-row < Library.rows.length && Library.rows[root.menu-row].kind == "artist": MenuItem {
                    text: "Fix Match…";
                    activated => {
                        root.activate(root.menu-row);
                        root.match-artist();
                    }
                }
            }
        }
    }

    if Library.rows.length == 0: VerticalLayout {
        alignment: center;
        padding-left: 32px;
        padding-right: 32px;
        spacing: 6px;

        Text {
            text: Library.folders.length == 0 ? "Build your music library"
                : Library.scanning ? "Reading your music…"
                : Library.query != "" ? "No matches"
                : root.history-shown ? "Nothing played yet"
                : "No music found";
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: Library.folders.length == 0 ? "Choose the folder your music is in. Freya lists it by artist and album, and checks it for changes each time it starts."
                : Library.scanning ? Library.status
                : Library.query != "" ? "Nothing in the library matches “" + Library.query + "”."
                : root.history-shown ? "Tracks you listen to show up here. A track counts once you have heard half of it, or four minutes."
                : "There are no music files in your music folders.";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if Library.folders.length == 0: HorizontalLayout {
            alignment: center;
            padding-top: 8px;

            TextButton {
                text: "Add music folder…";
                clicked => { Library.add-folder(); }
            }
        }
    }
}

/// A saved radio station in the radio view.
component StationRowView inherits Rectangle {
    in property <StationRow> entry;
    in property <int> index;

    height: 56px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: entry.name + (entry.playing ? ", playing" : "");
    accessible-action-default => { Radio.play(root.index); }

    // Below the button, so it gets its own clicks.
    touch := TouchArea {
        clicked => { Radio.play(root.index); }
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 12px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;

            Icon {
                width: 22px;
                height: 22px;
                data: Icons.radio;
                stroked: true;
                color: root.entry.playing ? Theme.accent-text : Theme.text-secondary;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.entry.name;
                color: root.entry.playing ? Theme.accent-text : Theme.text;
                font-weight: root.entry.playing ? 600 : 400;
                overflow: elide;
            }
            Text {
                text: root.entry.address;
                font-size: 12px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        if root.entry.playing: Text {
            text: "Playing";
            font-size: 12px;
            color: Theme.accent-text;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.trash;
            stroked: true;
            size: 32px;
            label: "Remove " + root.entry.name;
            tooltip: "Remove the station";
            clicked => { Radio.remove(root.index); }
        }
    }
}

/// The saved radio stations; a click plays one.
component RadioView inherits Rectangle {
    callback add-station();

    property <int> restores: App.restores;
    init => { root.restore-scroll(); }
    changed restores => { root.restore-scroll(); }

    // Back and forward: how far down it is scrolled, and scrolling it back there.
    function restore-scroll() {
        if (App.restore-view == "radio") {
            stations.content-y = -App.restore-scroll;
        }
        App.scroll = -stations.content-y;
    }

    stations := ListView {
        changed content-y => { App.scroll = -self.content-y; }

        for station[i] in Radio.stations: StationRowView {
            entry: station;
            index: i;
        }
    }

    if Radio.stations.length == 0: VerticalLayout {
        alignment: center;
        spacing: 6px;

        Text {
            text: "No stations";
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "Save the stations you listen to, and play them from here.";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 8px;

            TextButton {
                text: "Add a station…";
                clicked => { root.add-station(); }
            }
        }
    }
}

/// A text field with a label above it, as in forms.
component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    /// Under the field, in small print.
    in property <string> hint;
    in-out property <string> text;
    callback accepted();

    public function focus-field() {
        input.focus();
    }

    spacing: 4px;

    Text {
        text: root.label;
        font-size: 13px;
        color: Theme.text-secondary;
    }
    Rectangle {
        height: 34px;
        border-radius: 8px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.divider;
        background: Theme.background;

        if root.text == "": Text {
            x: 10px;
            width: parent.width - 20px;
            text: root.placeholder;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            text <=> root.text;
            single-line: true;
            color: Theme.text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.text;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: root.label;
            accepted => { root.accepted(); }
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        font-size: 12px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

/// Asks for a new station's name and address.
component AddStationForm inherits MenuSurface {
    callback done();

    function save() {
        Radio.add(name.text, address.text);
        // Freya answers at once: an error stays in Radio.error and the form stays open.
        if (Radio.error == "") {
            name.text = "";
            address.text = "";
            root.done();
        }
    }

    init => { address.focus-field(); }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Add a station";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }
        address := FormField {
            label: "Address";
            placeholder: "The stream, or the station's .pls or .m3u file";
            accepted => { name.focus-field(); }
        }
        name := FormField {
            label: "Name";
            placeholder: "Optional";
            accepted => { root.save(); }
        }
        if Radio.error != "": Text {
            text: Radio.error;
            font-size: 13px;
            color: Theme.danger;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            TextButton {
                text: "Cancel";
                clicked => { root.done(); }
            }
            TextButton {
                text: "Add";
                clicked => { root.save(); }
            }
        }
    }
}

/// Asks for a playlist's name: for a new playlist, for keeping Up Next, or for a new name.
component PlaylistNameForm inherits MenuSurface {
    in property <string> title;
    /// The button that saves, like "Create".
    in property <string> action;
    /// The name the field starts with.
    in property <string> initial;
    /// Calls the `Playlists` callback that uses the name.
    callback submit(string);
    /// The name was taken.
    callback saved();
    callback cancelled();

    function save() {
        root.submit(name.text);
        // Freya answers at once: an error stays in Playlists.error and the form stays open.
        if (Playlists.error == "") {
            root.saved();
        }
    }

    init => {
        name.text = root.initial;
        name.focus-field();
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
        }
        name := FormField {
            label: "Name";
            accepted => { root.save(); }
        }
        if Playlists.error != "": Text {
            text: Playlists.error;
            font-size: 13px;
            color: Theme.danger;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            TextButton {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            TextButton {
                text: root.action;
                clicked => { root.save(); }
            }
        }
    }
}

/// Asks before deleting the playlist shown.
component DeletePlaylistForm inherits MenuSurface {
    callback deleted();
    callback cancelled();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Text {
            text: "Delete " + (Playlists.shown >= 0 ? Playlists.playlists[Playlists.shown].name : "the playlist") + "?";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: "The playlist and its file are removed. The music stays.";
            font-size: 13px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            TextButton {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            TextButton {
                text: "Delete";
                clicked => {
                    Playlists.delete();
                    root.deleted();
                }
            }
        }
    }
}

/// A track of the playlist shown.
component PlaylistTrackRow inherits Rectangle {
    in property <TrackRow> entry;
    in property <int> index;

    height: 34px;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: entry.title + (entry.duration == "" ? "" : ", " + entry.duration);
    accessible-action-default => { Playlists.play(root.index); }

    // Below the button, so it gets its own clicks.
    touch := TouchArea {
        double-clicked => { Playlists.play(root.index); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            width: 36px;
            text: root.entry.number;
            font-size: 13px;
            color: Theme.text-secondary;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.entry.title;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.entry.duration;
            font-size: 13px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.trash;
            stroked: true;
            size: 28px;
            label: "Remove from the playlist";
            clicked => { Playlists.remove(root.index); }
        }
    }
}

/// The tracks of the playlist shown; a double-click plays from one.
component PlaylistView inherits Rectangle {
    property <int> restores: App.restores;
    init => { root.restore-scroll(); }
    changed restores => { root.restore-scroll(); }

    // Back and forward: how far down it is scrolled, and scrolling it back there.
    function restore-scroll() {
        if (App.restore-view == "playlist") {
            tracks.content-y = -App.restore-scroll;
        }
        App.scroll = -tracks.content-y;
    }

    tracks := ListView {
        changed content-y => { App.scroll = -self.content-y; }

        for track[i] in Playlists.tracks: PlaylistTrackRow {
            entry: track;
            index: i;
        }
    }

    if Playlists.tracks.length == 0: VerticalLayout {
        alignment: center;
        padding-left: 32px;
        padding-right: 32px;
        spacing: 6px;

        Text {
            text: "This playlist is empty";
            font-size: 16px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "Right-click tracks or albums in the library, or tracks in Up Next, to add them here.";
            font-size: 14px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

/// A heading in the navigation, with an add button when `add-label` is set.
component SidebarHeading inherits HorizontalLayout {
    in property <string> text;
    /// Read by screen readers, and shown as the add button's tooltip.
    in property <string> add-label;
    callback add();

    padding-left: 10px;
    padding-top: 14px;
    padding-bottom: 4px;
    height: self.add-label == "" ? self.preferred-height : 48px;

    Text {
        horizontal-stretch: 1;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
    if root.add-label != "": IconButton {
        icon: Icons.plus;
        stroked: true;
        size: 26px;
        label: root.add-label;
        clicked => { root.add(); }
    }
}

/// An entry in the navigation.
component SidebarItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    /// A count after the name, like the number of tracks; may be empty.
    in property <string> badge;
    in property <bool> selected;
    callback clicked;

    height: 34px;
    border-radius: 8px;
    // The usual hover color is the navigation's own color in light mode, so use a darker one.
    background: selected ? Theme.selection : (touch.has-hover ? Theme.pressed : transparent);
    accessible-role: button;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            Icon {
                width: 18px;
                height: 18px;
                data: root.icon;
                stroked: true;
                color: root.selected ? Theme.accent-text : Theme.text-secondary;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.badge != "": Text {
            text: root.badge;
            font-size: 12px;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// The navigation down the left side.
/// Looking for, and installing, an update to Freya.
/// The library's folders, edited as in a dialog: nothing changes until Save, and then the
/// library is read once.
component FoldersForm inherits MenuSurface {
    callback closed();

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        VerticalLayout {
            spacing: 4px;

            Text {
                text: "Library folders";
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: "Freya lists the music in these folders by artist and album, and checks them for changes each time it starts. A folder taken out takes its tracks out of the library; what you played is remembered.";
                font-size: 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        if Library.folders-draft.length == 0: Rectangle {
            height: 56px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.divider;

            Text {
                text: "No folders. Add the folder your music is in.";
                font-size: 13px;
                color: Theme.text-secondary;
            }
        }
        if Library.folders-draft.length > 0: Rectangle {
            height: min(Library.folders-draft.length, 6) * 44px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.divider;
            clip: true;

            ScrollView {
                VerticalLayout {
                    for folder[i] in Library.folders-draft: Rectangle {
                        height: 44px;
                        background: Theme.surface;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 10px;

                            Icon {
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                                data: Icons.folder;
                                stroked: true;
                                color: Theme.text-secondary;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: folder;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.close;
                                stroked: true;
                                size: 30px;
                                label: "Take " + folder + " out of the library";
                                tooltip: "Remove";
                                clicked => { Library.remove-draft-folder(i); }
                            }
                        }
                        if i < Library.folders-draft.length - 1: Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: start;

            TextButton {
                text: "Add Folder…";
                clicked => { Library.add-draft-folder(); }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            TextButton {
                text: "Cancel";
                clicked => { root.closed(); }
            }
            TextButton {
                text: "Save Changes";
                primary: true;
                clicked => {
                    Library.save-folders();
                    root.closed();
                }
            }
        }
    }
}

/// One page of a dialog with pages, in its list at the side.
component FormTab inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> selected;
    callback clicked;

    height: 38px;
    border-radius: 6px;
    background: selected ? Theme.hover : (touch.has-hover ? Theme.hover.transparentize(50%) : transparent);
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;

        Icon {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            data: root.icon;
            stroked: true;
            color: root.selected ? Theme.accent-text : Theme.text-secondary;
        }
        Text {
            text: root.text;
            font-size: 14px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.accent-text : Theme.text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// A picture to choose, with where it is from and its size; ringed in the accent color when
/// chosen.
component PictureTile inherits VerticalLayout {
    in property <PictureChoice> choice;
    in property <length> tile-width;
    in property <bool> wide;
    callback clicked;

    alignment: start;
    spacing: 4px;
    accessible-role: button;
    accessible-label: choice.source + (choice.size == "" ? "" : ", " + choice.size);
    accessible-checkable: true;
    accessible-checked: choice.chosen;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        width: root.tile-width;
        height: root.wide ? root.tile-width * 9 / 16 : root.tile-width;
        border-radius: 6px;
        clip: true;
        background: touch.has-hover ? Theme.hover : Theme.background;

        if root.choice.picture.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.choice.picture;
            image-fit: cover;
            image-rendering: smooth;
        }
        if root.choice.picture.width == 0: Icon {
            width: 32px;
            height: 32px;
            data: Icons.close;
            stroked: true;
            color: Theme.text-secondary;
        }
        // Over the picture, so it shows on dark ones too.
        if root.choice.chosen: Rectangle {
            border-radius: 6px;
            border-width: 3px;
            border-color: Theme.accent;
        }
        if root.choice.chosen: Rectangle {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: Theme.accent;

            Icon {
                width: 16px;
                height: 16px;
                data: Icons.check;
                stroked: true;
                color: Theme.on-accent;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
    Text {
        width: root.tile-width;
        text: root.choice.source;
        font-size: 13px;
        font-weight: root.choice.chosen ? 600 : 400;
        color: Theme.text;
        overflow: elide;
    }
    Text {
        width: root.tile-width;
        // Kept when empty, so the tiles of a row line up.
        text: root.choice.size == "" ? " " : root.choice.size;
        font-size: 12px;
        color: Theme.text-secondary;
        overflow: elide;
    }
}

/// The pictures of one kind to choose from, "portrait" or "backdrop", with ways to give one.
component PicturePage inherits VerticalLayout {
    in property <string> kind;
    in property <[PictureChoice]> choices;
    in property <bool> wide;

    property <bool> url-shown;
    property <length> pad: 20px;
    property <length> gap: 16px;
    property <int> columns: root.wide ? 2 : max(2, floor((scroll.visible-width - 2 * root.pad + root.gap) / (150px + root.gap)));
    property <length> tile-width: (scroll.visible-width - 2 * root.pad - (root.columns - 1) * root.gap) / root.columns;

    HorizontalLayout {
        padding: 14px;
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        alignment: start;

        LinkText {
            text: "Choose an image…";
            font-size: 13px;
            font-weight: 600;
            color: Theme.accent-text;
            label: "Choose an image file";
            clicked => { Library.pick-picture-file(root.kind); }
        }
        Text {
            text: "·";
            font-size: 13px;
            color: Theme.text-secondary;
        }
        LinkText {
            text: "Enter a URL";
            font-size: 13px;
            font-weight: 600;
            color: Theme.accent-text;
            label: "Enter the address of a picture";
            clicked => { root.url-shown = !root.url-shown; }
        }
    }
    if Library.finding-pictures: Text {
        x: root.pad;
        text: "Looking for more pictures on the internet…";
        font-size: 12px;
        color: Theme.text-secondary;
    }
    if root.url-shown: HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        padding-bottom: 12px;
        spacing: 8px;

        url := FormField {
            horizontal-stretch: 1;
            placeholder: "https://…";
            accepted => { Library.picture-from-url(root.kind, self.text); }
        }
        VerticalLayout {
            alignment: end;

            TextButton {
                text: "Use";
                clicked => { Library.picture-from-url(root.kind, url.text); }
            }
        }
    }
    if Library.picture-error != "": Text {
        x: root.pad;
        text: Library.picture-error;
        font-size: 12px;
        color: Theme.danger;
        wrap: word-wrap;
    }
    Rectangle {
        height: 1px;
        background: Theme.divider;
    }
    scroll := ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            padding: root.pad;
            spacing: 22px;
            alignment: start;

            for line in ceil(root.choices.length / root.columns): HorizontalLayout {
                spacing: root.gap;
                alignment: start;

                for column in root.columns: PictureTile {
                    property <int> index: line * root.columns + column;

                    visible: self.index < root.choices.length;
                    tile-width: root.tile-width;
                    wide: root.wide;
                    choice: root.choices[self.index];
                    clicked => { Library.choose-picture(root.kind, self.index); }
                }
            }
        }
    }
}

/// One artist MusicBrainz found, with what tells them apart; ringed when it is the match.
component MatchRow inherits Rectangle {
    in property <MatchChoice> choice;
    in property <bool> chosen;
    callback clicked;

    height: 84px;
    border-radius: 8px;
    border-width: chosen ? 2px : 1px;
    border-color: chosen ? Theme.accent : Theme.divider;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: choice.name + (choice.detail == "" ? "" : ", " + choice.detail) + (choice.facts == "" ? "" : ", " + choice.facts);
    accessible-checkable: true;
    accessible-checked: chosen;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding: 10px;
        spacing: 14px;

        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 6px;
            clip: true;
            background: Theme.background;

            if root.choice.picture.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.choice.picture;
                image-fit: cover;
            }
            if root.choice.picture.width == 0: Icon {
                width: 28px;
                height: 28px;
                data: Icons.artist;
                stroked: true;
                color: Theme.text-secondary;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            alignment: center;
            spacing: 3px;

            Text {
                text: root.choice.name;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.choice.detail != "": Text {
                text: root.choice.detail;
                font-size: 13px;
                color: Theme.text;
                overflow: elide;
            }
            if root.choice.facts != "": Text {
                text: root.choice.facts;
                font-size: 12px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        if root.chosen: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;

                Icon {
                    width: 16px;
                    height: 16px;
                    data: Icons.check;
                    stroked: true;
                    color: Theme.on-accent;
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// An album MusicBrainz found, with the artist who made it; ringed when it is the match.
component AlbumMatchRow inherits Rectangle {
    in property <AlbumMatchChoice> choice;
    in property <bool> chosen;
    callback clicked;

    height: 84px;
    border-radius: 8px;
    border-width: chosen ? 2px : 1px;
    border-color: chosen ? Theme.accent : Theme.divider;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: choice.title + ", " + choice.artist + (choice.detail == "" ? "" : ", " + choice.detail) + (choice.facts == "" ? "" : ", " + choice.facts);
    accessible-checkable: true;
    accessible-checked: chosen;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding: 10px;
        spacing: 14px;

        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 4px;
            clip: true;
            background: Theme.background;

            if root.choice.picture.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: root.choice.picture;
                image-fit: cover;
            }
            if root.choice.picture.width == 0: Icon {
                width: 28px;
                height: 28px;
                data: Icons.note;
                stroked: true;
                color: Theme.text-secondary;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            alignment: center;
            spacing: 3px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.choice.title;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.choice.facts;
                    font-size: 12px;
                    color: Theme.text-secondary;
                }
            }
            Text {
                text: root.choice.artist;
                font-size: 13px;
                color: Theme.text;
                overflow: elide;
            }
            if root.choice.detail != "": Text {
                text: root.choice.detail;
                font-size: 12px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        if root.chosen: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.accent;

                Icon {
                    width: 16px;
                    height: 16px;
                    data: Icons.check;
                    stroked: true;
                    color: Theme.on-accent;
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Matching an artist to the one in MusicBrainz they are, among those of their name: so their
/// pictures and biography are theirs.
component ArtistMatchForm inherits MenuSurface {
    callback closed();

    property <ArtistMatchDraft> draft: Library.artist-match;
    /// The match chosen, kept on Save: an id, or empty for Freya's own.
    property <string> picked: draft.mbid;
    property <string> shown: picked != "" ? picked : draft.found-mbid;

    public function cancel() {
        Library.cancel-artist-match();
        root.closed();
    }

    function save() {
        Library.save-artist-match(root.picked);
        root.closed();
    }

    VerticalLayout {
        HorizontalLayout {
            padding: 20px;
            padding-right: 12px;
            spacing: 12px;

            Icon {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                data: Icons.search;
                stroked: true;
                color: Theme.text-secondary;
            }
            Text {
                horizontal-stretch: 1;
                text: "Fix Match: " + root.draft.artist;
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            IconButton {
                icon: Icons.close;
                stroked: true;
                size: 32px;
                label: "Close";
                clicked => { root.cancel(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;

            search := FormField {
                horizontal-stretch: 1;
                label: "Name";
                text: root.draft.artist;
                accepted => { Library.find-matches(self.text); }
            }
            VerticalLayout {
                alignment: end;

                TextButton {
                    text: "Search";
                    clicked => { Library.find-matches(search.text); }
                }
            }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 10px;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: Library.match-error != "" ? Library.match-error
                    : Library.finding-matches ? "Asking MusicBrainz…"
                    : root.picked != "" ? "Matched by you: their pictures and biography are of this artist."
                    : root.draft.found-mbid != "" ? "Matched by Freya, from the tags or the name. Choose another if it is someone else."
                    : "Not matched yet: Freya matches by the name.";
                font-size: 12px;
                color: Library.match-error != "" ? Theme.danger : Theme.text-secondary;
                wrap: word-wrap;
            }
            if root.picked != "": LinkText {
                text: "Auto Match";
                font-size: 12px;
                font-weight: 600;
                color: Theme.accent-text;
                label: "Let Freya match this artist again";
                clicked => { root.picked = ""; }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;

                for choice in Library.artist-matches: MatchRow {
                    choice: choice;
                    chosen: choice.mbid == root.shown;
                    // Freya's own match is no choice of the user's.
                    clicked => { root.picked = choice.mbid == root.draft.found-mbid ? "" : choice.mbid; }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;
            alignment: end;

            TextButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            TextButton {
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}

/// Matching an album to the one in MusicBrainz it is, and so to the artist who made it: any
/// of the same name too.
component AlbumMatchForm inherits MenuSurface {
    callback closed();

    property <AlbumMatchDraft> draft: Library.album-draft;
    /// The match chosen, kept on Save: a release group, or empty to file it as its tags say.
    property <string> picked: draft.release-group;

    public function cancel() {
        Library.cancel-album-match();
        root.closed();
    }

    function save() {
        Library.save-album-match(root.picked);
        root.closed();
    }

    function search() {
        Library.find-album-matches(title-field.text, artist-field.text);
    }

    VerticalLayout {
        VerticalLayout {
            padding: 20px;
            padding-right: 12px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 12px;

                Icon {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    data: Icons.search;
                    stroked: true;
                    color: Theme.text-secondary;
                }
                Text {
                    horizontal-stretch: 1;
                    text: "Fix Match";
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: Icons.close;
                    stroked: true;
                    size: 32px;
                    label: "Close";
                    clicked => { root.cancel(); }
                }
            }
            if root.draft.folder != "": Text {
                text: "Location: " + root.draft.folder;
                font-size: 13px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;

            title-field := FormField {
                horizontal-stretch: 1;
                label: "Title";
                text: root.draft.title;
                accepted => { root.search(); }
            }
            artist-field := FormField {
                horizontal-stretch: 1;
                label: "Artist";
                text: root.draft.artist;
                accepted => { root.search(); }
            }
            VerticalLayout {
                alignment: end;

                TextButton {
                    text: "Search";
                    clicked => { root.search(); }
                }
            }
        }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 10px;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                text: Library.album-match-error != "" ? Library.album-match-error
                    : Library.finding-album-matches ? "Asking MusicBrainz…"
                    : root.picked != "" ? "Matched by you: filed under the artist who made it."
                    : "Filed as its tags say. Choose the album it is to file it under the artist who made it.";
                font-size: 12px;
                color: Library.album-match-error != "" ? Theme.danger : Theme.text-secondary;
                wrap: word-wrap;
            }
            if root.picked != "": LinkText {
                text: "Auto Match";
                font-size: 12px;
                font-weight: 600;
                color: Theme.accent-text;
                label: "File the album as its tags say again";
                clicked => { root.picked = ""; }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;

                for choice in Library.album-matches: AlbumMatchRow {
                    choice: choice;
                    chosen: choice.release-group == root.picked;
                    clicked => { root.picked = choice.release-group; }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;
            alignment: end;

            TextButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            TextButton {
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}

/// Changing an artist: the name shown and sorted by, their MusicBrainz id and biography. What
/// is left empty goes back to the tags' and the internet's.
component ArtistEditForm inherits MenuSurface {
    callback closed();

    /// The page shown: "general", "picture" or "background".
    in-out property <string> tab: "general";
    property <ArtistDraft> draft: Library.artist-draft;
    property <string> name: draft.name;
    property <string> sort-name: draft.sort-name;
    property <string> mbid: draft.mbid;
    property <string> biography: draft.biography;

    function save() {
        Library.save-artist(root.name, root.sort-name, root.mbid, root.biography);
        root.closed();
    }

    public function cancel() {
        Library.cancel-artist();
        root.closed();
    }



    VerticalLayout {
        HorizontalLayout {
            padding: 20px;
            padding-right: 12px;
            spacing: 12px;

            Icon {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                data: Icons.pencil;
                stroked: true;
                color: Theme.text-secondary;
            }
            Text {
                horizontal-stretch: 1;
                text: "Edit " + Library.artist-page.name;
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            IconButton {
                icon: Icons.close;
                stroked: true;
                size: 32px;
                label: "Close";
                clicked => { root.cancel(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            vertical-stretch: 1;

            VerticalLayout {
                width: 190px;
                padding: 10px;
                spacing: 2px;
                alignment: start;

                FormTab {
                    text: "General";
                    icon: Icons.queue;
                    selected: root.tab == "general";
                    clicked => { root.tab = "general"; }
                }
                FormTab {
                    text: "Picture";
                    icon: Icons.artist;
                    selected: root.tab == "picture";
                    clicked => { root.tab = "picture"; }
                }
                FormTab {
                    text: "Background";
                    icon: Icons.picture;
                    selected: root.tab == "background";
                    clicked => { root.tab = "background"; }
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.divider;
            }
            if root.tab == "picture": PicturePage {
                horizontal-stretch: 1;
                kind: "portrait";
                choices: Library.portrait-choices;
            }
            if root.tab == "background": PicturePage {
                horizontal-stretch: 1;
                kind: "backdrop";
                choices: Library.backdrop-choices;
                wide: true;
            }
            if root.tab == "general": ScrollView {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 20px;
                    spacing: 18px;

                    Text {
                        text: "Kept in Freya: your music's files and tags are not changed. What you leave empty is what the tags and the internet say.";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                    FormField {
                        label: "Name";
                        placeholder: root.draft.artist;
                        text <=> root.name;
                    }
                    FormField {
                        label: "Sort name";
                        placeholder: root.name != "" ? root.name : root.draft.artist;
                        hint: "Artists are ordered by this: \"Beatles, The\".";
                        text <=> root.sort-name;
                    }
                    FormField {
                        label: "MusicBrainz ID";
                        placeholder: root.draft.found-mbid != "" ? root.draft.found-mbid : "Found from the name";
                        hint: "Which artist fanart.tv's pictures are of. Set it when the one found is someone else.";
                        text <=> root.mbid;
                    }
                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Biography";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        Rectangle {
                            height: 200px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: biography-input.has-focus ? Theme.accent : Theme.divider;
                            background: Theme.background;
                            clip: true;

                            if biography-input.text == "": Text {
                                x: 10px;
                                y: 9px;
                                text: "No biography";
                                font-size: 13px;
                                color: Theme.text-secondary;
                            }
                            ScrollView {
                                VerticalLayout {
                                    padding: 9px;
                                    padding-left: 10px;
                                    padding-right: 10px;

                                    biography-input := TextInput {
                                        text <=> root.biography;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-size: 13px;
                                        color: Theme.text;
                                        selection-background-color: Theme.selection;
                                        selection-foreground-color: Theme.text;
                                        accessible-role: text-input;
                                        accessible-label: "Biography";
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.draft.biography-from != ""
                                ? "From " + root.draft.biography-from + ". Change it to make it yours: it is then shown in its place, and the internet is not asked for it again. Empty, " + root.draft.biography-from + "'s is shown."
                                : "Yours, shown in place of what Wikipedia and Last.fm say. Empty, theirs is shown again.";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
        HorizontalLayout {
            padding: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 8px;
            alignment: end;

            TextButton {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            TextButton {
                text: "Save Changes";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}

/// Asks for the user's personal fanart.tv API key, or takes it away.
component FanartKeyForm inherits MenuSurface {
    callback closed();

    function save() {
        if (input.text != "") {
            Library.set-fanart-key(input.text);
            root.closed();
        }
    }

    init => { input.focus(); }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        VerticalLayout {
            spacing: 4px;

            Text {
                text: "fanart.tv API key";
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: "With your personal key, the top of an artist's page shows a wide picture of them from fanart.tv. The key is free with a fanart.tv account. fanart.tv is told the artists' MusicBrainz ids; MusicBrainz is told the names of artists whose tags lack them.";
                font-size: 13px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;

                Text {
                    text: "Get a personal API key at fanart.tv";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.accent-text;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.open-link("fanart-key"); }
                    }
                }
            }
        }
        Rectangle {
            height: 34px;
            border-radius: 8px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.divider;
            background: Theme.background;

            if input.text == "": Text {
                x: 10px;
                height: parent.height;
                text: Library.fanart-key == "" ? "Personal API key" : "A key is saved; paste another to replace it";
                font-size: 13px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                input-type: password;
                single-line: true;
                font-size: 13px;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: "fanart.tv personal API key";
                accepted => { root.save(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;

            if Library.fanart-key != "": TextButton {
                text: "Remove Key";
                clicked => {
                    Library.set-fanart-key("");
                    root.closed();
                }
            }
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                text: "Cancel";
                clicked => { root.closed(); }
            }
            TextButton {
                text: "Save";
                primary: true;
                clicked => { root.save(); }
            }
        }
    }
}

component UpdateForm inherits MenuSurface {
    callback closed();

    property <string> state: Updates.state;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: state == "checking" ? "Looking for updates…"
                : state == "up-to-date" ? "Freya is up to date"
                : state == "available" ? "Freya " + Updates.version + " is available"
                : state == "downloading" ? "Downloading Freya " + Updates.version + "…"
                : state == "installed" ? "Restarting into Freya " + Updates.version + "…"
                : state == "failed" ? "The update did not work"
                : "Updates";
            font-size: 15px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: state == "up-to-date" ? "Version " + Updates.current-version + " is the newest."
                : state == "available" ? "You have " + Updates.current-version + "." + (Updates.can-install ? "" : " Download the new version from its release page.")
                : state == "failed" ? Updates.error
                : "";
            visible: self.text != "";
            font-size: 13px;
            color: state == "failed" ? Theme.danger : Theme.text-secondary;
            wrap: word-wrap;
        }
        if state == "available" && Updates.notes != "": Rectangle {
            height: 180px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.divider;

            ScrollView {
                VerticalLayout {
                    padding: 10px;

                    Text {
                        text: Updates.notes;
                        font-size: 13px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
        if state == "downloading": Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.track;

            Rectangle {
                x: 0;
                width: parent.width * max(0, min(1, Updates.progress));
                border-radius: 3px;
                background: Theme.accent;
            }
        }
        if state == "available": HorizontalLayout {
            spacing: 8px;

            TextButton {
                text: "Skip This Version";
                clicked => {
                    Updates.skip();
                    root.closed();
                }
            }
            Rectangle { horizontal-stretch: 1; }
            TextButton {
                text: "Later";
                clicked => {
                    Updates.later();
                    root.closed();
                }
            }
            TextButton {
                text: Updates.can-install ? "Install and Restart" : "Download";
                primary: true;
                clicked => {
                    Updates.install();
                    if (!Updates.can-install) {
                        root.closed();
                    }
                }
            }
        }
        if state == "checking" || state == "up-to-date" || state == "failed" || state == "idle": HorizontalLayout {
            alignment: end;

            TextButton {
                text: "Close";
                clicked => { root.closed(); }
            }
        }
    }
}

/// Empty room in the window's top bar, when the skin draws into the title bar: pressing it
/// moves the window, and a double click zooms it, as on a title bar.
component TitleBarArea inherits TouchArea {
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left && App.window-buttons-width > 0) {
            App.drag-window();
        }
    }
}

/// Back and forward through where the window has been, as in a web browser: at the top left,
/// after the window buttons.
component NavButtons inherits HorizontalLayout {
    spacing: 2px;

    IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.back;
        stroked: true;
        size: 32px;
        label: "Back";
        tooltip: Platform.os == OperatingSystemType.macos ? "Back (⌘[)" : "Back (Alt+←)";
        enabled: App.can-go-back;
        clicked => { App.go-back(); }
    }
    IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron;
        stroked: true;
        size: 32px;
        label: "Forward";
        tooltip: Platform.os == OperatingSystemType.macos ? "Forward (⌘])" : "Forward (Alt+→)";
        enabled: App.can-go-forward;
        clicked => { App.go-forward(); }
    }
}

component Sidebar inherits Rectangle {
    in property <string> view;
    /// A view chosen: "radio", "queue", "playlist", "visualizer" or "equalizer".
    callback selected(string);
    /// A library section chosen: "songs", "albums", "artists", "genres", "recently-added",
    /// "recently-played" or "most-played".
    callback show-section(string);
    /// The note that an update is available was clicked.
    callback show-update();

    background: Theme.sidebar;

    VerticalLayout {
        // The window buttons, when the skin draws into the title bar, then back and forward;
        // empty room there moves the window, as a title bar would. Under the system's own
        // title bar, back and forward have a row of their own.
        Rectangle {
            height: App.window-buttons-width > 0 ? App.title-bar-height : 48px;

            if App.window-buttons-width > 0: TitleBarArea { }
            HorizontalLayout {
                padding-left: App.window-buttons-width > 0 ? App.window-buttons-width : 10px;
                alignment: start;

                NavButtons { }
            }
        }
        // All of it scrolls when the window is too low for everything, playlists included.
        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;

            VerticalLayout {
                padding: 10px;
                padding-top: 6px;
                spacing: 2px;
                alignment: start;

                SidebarHeading { text: "Library"; }
                SidebarItem {
                    icon: Icons.note;
                    text: "Songs";
                    selected: root.view == "library" && Library.section == "songs";
                    clicked => { root.show-section("songs"); }
                }
                SidebarItem {
                    icon: Icons.album;
                    text: "Albums";
                    selected: root.view == "library" && Library.section == "albums";
                    clicked => { root.show-section("albums"); }
                }
                SidebarItem {
                    icon: Icons.artist;
                    text: "Artists";
                    selected: root.view == "library" && Library.section == "artists";
                    clicked => { root.show-section("artists"); }
                }
                SidebarItem {
                    icon: Icons.genre;
                    text: "Genres";
                    selected: root.view == "library" && Library.section == "genres";
                    clicked => { root.show-section("genres"); }
                }
                SidebarHeading { text: "Recents"; }
                SidebarItem {
                    icon: Icons.added;
                    text: "Recently Added";
                    selected: root.view == "library" && Library.section == "recently-added";
                    clicked => { root.show-section("recently-added"); }
                }
                SidebarItem {
                    icon: Icons.clock;
                    text: "Recently Played";
                    selected: root.view == "library" && Library.section == "recently-played";
                    clicked => { root.show-section("recently-played"); }
                }
                SidebarItem {
                    icon: Icons.star;
                    text: "Most Played";
                    selected: root.view == "library" && Library.section == "most-played";
                    clicked => { root.show-section("most-played"); }
                }
                SidebarHeading { text: "Radio"; }
                SidebarItem {
                    icon: Icons.radio;
                    text: "Stations";
                    selected: root.view == "radio";
                    clicked => { root.selected("radio"); }
                }
                SidebarHeading { text: "Queue"; }
                SidebarItem {
                    icon: Icons.queue;
                    text: "Up Next";
                    badge: Playlist.rows.length > 0 ? "" + Playlist.rows.length : "";
                    selected: root.view == "queue";
                    clicked => { root.selected("queue"); }
                }
                SidebarHeading { text: "Sound"; }
                SidebarItem {
                    icon: Icons.spectrum;
                    text: "Visualizer";
                    selected: root.view == "visualizer";
                    clicked => { root.selected("visualizer"); }
                }
                SidebarItem {
                    icon: Icons.sliders;
                    text: "Equalizer";
                    selected: root.view == "equalizer";
                    clicked => { root.selected("equalizer"); }
                }
                playlists-heading := SidebarHeading {
                    text: "Playlists";
                    add-label: "New playlist";
                    add => { new-playlist.show(); }
                }
                for playlist[i] in Playlists.playlists: SidebarItem {
                    icon: Icons.playlist;
                    text: playlist.name;
                    badge: playlist.count;
                    selected: root.view == "playlist" && Playlists.shown == i;
                    clicked => {
                        Playlists.show(i);
                        root.selected("playlist");
                    }
                }
            }
        }
        if Updates.state == "available" || Updates.state == "downloading": VerticalLayout {
            padding: 10px;
            padding-bottom: 0;

            Rectangle {
                height: 34px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.divider;
                background: pill-touch.has-hover ? Theme.hover : Theme.surface;
                accessible-role: button;
                accessible-label: pill-text.text;
                accessible-action-default => { root.show-update(); }

                pill-text := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: Updates.state == "downloading" ? "Downloading Freya " + Updates.version + "…"
                        : "Freya " + Updates.version + " is available";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.accent-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                pill-touch := TouchArea {
                    clicked => { root.show-update(); }
                }
            }
        }
    }

    new-playlist := PopupWindow {
        x: 10px;
        // The heading moves as the navigation scrolls.
        y: playlists-heading.absolute-position.y - root.absolute-position.y + playlists-heading.height;
        width: 300px;
        close-policy: close-on-click-outside;

        PlaylistNameForm {
            title: "New playlist";
            action: "Create";
            submit(name) => { Playlists.create(name); }
            saved => {
                new-playlist.close();
                root.selected("playlist");
            }
            cancelled => { new-playlist.close(); }
        }
    }
}

/// One of a few choices, like the visualization's modes.
component ChoiceButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    height: 30px;
    width: label.preferred-width + 24px;
    border-radius: 6px;
    background: selected ? Theme.selection : (touch.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        color: Theme.text;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Below the visualization in full screen: what plays, in letters large enough to read on a TV
/// across the room, and the controls, which show while the mouse moves.
component StageBar inherits Rectangle {
    in property <bool> controls-shown;
    in property <bool> queue-open;
    callback toggle-queue();
    callback leave();

    height: 112px;

    // What plays: the whole width while the controls are hidden, so a long title shows.
    HorizontalLayout {
        x: 0;
        width: root.controls-shown ? root.width - controls.width - 32px : root.width;
        height: root.height;
        spacing: 24px;

        Rectangle {
            width: 112px;
            height: 112px;
            border-radius: 10px;
            clip: true;
            background: Theme.surface;

            if Player.has-cover: Image {
                width: parent.width;
                height: parent.height;
                source: Player.cover;
                image-fit: cover;
            }
            if !Player.has-cover: Icon {
                width: 48px;
                height: 48px;
                data: Icons.note;
                stroked: true;
                color: Theme.text-secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            min-width: 0;

            Text {
                text: Player.title == "" ? "Nothing playing" : Player.title;
                font-size: 34px;
                font-weight: 700;
                color: Player.title == "" ? Theme.text-secondary : Theme.text;
                overflow: elide;
            }
            if Player.artist != "" || Player.album != "": Text {
                text: Player.artist != "" && Player.album != "" ? Player.artist + " – " + Player.album
                    : Player.artist + Player.album;
                font-size: 22px;
                color: Theme.text-secondary;
                overflow: elide;
            }
            // The time is drawn over this, outside the layout (see below).
            time-slot := Rectangle { height: 20px; }
        }
    }

    // The time changes every second; inside the layout, each change would lay out the whole
    // view again and redraw the visualization's box.
    if Player.live || Player.length > 0: Text {
        x: time-slot.absolute-position.x - root.absolute-position.x;
        y: time-slot.absolute-position.y - root.absolute-position.y;
        // Room for "10:00:00 / 10:00:00"; only this much is redrawn each second.
        width: min(time-slot.width, 200px);
        height: time-slot.height;
        text: Player.live ? "Live" : Player.position-text + " / " + Player.length-text;
        font-size: 16px;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }

    // The controls fade out while the mouse rests, and the pointer hides with them.
    controls := Rectangle {
        x: root.width - self.width;
        width: self.preferred-width;
        height: root.height;
        background: #000000;
        opacity: root.controls-shown ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 200ms; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 6px;

                    IconButton {
                        icon: Icons.previous;
                        size: 44px;
                        label: "Previous";
                        tooltip: "Previous track (P)";
                        clicked => { Player.previous(); }
                    }
                    IconButton {
                        size: 56px;
                        primary: true;
                        icon: Player.state == PlaybackState.playing ? Icons.pause : Icons.play;
                        label: Player.state == PlaybackState.playing ? "Pause" : "Play";
                        tooltip: self.label + " (Space)";
                        clicked => { Player.toggle-pause(); }
                    }
                    IconButton {
                        icon: Icons.stop;
                        size: 44px;
                        label: "Stop";
                        tooltip: "Stop (S)";
                        clicked => { Player.stop(); }
                    }
                    IconButton {
                        icon: Icons.next;
                        size: 44px;
                        label: "Next";
                        tooltip: "Next track (N)";
                        clicked => { Player.next(); }
                    }
                }
            }
            Rectangle { width: 12px; }
            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle {
                        width: 24px;

                        Icon {
                            width: 22px;
                            height: 22px;
                            data: Icons.speaker;
                            color: Theme.text-secondary;
                        }
                        Icon {
                            width: 22px;
                            height: 22px;
                            data: Icons.waves;
                            stroked: true;
                            color: Theme.text-secondary;
                        }
                    }
                    VerticalLayout {
                        alignment: center;

                        Slider {
                            width: 140px;
                            label: "Volume";
                            value: Player.volume;
                            changed(v) => { Player.set-volume(v); }
                        }
                    }
                }
            }
            Rectangle { width: 12px; }
            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 4px;

                    ChoiceButton {
                        text: "Spectrum";
                        selected: Visualizer.mode == "spectrum";
                        clicked => { Visualizer.set-mode("spectrum"); }
                    }
                    ChoiceButton {
                        text: "Oscilloscope";
                        selected: Visualizer.mode == "oscilloscope";
                        clicked => { Visualizer.set-mode("oscilloscope"); }
                    }
                    ChoiceButton {
                        text: "Hologram";
                        selected: Visualizer.mode == "hologram";
                        clicked => { Visualizer.set-mode("hologram"); }
                    }
                }
            }
            Rectangle { width: 12px; }
            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: Icons.queue;
                    stroked: true;
                    size: 44px;
                    label: "Up Next";
                    tooltip: root.queue-open ? "Hide Up Next" : "Show Up Next";
                    checkable: true;
                    checked: root.queue-open;
                    clicked => { root.toggle-queue(); }
                }
            }
            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: Icons.shrink;
                    stroked: true;
                    size: 44px;
                    label: "Leave full screen";
                    tooltip: "Leave full screen (Esc)";
                    clicked => { root.leave(); }
                }
            }
        }
    }
}

/// The visualization view: the spectrum, oscilloscope or hologram, as large as the window
/// allows. Full screen (`stage`), for a TV, it shows what plays below it in large letters, and
/// the controls while the mouse moves.
component VisualizerView inherits Rectangle {
    /// Whether this view is the one shown. Freya computes nothing for it while it is not.
    in property <bool> shown;
    /// Whether it fills the screen.
    in property <bool> stage;
    /// Fill the screen, or leave it: double-clicking the visualization or the controls.
    callback toggle-stage();

    property <length> pad: 16px;
    /// Whether the controls show in full screen: for a few seconds after the mouse moved.
    property <bool> awake: true;
    property <bool> queue-open;
    property <MouseCursor> cursor: root.stage && !root.awake ? MouseCursor.none : MouseCursor.default;

    init => { Visualizer.showing = root.shown; }
    changed shown => { Visualizer.showing = root.shown; }
    changed stage => {
        root.queue-open = false;
        root.wake();
    }

    function wake() {
        root.awake = true;
        // A stop and a start in one go left the timer running from its first start.
        if (root.stage) {
            idle.restart();
        } else {
            idle.stop();
        }
    }

    visible: shown;
    background: root.stage ? #000000 : transparent;

    idle := Timer {
        interval: 3s;
        running: false;
        triggered => {
            root.awake = false;
            idle.stop();
        }
    }

    // Follows the mouse over everything in the view, buttons included.
    mouse := TouchArea {
        mouse-cursor: root.cursor;
        changed mouse-x => { root.wake(); }
        changed mouse-y => { root.wake(); }

        VerticalLayout {
            padding: root.stage ? 48px : 24px;
            spacing: 32px;

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 24px;

                box := Rectangle {
                    horizontal-stretch: 1;
                    border-radius: root.stage ? 16px : 12px;
                    clip: true;
                    background: root.stage ? #0c0d10 : Theme.surface;

                    // About one bar per 14 px, so wide windows get more detail.
                    init => { Visualizer.bar-count = max(16, min(128, floor(self.width / 14px))); }
                    changed width => { Visualizer.bar-count = max(16, min(128, floor(self.width / 14px))); }

                    // Drawn by Freya on top of the window where it can, which saves redrawing
                    // the window for every frame.
                    if Visualizer.mode == "spectrum": NativeSpectrum {
                        x: root.pad;
                        y: root.pad;
                        width: box.width - 2 * root.pad;
                        height: box.height - 2 * root.pad;
                        shown: root.shown;
                        bar-color: Theme.accent;
                        peak-color: Theme.accent-text;
                        peak-thickness: 3px;
                        background-color: box.background;
                    }
                    if Visualizer.mode == "oscilloscope" && Visualizer.oscilloscope-drawing: NativeOscilloscope {
                        x: root.pad;
                        y: root.pad;
                        width: box.width - 2 * root.pad;
                        height: box.height - 2 * root.pad;
                        shown: root.shown;
                        line-color: Theme.accent;
                        line-width: root.stage ? 3px : 2px;
                        background: transparent;
                    }
                    if Visualizer.mode == "oscilloscope" && !Visualizer.oscilloscope-drawing: Path {
                        x: root.pad;
                        y: root.pad;
                        width: box.width - 2 * root.pad;
                        height: box.height - 2 * root.pad;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        commands: Visualizer.wave(self.width / 1px, self.height / 1px, Visualizer.waveform);
                        stroke: Theme.accent;
                        stroke-width: root.stage ? 3px : 2px;
                        fill: transparent;
                    }
                    // Drawn by Freya with the graphics card, filling the box.
                    if Visualizer.mode == "hologram": NativeHologram {
                        width: box.width;
                        height: box.height;
                        border-radius: box.border-radius;
                        shown: root.shown;
                    }
                    if Visualizer.mode == "hologram" && !Visualizer.hologram-drawing: Text {
                        text: "The hologram is only drawn on macOS so far";
                        font-size: 16px;
                        color: #b0b0b0;
                    }
                    if Visualizer.mode == "off": Text {
                        text: "Visualization is off";
                        font-size: 16px;
                        color: Theme.text-secondary;
                    }
                    // In the upper half, so it stays clear of the bars along the bottom.
                    if (Visualizer.mode == "spectrum" || Visualizer.mode == "oscilloscope") && Player.state == PlaybackState.stopped: Text {
                        y: box.height / 3;
                        width: box.width;
                        text: "Play something to see it here";
                        font-size: 16px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }

                    TouchArea {
                        mouse-cursor: root.cursor;
                        double-clicked => { root.toggle-stage(); }
                    }
                }
                if root.stage && root.queue-open: Rectangle {
                    width: 420px;
                    border-radius: 16px;
                    clip: true;
                    background: Theme.surface;

                    VerticalLayout {
                        padding-top: 12px;
                        spacing: 4px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 8px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: "Up Next";
                                    font-size: 20px;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                Text {
                                    text: Playlist.summary;
                                    font-size: 13px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }
                            IconButton {
                                icon: Icons.close;
                                stroked: true;
                                size: 36px;
                                label: "Hide Up Next";
                                clicked => { root.queue-open = false; }
                            }
                        }
                        TrackList {
                            vertical-stretch: 1;
                        }
                    }
                }
            }
            if root.stage: StageBar {
                controls-shown: root.awake;
                queue-open: root.queue-open;
                toggle-queue => { root.queue-open = !root.queue-open; }
                leave => { root.toggle-stage(); }
            }
        }
    }
}

/// A group of settings under a bold heading, straight on the page.
component SettingsSection inherits VerticalLayout {
    in property <string> title;

    spacing: 4px;

    if root.title != "": Text {
        text: root.title;
        font-size: 17px;
        font-weight: 700;
        color: Theme.text;
    }
    @children
}

/// One setting: what it is on the left, with an explanation below when it needs one, and its
/// control at the far right.
component SettingsRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;

    min-height: 44px;
    spacing: 24px;

    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 160px;
        padding-top: 8px;
        padding-bottom: 8px;
        alignment: center;
        spacing: 3px;

        if root.label != "": Text {
            text: root.label;
            font-size: 14px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 6px;
        padding-bottom: 6px;

        @children
    }
}

/// A link to one of Freya's pages, opened in the browser.
component LinkRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    callback clicked;

    height: 40px;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;

            Icon {
                width: 18px;
                height: 18px;
                data: root.icon;
                stroked: true;
                color: Theme.text-secondary;
            }
        }
        Text {
            text: root.text;
            font-size: 14px;
            color: touch.has-hover ? Theme.accent-text : Theme.text-secondary;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;

            Icon {
                width: 14px;
                height: 14px;
                data: Icons.external;
                stroked: true;
                color: Theme.text-secondary;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A page of settings with a large title, using the view's width, and scrolling.
component SettingsPage inherits ScrollView {
    in property <string> title;

    VerticalLayout {
        alignment: start;
        padding-top: 28px;
        padding-bottom: 40px;
        padding-left: 40px;
        // Very wide windows keep the controls within reach of what they set.
        padding-right: max(40px, root.visible-width - 40px - 1200px);
        spacing: 32px;

        Text {
            text: root.title;
            font-size: 32px;
            font-weight: 800;
            color: Theme.text;
        }
        @children
    }
}

/// Settings: appearance, the music folders, the visualization and the skin.
component SettingsView inherits Rectangle {
    /// Open the dialog for the library's folders, or for the fanart.tv key.
    callback manage-folders();
    callback edit-fanart-key();

    SettingsPage {
        width: 100%;
        height: 100%;
        title: "Settings";

        SettingsSection {
            title: "Appearance";

            SettingsRow {
                label: "Color scheme";
                detail: "System follows the light or dark mode of your computer.";

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 4px;

                        ChoiceButton {
                            text: "System";
                            selected: App.theme == "system";
                            clicked => { App.set-theme("system"); }
                        }
                        ChoiceButton {
                            text: "Light";
                            selected: App.theme == "light";
                            clicked => { App.set-theme("light"); }
                        }
                        ChoiceButton {
                            text: "Dark";
                            selected: App.theme == "dark";
                            clicked => { App.set-theme("dark"); }
                        }
                    }
                }
            }
            SettingsRow {
                label: "Skin";
                detail: "How Freya looks: this one, or one of your own.";

                VerticalLayout {
                    alignment: center;

                    TextButton {
                        text: "Choose Skin…";
                        clicked => { App.show-skins(); }
                    }
                }
            }
        }

        SettingsSection {
            title: "Library";

            if Library.folders.length == 0: SettingsRow {
                label: "No music folders yet. Freya lists the music in them by artist and album.";
            }
            for folder[i] in Library.folders: SettingsRow {
                label: folder;

                if !Library.scanning: VerticalLayout {
                    alignment: center;

                    TextButton {
                        text: "Scan";
                        clicked => { Library.scan-one-folder(i); }
                    }
                }
            }
            SettingsRow {
                label: Library.scanning ? Library.status
                    : "Freya scans the folders each time it starts: it reads new and changed files, makes their albums' covers, takes in the pictures in artists' folders, and asks the internet for what artists lack, as allowed below.";

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        if Library.scanning: TextButton {
                            text: "Stop";
                            clicked => { Library.stop-scan(); }
                        }
                        if !Library.scanning: TextButton {
                            text: "Scan";
                            clicked => { Library.rescan(); }
                        }
                        TextButton {
                            text: "Manage Folders…";
                            clicked => { root.manage-folders(); }
                        }
                    }
                }
            }
            SettingsRow {
                label: "Rescan files";
                detail: "Reads every file and makes every album cover again, changed or not. Takes longer; for tags or covers that changed without the files' dates. Pictures and what the internet said of artists stay as they are.";

                if !Library.scanning: VerticalLayout {
                    alignment: center;

                    TextButton {
                        text: "Rescan";
                        clicked => { Library.rescan-files(); }
                    }
                }
            }
        }

        SettingsSection {
            title: "Artists";

            SettingsRow {
                label: "A scan asks the internet only about artists who lack something. A picture an artist has stays theirs until you change it.";
            }
            SettingsRow {
                label: "Artist biographies from Last.fm";
                detail: "What Last.fm's listeners wrote about each artist, on their page. Last.fm is told the artists' names.";

                VerticalLayout {
                    alignment: center;

                    Toggle {
                        label: "Artist biographies from Last.fm";
                        checked: Library.artist-bios-online;
                        toggled => { Library.set-artist-bios-online(!Library.artist-bios-online); }
                    }
                }
            }
            SettingsRow {
                label: "Artist biographies from Wikipedia";
                detail: "The opening of the artist's Wikipedia article, before what Last.fm says. MusicBrainz, Wikidata and Wikipedia are told the artist's MusicBrainz id and article.";

                VerticalLayout {
                    alignment: center;

                    Toggle {
                        label: "Artist biographies from Wikipedia";
                        checked: Library.artist-wikipedia-online;
                        toggled => { Library.set-artist-wikipedia-online(!Library.artist-wikipedia-online); }
                    }
                }
            }
            SettingsRow {
                label: "Artist pictures from Deezer";
                detail: "For artists without a picture in their folder (artist.jpg) or from fanart.tv. Deezer is told the artists' names. Without one, their album covers stand in.";

                VerticalLayout {
                    alignment: center;

                    Toggle {
                        label: "Artist pictures from Deezer";
                        checked: Library.artist-pictures-online;
                        toggled => { Library.set-artist-pictures-online(!Library.artist-pictures-online); }
                    }
                }
            }
            SettingsRow {
                label: "Artist pictures from fanart.tv";
                detail: Library.fanart-key == "" ? "Add your personal fanart.tv API key for pictures of artists, and a wide one across the top of their page. Pictures in the artist's folder (artist.jpg, fanart.jpg) come first."
                    : "Your personal API key is saved. Pictures in the artist's folder (artist.jpg, fanart.jpg) come first.";

                VerticalLayout {
                    alignment: center;

                    TextButton {
                        text: Library.fanart-key == "" ? "Add Key…" : "Change Key…";
                        clicked => { root.edit-fanart-key(); }
                    }
                }
            }
        }

        SettingsSection {
            title: "Last.fm";

            if LastFm.state == "unavailable": SettingsRow {
                label: "Scrobbling is not available in this build of Freya.";
                detail: "Release builds have it; a build made without Freya's Last.fm API key does not.";
            }
            if LastFm.state == "disconnected": SettingsRow {
                label: "Scrobble what you play to your Last.fm profile";
                detail: LastFm.error != "" ? LastFm.error
                    : "Tracks count once heard for half their length or four minutes. Radio is never scrobbled.";

                VerticalLayout {
                    alignment: center;

                    TextButton {
                        text: "Connect…";
                        primary: true;
                        clicked => { LastFm.connect(); }
                    }
                }
            }
            if LastFm.state == "authorizing": SettingsRow {
                label: "Allow Freya on the Last.fm page that opened in your browser";
                detail: "Freya connects by itself once you have.";

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        TextButton {
                            text: "Open the Page Again";
                            clicked => { LastFm.connect(); }
                        }
                        TextButton {
                            text: "Cancel";
                            clicked => { LastFm.cancel(); }
                        }
                    }
                }
            }
            if LastFm.state == "connected": SettingsRow {
                label: "Connected as " + LastFm.user;

                VerticalLayout {
                    alignment: center;

                    TextButton {
                        text: "Disconnect";
                        clicked => { LastFm.disconnect(); }
                    }
                }
            }
            if LastFm.state == "connected": SettingsRow {
                label: "Scrobble what you play";
                detail: LastFm.error != "" ? LastFm.error
                    : LastFm.waiting == 1 ? "1 play waits to be sent."
                    : LastFm.waiting > 1 ? LastFm.waiting + " plays wait to be sent."
                    : "";

                VerticalLayout {
                    alignment: center;

                    Toggle {
                        label: "Scrobble what you play";
                        checked: LastFm.scrobbling;
                        toggled => { LastFm.set-scrobbling(!LastFm.scrobbling); }
                    }
                }
            }
        }

        SettingsSection {
            title: "Visualizer";

            SettingsRow {
                label: "Visualization";

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 4px;

                        ChoiceButton {
                            text: "Spectrum";
                            selected: Visualizer.mode == "spectrum";
                            clicked => { Visualizer.set-mode("spectrum"); }
                        }
                        ChoiceButton {
                            text: "Oscilloscope";
                            selected: Visualizer.mode == "oscilloscope";
                            clicked => { Visualizer.set-mode("oscilloscope"); }
                        }
                        ChoiceButton {
                            text: "Hologram";
                            selected: Visualizer.mode == "hologram";
                            clicked => { Visualizer.set-mode("hologram"); }
                        }
                        ChoiceButton {
                            text: "Off";
                            selected: Visualizer.mode == "off";
                            clicked => { Visualizer.set-mode("off"); }
                        }
                    }
                }
            }
            SettingsRow {
                label: "Frame rate";
                detail: "60 moves more smoothly and uses a little more power. The hologram always draws 60.";

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 4px;

                        ChoiceButton {
                            text: "30 fps";
                            selected: Visualizer.fps == 30;
                            clicked => { Visualizer.set-fps(30); }
                        }
                        ChoiceButton {
                            text: "60 fps";
                            selected: Visualizer.fps == 60;
                            clicked => { Visualizer.set-fps(60); }
                        }
                    }
                }
            }
        }
    }
}

/// About Freya: its icon and version, updates, links to its pages, and the credits.
component AboutView inherits Rectangle {
    /// Show the update's notes, and install it.
    callback show-update();

    property <string> state: Updates.state;

    SettingsPage {
        width: 100%;
        height: 100%;
        title: "About Freya";

        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            Image {
                width: 88px;
                height: 88px;
                source: @image-url("freya-icon.png");
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;

                Text {
                    text: "Freya";
                    font-size: 22px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: "Version " + App.version + (App.build-date != "" ? " · built " + App.build-date : "");
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
                Text {
                    text: "A music player you can make look your own.";
                    font-size: 13px;
                    color: Theme.text-secondary;
                }
            }
        }

        SettingsSection {
            title: "Updates";

            SettingsRow {
                label: root.state == "checking" ? "Looking for updates…"
                    : root.state == "up-to-date" ? "Freya is up to date."
                    : root.state == "available" ? "Freya " + Updates.version + " is available."
                    : root.state == "downloading" ? "Downloading Freya " + Updates.version + "…"
                    : root.state == "installed" ? "Restarting into Freya " + Updates.version + "…"
                    : root.state == "failed" ? "The update did not work."
                    : "Not checked yet.";
                detail: root.state == "failed" ? Updates.error : "";

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        if root.state == "available": TextButton {
                            text: "Release Notes";
                            clicked => { App.open-link("releases"); }
                        }
                        if root.state == "available": TextButton {
                            text: "Update…";
                            primary: true;
                            clicked => { root.show-update(); }
                        }
                        TextButton {
                            text: "Check for Updates";
                            clicked => { Updates.check(); }
                        }
                    }
                }
            }
            SettingsRow {
                label: "Check for updates automatically";
                detail: "When Freya starts and once a day. Updates are only installed when you ask.";

                VerticalLayout {
                    alignment: center;

                    Toggle {
                        label: "Check for updates automatically";
                        checked: Updates.check-automatically;
                        toggled => { Updates.set-check-automatically(!Updates.check-automatically); }
                    }
                }
            }
        }

        SettingsSection {
            title: "Links";

            LinkRow {
                icon: Icons.code;
                text: "GitHub";
                clicked => { App.open-link("github"); }
            }
            LinkRow {
                icon: Icons.document;
                text: "Release Notes";
                clicked => { App.open-link("releases"); }
            }
            LinkRow {
                icon: Icons.bubble;
                text: "Report an Issue";
                clicked => { App.open-link("issues"); }
            }
            LinkRow {
                icon: Icons.check;
                text: "License";
                clicked => { App.open-link("license"); }
            }
        }

        SettingsSection {
            title: "Made with";

            HorizontalLayout {
                alignment: start;

                AboutSlint {
                    width: 240px;
                    height: 130px;
                }
            }
            Text {
                text: "© 2026 Alexander Vikman. MIT or Apache-2.0.";
                font-size: 12px;
                color: Theme.text-secondary;
            }
        }
    }
}

/// The bar above the content: the navigation button, back, the view's title and actions,
/// search, and the menu.
component Toolbar inherits HorizontalLayout {
    /// Room kept free at the left, for the window buttons.
    in property <length> inset;
    /// An album's page shows its name and buttons itself: here only once they scrolled away.
    property <bool> page-head-shown: root.view == "library"
        && ((Library.album-page.shown && App.scroll < 300px) || (Library.artist-page.shown && App.scroll < 340px));
    /// Whether back and forward show here: while the navigation, their own place, is hidden.
    in property <bool> nav-buttons;
    in property <string> view;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> can-go-back;
    callback toggle-sidebar();
    callback back();
    callback search-edited();
    callback search-accepted();
    /// After a playlist was made from Up Next ("playlist") or deleted ("queue").
    callback show-view(string);
    /// "Check for Updates…" in the menu.
    callback check-updates();
    /// Show the visualizer full screen.
    callback full-screen();
    /// "Library Folders…" in the menu.
    callback manage-folders();

    /// What the name form is for: keeping Up Next as a playlist, or renaming one.
    property <string> naming: "save-queue";

    public function focus-search() {
        search.focus();
    }

    /// Opens the form for a new radio station.
    public function add-station() {
        station-popup.show();
    }

    height: 56px;
    padding-left: max(10px, root.inset);
    padding-right: 12px;
    spacing: 6px;

    // Back and forward live in the navigation; with it hidden, here in its place.
    if root.nav-buttons: NavButtons { }
    IconButton {
        icon: Icons.sidebar;
        stroked: true;
        size: 36px;
        label: "Navigation";
        tooltip: "Show or hide the navigation";
        clicked => { root.toggle-sidebar(); }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        min-width: 0;
        alignment: center;
        padding-left: 6px;
        spacing: 3px;

        opacity: root.page-head-shown ? 0 : 1;
        animate opacity { duration: 150ms; }

        Text {
            text: root.title;
            font-size: 17px;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.text-secondary;
            overflow: elide;
        }
    }

    // The view's own actions.
    if root.view == "queue": IconButton {
        icon: Icons.plus;
        stroked: true;
        size: 36px;
        label: "Add files";
        tooltip: "Add files";
        clicked => { Playlist.add-files(); }
    }
    if root.view == "queue": IconButton {
        icon: Icons.folder-plus;
        stroked: true;
        size: 36px;
        label: "Add folder";
        clicked => { Playlist.add-folder(); }
    }
    if root.view == "queue": IconButton {
        icon: Icons.trash;
        stroked: true;
        size: 36px;
        label: "Remove selected";
        tooltip: "Remove the selected tracks";
        clicked => { Playlist.remove-selected(); }
    }
    if root.view == "radio": IconButton {
        icon: Icons.plus;
        stroked: true;
        size: 36px;
        label: "Add a station";
        clicked => { root.add-station(); }
    }
    if root.view == "library" && Library.can-go-back && Library.rows.length > 0 && !root.page-head-shown: VerticalLayout {
        alignment: center;

        TextButton {
            text: "Play";
            clicked => { Library.play-all(); }
        }
    }
    if root.view == "library" && Library.can-go-back && Library.rows.length > 0 && !root.page-head-shown: VerticalLayout {
        alignment: center;

        TextButton {
            text: "Add to Up Next";
            clicked => { Library.enqueue-all(); }
        }
    }
    if root.view == "playlist" && Playlists.tracks.length > 0: VerticalLayout {
        alignment: center;

        TextButton {
            text: "Play";
            clicked => { Playlists.play(0); }
        }
    }
    if root.view == "playlist" && Playlists.tracks.length > 0: VerticalLayout {
        alignment: center;

        TextButton {
            text: "Add to Up Next";
            clicked => { Playlists.enqueue(); }
        }
    }
    if root.view == "visualizer": VerticalLayout {
        alignment: center;

        ChoiceButton {
            text: "Spectrum";
            selected: Visualizer.mode == "spectrum";
            clicked => { Visualizer.set-mode("spectrum"); }
        }
    }
    if root.view == "visualizer": VerticalLayout {
        alignment: center;

        ChoiceButton {
            text: "Oscilloscope";
            selected: Visualizer.mode == "oscilloscope";
            clicked => { Visualizer.set-mode("oscilloscope"); }
        }
    }
    if root.view == "visualizer": VerticalLayout {
        alignment: center;

        ChoiceButton {
            text: "Hologram";
            selected: Visualizer.mode == "hologram";
            clicked => { Visualizer.set-mode("hologram"); }
        }
    }
    if root.view == "visualizer": VerticalLayout {
        alignment: center;

        ChoiceButton {
            text: "Off";
            selected: Visualizer.mode == "off";
            clicked => { Visualizer.set-mode("off"); }
        }
    }
    if root.view == "visualizer": IconButton {
        icon: Icons.expand;
        stroked: true;
        size: 36px;
        label: "Full screen";
        tooltip: "Full screen (F)";
        clicked => { root.full-screen(); }
    }

    VerticalLayout {
        alignment: center;
        padding-left: 8px;

        search := SearchField {
            width: 240px;
            edited => { root.search-edited(); }
            accepted => { root.search-accepted(); }
        }
    }
    activity := IconButton {
        icon: Icons.activity;
        stroked: true;
        size: 36px;
        // In the accent color while Freya does something in the background.
        checked: App.activities.length > 0;
        label: "Activity";
        tooltip: App.activities.length == 0 ? "Activity"
            : App.activities.length == 1 ? App.activities[0].title
            : App.activities[0].title + ", and " + (App.activities.length - 1) + " more";
        clicked => { activity-popup.show(); }
    }
    more := IconButton {
        icon: Icons.more;
        size: 36px;
        label: "More";
        tooltip: "More options";
        clicked => { menu.show(); }
    }

    // What Freya is doing.
    activity-popup := PopupWindow {
        x: activity.x + activity.width - 320px;
        y: activity.y + activity.height;
        width: 320px;
        close-policy: close-on-click-outside;

        MenuSurface {
            VerticalLayout {
                padding: 6px;

                MenuHeading { text: "Activity"; }
                for doing in App.activities: ActivityRow {
                    text: doing.title;
                    detail: doing.detail;
                    busy: true;
                }
                if App.activities.length == 0: ActivityRow {
                    text: "Nothing is running in the background";
                }
            }
        }
    }

    menu := PopupWindow {
        x: more.x + more.width - 240px;
        y: more.y + more.height;
        width: 240px;

        MenuSurface {
            VerticalLayout {
                padding: 6px;

                if root.view == "queue": MenuItem {
                    text: "Play stream URL…";
                    activated => { url-popup.show(); }
                }
                if root.view == "queue": MenuItem {
                    text: "Save as playlist file…";
                    activated => { Playlist.save(); }
                }
                if root.view == "queue": MenuItem {
                    text: "Open playlist file…";
                    activated => { Playlist.load(); }
                }
                if root.view == "queue": MenuItem {
                    text: "Clear Up Next";
                    activated => { Playlist.clear(); }
                }
                if root.view == "queue": MenuItem {
                    text: "Keep as a playlist…";
                    activated => {
                        root.naming = "save-queue";
                        name-popup.show();
                    }
                }
                if root.view == "playlist": MenuItem {
                    text: "Rename…";
                    activated => {
                        root.naming = "rename";
                        name-popup.show();
                    }
                }
                if root.view == "playlist": MenuItem {
                    text: "Delete playlist…";
                    activated => { delete-popup.show(); }
                }
                if root.view == "library": MenuItem {
                    text: "Library Folders…";
                    activated => { root.manage-folders(); }
                }
                if root.view == "library": MenuItem {
                    text: Library.scanning ? "Stop scanning" : "Scan library";
                    activated => {
                        if Library.scanning {
                            Library.stop-scan();
                        } else {
                            Library.rescan();
                        }
                    }
                }
                if root.view == "queue" || root.view == "library" || root.view == "playlist": MenuDivider { }
                MenuItem {
                    text: "Settings";
                    activated => { root.show-view("settings"); }
                }
                MenuItem {
                    text: "About Freya";
                    activated => { root.show-view("about"); }
                }
            }
        }
    }

    name-popup := PopupWindow {
        x: more.x + more.width - 320px;
        y: more.y + more.height;
        width: 320px;
        close-policy: close-on-click-outside;

        PlaylistNameForm {
            title: root.naming == "rename" ? "Rename the playlist" : "Keep Up Next as a playlist";
            action: root.naming == "rename" ? "Rename" : "Keep";
            initial: root.naming == "rename" && Playlists.shown >= 0 ? Playlists.playlists[Playlists.shown].name : "";
            submit(name) => {
                if (root.naming == "rename") {
                    Playlists.rename(name);
                } else {
                    Playlists.save-queue(name);
                }
            }
            saved => {
                name-popup.close();
                root.show-view("playlist");
            }
            cancelled => { name-popup.close(); }
        }
    }

    delete-popup := PopupWindow {
        x: more.x + more.width - 320px;
        y: more.y + more.height;
        width: 320px;
        close-policy: close-on-click-outside;

        DeletePlaylistForm {
            deleted => {
                delete-popup.close();
                root.show-view("queue");
            }
            cancelled => { delete-popup.close(); }
        }
    }

    station-popup := PopupWindow {
        x: more.x + more.width - 400px;
        y: more.y + more.height;
        width: 400px;
        close-policy: close-on-click-outside;

        AddStationForm {
            done => { station-popup.close(); }
        }
    }

    url-popup := PopupWindow {
        x: more.x + more.width - 380px;
        y: more.y + more.height;
        width: 380px;
        close-policy: close-on-click-outside;

        StreamUrlForm {
            done => { url-popup.close(); }
        }
    }
}

export component FreyaSkin inherits Window {
    title: Player.state == PlaybackState.stopped ? "Freya" : Player.title + " – Freya";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.background;
    default-font-size: 14px;
    forward-focus: shortcuts;

    /// The view in the content area: "queue", "library", "radio", "playlist", "visualizer",
    /// "equalizer", "settings" or "about".
    in-out property <string> view <=> App.view;
    /// The view the visualizer and equalizer buttons go back to.
    property <string> music-view: "queue";
    /// Whether the navigation shows; the toolbar's first button toggles it.
    property <bool> sidebar-shown: true;
    /// Whether the visualizer fills the screen, for a TV; the view to go back to after, and
    /// whether the window filled the screen already.
    property <bool> stage;
    property <string> before-stage;
    property <bool> was-full-screen;

    // Leaving full screen from the system, e.g. with the green button, leaves the stage too.
    changed full-screen => {
        if (!root.full-screen && root.stage) {
            root.leave-stage();
        }
    }

    // On macOS, the window buttons go in the toolbar's row, at the top of the navigation.
    init => {
        App.title-bar-height = 56px;
        if (root.view == "") {
            root.view = "queue";
        }
        App.navigated();
    }

    function show(view: string) {
        root.open(view);
        // What had the keyboard may be gone with the view it was in, and with it every
        // shortcut: they go back to the window.
        shortcuts.focus();
    }

    /// Shows `view` and leaves the keyboard where it is: typing a search opens the library.
    function open(view: string) {
        if (view == "queue" || view == "library" || view == "radio" || view == "playlist") {
            root.music-view = view;
        }
        root.view = view;
        App.navigated();
    }

    function enter-stage() {
        root.before-stage = root.view;
        root.was-full-screen = root.full-screen;
        root.view = "visualizer";
        root.stage = true;
        Stage.on = true;
        root.full-screen = true;
        shortcuts.focus();
    }

    function leave-stage() {
        root.stage = false;
        Stage.on = false;
        root.view = root.before-stage;
        if (!root.was-full-screen) {
            root.full-screen = false;
        }
        shortcuts.focus();
    }

    function toggle-stage() {
        if (root.stage) {
            root.leave-stage();
        } else {
            root.enter-stage();
        }
    }

    /// Opens the dialog for the library's folders, starting from those in use.
    function manage-folders() {
        Library.edit-folders();
        folders-popup.show();
    }

    function toggle-view(view: string) {
        if (root.view == view) {
            root.show(root.music-view);
        } else {
            root.show(view);
        }
    }

    // F fills the screen with the visualizer, and Esc leaves it again.
    stage-keys := FocusScope {
        key-pressed(event) => {
            // Cmd+, (Ctrl+, elsewhere) opens Settings, as in most apps.
            if (event.text == "," && (event.modifiers.meta || event.modifiers.control) && !event.modifiers.alt) {
                root.show("settings");
                return accept;
            }
            // Back and forward: Cmd+[ and Cmd+] on macOS, Alt+Left and Alt+Right elsewhere.
            if ((event.text == "[" && (event.modifiers.meta || event.modifiers.control))
                || (event.text == Key.LeftArrow && event.modifiers.alt)) {
                App.go-back();
                return accept;
            }
            if ((event.text == "]" && (event.modifiers.meta || event.modifiers.control))
                || (event.text == Key.RightArrow && event.modifiers.alt)) {
                App.go-forward();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta || event.modifiers.alt) {
                return reject;
            }
            if (event.text == "f" || event.text == "F") {
                root.toggle-stage();
                return accept;
            }
            if (event.text == Key.Escape && root.stage) {
                root.leave-stage();
                return accept;
            }
            reject
        }

        shortcuts := Shortcuts {
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;

                    if root.sidebar-shown && !root.stage: Sidebar {
                        width: 220px;
                        view: root.view;
                        selected(view) => { root.show(view); }
                        show-section(section) => {
                            library.show(section);
                            root.show("library");
                        }
                        show-update => { update-popup.show(); }
                    }
                    if root.sidebar-shown && !root.stage: Rectangle {
                        width: 1px;
                        background: Theme.divider;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;

                        Rectangle {
                            height: root.stage ? 0 : toolbar.height;
                            visible: !root.stage;

                            // Behind the toolbar: what its controls leave free moves the window.
                            TitleBarArea { }
                            toolbar := Toolbar {
                                inset: root.sidebar-shown ? 0 : App.window-buttons-width;
                                nav-buttons: !root.sidebar-shown;
                                view: root.view;
                                title: root.view == "queue" ? "Up Next"
                                    : root.view == "library" ? Library.title
                                    : root.view == "radio" ? "Radio"
                                    : root.view == "playlist" ? (Playlists.shown >= 0 ? Playlists.playlists[Playlists.shown].name : "Playlist")
                                    : root.view == "visualizer" ? "Visualizer"
                                    : root.view == "settings" || root.view == "about" ? ""
                                    : "Equalizer";
                                subtitle: root.view == "queue" ? Playlist.summary
                                    : root.view == "library" ? (Library.subtitle != "" ? Library.subtitle : Library.status)
                                    : root.view == "radio" ? (Radio.stations.length == 1 ? "1 station" : Radio.stations.length + " stations")
                                    : root.view == "playlist" ? Playlists.summary
                                    : "";
                                can-go-back: root.view == "library" && Library.can-go-back;
                                toggle-sidebar => { root.sidebar-shown = !root.sidebar-shown; }
                                back => { library.back(); }
                                search-edited => {
                                    root.open("library");
                                    library.start-over();
                                }
                                // The keyboard goes to the results, so Space plays again
                                // instead of typing into the search.
                                search-accepted => {
                                    library.activate-current();
                                    library.focus();
                                }
                                show-view(view) => { root.show(view); }
                                manage-folders => { root.manage-folders(); }
                                check-updates => {
                                    Updates.check();
                                    update-popup.show();
                                }
                                full-screen => { root.enter-stage(); }
                            }
                        }
                        Rectangle {
                            height: root.stage ? 0 : 1px;
                            background: Theme.divider;
                        }
                        // The views. The ones with lists stay alive while hidden, so they keep
                        // their scroll position and selection.
                        Rectangle {
                            vertical-stretch: 1;

                            TrackList {
                                width: 100%;
                                height: 100%;
                                visible: root.view == "queue";
                                place: "queue";
                            }
                            library := LibraryPanel {
                                width: 100%;
                                height: 100%;
                                visible: root.view == "library";
                                find => { toolbar.focus-search(); }
                                edit-artist(tab) => {
                                    Library.edit-artist();
                                    root.artist-tab = tab;
                                    artist-popup.show();
                                }
                                match-album => {
                                    Library.match-album();
                                    album-match-popup.show();
                                }
                                match-artist => {
                                    Library.match-artist();
                                    artist-match-popup.show();
                                }
                            }
                            if root.view == "playlist": PlaylistView {
                                width: 100%;
                                height: 100%;
                            }
                            if root.view == "radio": RadioView {
                                width: 100%;
                                height: 100%;
                                add-station => { toolbar.add-station(); }
                            }
                            VisualizerView {
                                width: 100%;
                                height: 100%;
                                shown: root.view == "visualizer";
                                stage: root.stage;
                                toggle-stage => { root.toggle-stage(); }
                            }
                            if root.view == "equalizer": EqualizerView {
                                width: 100%;
                                height: 100%;
                            }
                            if root.view == "settings": SettingsView {
                                width: 100%;
                                height: 100%;
                                manage-folders => { root.manage-folders(); }
                                edit-fanart-key => { fanart-popup.show(); }
                            }
                            if root.view == "about": AboutView {
                                width: 100%;
                                height: 100%;
                                show-update => { update-popup.show(); }
                            }
                        }
                    }
                }
                Rectangle {
                    height: root.stage ? 0 : 1px;
                    background: Theme.divider;
                }
                PlayerBar {
                    height: root.stage ? 0 : 88px;
                    visible: !root.stage;
                    view: root.view;
                    toggle-view(view) => { root.toggle-view(view); }
                    full-screen => { root.enter-stage(); }
                }
            }
        }
    }

    // Over the whole window, dimmed, as a dialog: it closes with Cancel, Save or Esc only.
    folders-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    folders-popup.close();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: #00000059;

                FoldersForm {
                    width: min(560px, parent.width - 48px);
                    // As tall as what it holds: it would fill the window otherwise.
                    height: self.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: max(24px, (parent.height - self.preferred-height) / 3);
                    closed => { folders-popup.close(); }
                }
            }
        }
    }

    // As the artist's dialog.
    artist-match-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    artist-match-form.cancel();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: #00000059;

                artist-match-form := ArtistMatchForm {
                    width: min(720px, parent.width - 48px);
                    height: min(620px, parent.height - 48px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    closed => { artist-match-popup.close(); }
                }
            }
        }
    }

    // As the artist's dialog.
    album-match-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    album-match-form.cancel();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: #00000059;

                album-match-form := AlbumMatchForm {
                    width: min(760px, parent.width - 48px);
                    height: min(620px, parent.height - 48px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    closed => { album-match-popup.close(); }
                }
            }
        }
    }

    /// The page the artist dialog opens at.
    property <string> artist-tab: "general";

    // As the folders' dialog, a fixed size: its pages scroll.
    artist-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        FocusScope {
            // So Esc closes it at once.
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    artist-form.cancel();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: #00000059;

                artist-form := ArtistEditForm {
                    tab: root.artist-tab;
                    width: min(780px, parent.width - 48px);
                    height: min(600px, parent.height - 48px);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    closed => { artist-popup.close(); }
                }
            }
        }
    }

    // As the folders' dialog.
    fanart-popup := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    fanart-popup.close();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: #00000059;

                FanartKeyForm {
                    width: min(480px, parent.width - 48px);
                    height: self.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: max(24px, (parent.height - self.preferred-height) / 3);
                    closed => { fanart-popup.close(); }
                }
            }
        }
    }

    update-popup := PopupWindow {
        x: (root.width - self.width) / 2;
        y: 72px;
        width: 420px;
        close-policy: close-on-click-outside;

        UpdateForm {
            closed => { update-popup.close(); }
        }
    }

    if Playlist.drop-hover: Rectangle {
        border-width: 3px;
        border-color: Theme.accent;
        background: Theme.background.with-alpha(0.85);

        Text {
            text: "Drop to add to Up Next";
            font-size: 18px;
            font-weight: 600;
            color: Theme.text;
        }
    }
}
